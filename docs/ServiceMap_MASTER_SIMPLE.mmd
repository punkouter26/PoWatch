flowchart TD
    subgraph Projects["Solution Projects"]
        CLIENT["PoWatch.Client\nBlazor WASM"]
        API["PoWatch.Api\nMinimal API"]
        APP["PoWatch.Application\nBusiness Logic"]
        DOMAIN["PoWatch.Domain\nModels"]
        INFRA["PoWatch.Infrastructure\nData Access"]
        SHARED["PoWatch.Shared\nDTOs"]
    end

    subgraph Contracts["Contracts"]
        I_OBS["IObservationRepository"]
        I_SUBJ["ISubjectRepository"]
        I_BLOB["IBlobSasProvider"]
    end

    subgraph Impl["Implementations"]
        AZ["Azure Repositories"]
        MEM["InMemory Repositories"]
    end

    subgraph External["External"]
        STORAGE["Azure Storage"]
        APP_INS["App Insights"]
    end

    subgraph Tests["Tests"]
        UNIT["Unit Tests"]
        INT["Integration Tests"]
        E2E["E2E Tests"]
    end

    CLIENT --> API --> APP --> DOMAIN
    APP --> Contracts --> Impl --> INFRA --> STORAGE
    API --> APP_INS
    UNIT --> APP & DOMAIN
    INT --> API
    E2E --> CLIENT

