        SHELL["App Shell\nApp.razor + MainLayout"]
        OBSHUB["ObserverHub\n/observer-hub"]
        ARCHIVES["Archives\n/archives"]
        IDNEXUS["IdentityNexus\n/identity"]
        DIAG["Diagnostics\n/diagnostics"]
