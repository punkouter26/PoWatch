erDiagram
    OBSERVATIONS {
        string PartitionKey "UTC date yyyyMMdd"
        string RowKey "subject id plus observation id"
        string Id "guid without separators"
        datetime ObservedAtUtc
        string SubjectId
        string SubjectDisplayName
        string Activity
        string ClinicalDescription
        bool IsSignificant
        string SignificantReason
        bool IsClinicalOutlier
        string ImageReference
    }
    SUBJECTS {
        string PartitionKey "Subjects"
        string RowKey "SubjectId"
        string DisplayName
        bool IsKnownIdentity
        datetime FirstSeenUtc
        datetime LastSeenUtc
        string LastActivity
        bool LastActivityIsOutlier
    }
    BLOBS {
        string Container "significant images"
        string BlobPath "subject/date/name"
        string SubjectId
        string DateKey
        string SasUrl "generated descriptor only"
    }
    DAILY_CHAPTER {
        string DateKey "derived from observations partition"
        int EventCount
        string Narrative
        string Highlights
    }
    SUBJECTS ||--o{ OBSERVATIONS : "SubjectId"
    OBSERVATIONS ||--o| BLOBS : "ImageReference"
    OBSERVATIONS }o--|| DAILY_CHAPTER : "PartitionKey"
