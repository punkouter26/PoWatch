flowchart TB
    subgraph SIGNIN["Principal acquisition"]
        direction TB
        L1["GET /auth/config — which methods this environment offers"]
        L2{"Environment"}
        L3["Production: Microsoft only<br/>MicrosoftEnabled = AzureAd:ClientId configured<br/>GuestEnabled = false (hard-forced by !IsProduction)"]
        L4["Development: Microsoft + Guest<br/>DeveloperEnableMicrosoftLogin · DeveloperBypassAuth"]
        L5["Test: Guest bypass<br/>FakeAuth scheme via X-Fake-User / X-Fake-Roles headers"]
        L6["GET /auth/login/microsoft &rarr; OIDC code + PKCE<br/>authority {Instance}/{TenantId}/v2.0 · scopes openid profile email<br/>IssuerValidator checks AzureAd:AllowedTenants"]
        L7["GET /auth/login/fake?user=&roles= &rarr; SignInAsync(Cookie)<br/>404 unless DeveloperBypassAuth AND !Production"]
        L8["Cookie 'PoWatch.Auth'<br/>HttpOnly · SameSite=Strict · Secure=Always<br/>24h sliding · DataProtection keyring (blob or filesystem)"]
    end

    subgraph PIPELINE["Per-request authorization"]
        direction TB
        P1["UseAuthentication — DefaultScheme = Cookie<br/>DefaultChallengeScheme = OIDC when ClientId set, else Cookie"]
        P2["UseAuthorization"]
        P3{"Endpoint metadata?"}
        P4["AllowAnonymous"]
        P5["RequireAuthorization() &rarr; default policy<br/>schemes = [Cookie] (+ FakeAuth only when DeveloperBypassAuth)"]
        P6["No metadata &rarr; fallback policy<br/>schemes = [Cookie] ONLY — FakeAuth deliberately excluded<br/>so an always-succeeds guest cannot auto-authenticate /auth/me"]
        P7{"RequireAuthenticatedUser<br/>satisfied?"}
        P8["401 via OnRedirectToLogin<br/>403 via OnRedirectToAccessDenied"]
        P9["Endpoint filter / handler-level feature gates"]
    end

    subgraph SURFACE["Resolved surface"]
        direction TB
        A1["ANONYMOUS BY DESIGN<br/>/auth/me · /auth/config · /auth/login/* · POST /auth/logout<br/>MapStaticAssets (incl. /_framework) · MapFallbackToFile index.html"]
        A2["ANONYMOUS — FLAGGED<br/>GET /health · GET /diag · GET /diag/boot<br/>diag returns masked endpoint/key, storage status, CPU, memory<br/>diag/boot returns environment name and boot stage"]
        A3["AUTHENTICATED — explicit<br/>/api/observer/* · /api/archives/* · /api/blobs/*<br/>/api/identity/* · /fhir/* · /api/diagnostics/*"]
        A4["AUTHENTICATED — by fallback policy only<br/>/openapi/v1.json · /scalar/v1"]
        A5["ROLE-GUARDED<br/><b>NONE</b> — roles are parsed, transported in AuthStateDto,<br/>and never checked by any guard"]
    end

    subgraph GAP["Audit findings"]
        direction TB
        F1["Rate limiter 'ApiPerIpPolicy' is registered and UseRateLimiter runs,<br/>but NO endpoint calls RequireRateLimiting and no GlobalLimiter is set<br/>&rarr; the limiter enforces nothing today"]
        F2["The same policy is not partitioned by IP despite its name —<br/>if wired, it would be one 60/min window shared by all callers"]
        F3["POST /api/blobs/integrity accepts an arbitrary blobPath array<br/>and mints read SAS URLs with no ownership check"]
        F4["Client [Authorize] on pages is UI-only;<br/>the server guard is what actually enforces access"]
    end

    L1 --> L2
    L2 --> L3 --> L6
    L2 --> L4 --> L6
    L2 --> L4 --> L7
