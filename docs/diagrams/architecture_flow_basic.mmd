flowchart TB
    subgraph BROWSER["Browser (device)"]
        UI["Blazor WebAssembly UI<br/>ObserverHub / Archives / Identity / Diagnostics"]
        WORKER["Inference Web Worker<br/>transformers.js 3.8.1 · WebGPU &rarr; WASM"]
    end

    subgraph HOST["PoWatch.Api — ASP.NET Core (.NET 10), single origin"]
        MW["Middleware pipeline<br/>errors &rarr; HTTPS &rarr; rate limit &rarr; correlation &rarr; authn/authz"]
        SLICES["Minimal API slices<br/>/auth · /api/observer · /api/archives<br/>/api/identity · /api/blobs · /fhir · /api/diagnostics"]
        APPL["Application services<br/>Observation · Identity · Archives · Report<br/>DriftRadar · HandoffCoach"]
    end

    subgraph AZURE["Azure"]
        TBL[("Table Storage<br/>PoWatchObservations<br/>PoWatchSubjects")]
        BLOB[("Blob Storage<br/>significant-images<br/>dataprotection-keys")]
        ENTRA["Microsoft Entra ID<br/>OIDC"]
        AOAI["Azure OpenAI<br/>(optional, flag-gated)"]
    end

    HF["Hugging Face Hub<br/>model weights"]

    UI -->|"capture &amp; infer"| WORKER
    WORKER -->|"weights on first load"| HF
    UI -->|"HTTPS + HttpOnly cookie"| MW
    MW --> SLICES
    SLICES --> APPL
    APPL --> TBL
    APPL --> BLOB
    UI -.->|"direct PUT with short-lived SAS"| BLOB
    MW -->|"sign-in challenge"| ENTRA
    APPL -.->|"handoff brief, when enabled"| AOAI
    HOST -->|"serves the WASM app"| BROWSER

