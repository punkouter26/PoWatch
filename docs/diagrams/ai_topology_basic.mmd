    subgraph EDGE["Service 1 — Vision inference (client-side, always on)"]
        direction LR
        V1["ObserverHub<br/>every 10s"] --> V2["inference-worker.js<br/>transformers.js 3.8.1"]
        V2 --> V3["SmolVLM / SmolVLM2<br/>5 models in model-registry.json"]
        V3 --> V4["WebGPU fp16<br/>&rarr; WebGPU fp32<br/>&rarr; WASM q8/q4"]
    end

    subgraph SERVER["Service 2 — Handoff brief (server-side, opt-in)"]
        direction LR
        H1["POST /api/archives/{date}/handoff-brief"] --> H2{"AzureOpenAiEnabled<br/>AND Endpoint set?"}
        H2 -->|yes| H3["AzureOpenAiHandoffSummarizer<br/>deployment gpt-5.4-nano<br/>max_tokens 600 · temp 0.3"]
        H2 -->|no| H4["TemplateHandoffSummarizer<br/>deterministic, no model"]
        H3 -.->|"endpoint/key missing · non-2xx<br/>empty body · unparseable JSON · exception"| H4
    end

