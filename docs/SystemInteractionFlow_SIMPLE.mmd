sequenceDiagram
    actor Sensor as "Sensor"
    actor Clinician as "Clinician"
    participant Client as "Blazor WASM"
    participant API as "PoWatch.Api"
    participant Svc as "Services"
    participant Repo as "Repositories"
    participant Storage as "Azure Storage"

    par Sensor posts observation
        Sensor->>API: POST /ingest
        API->>Svc: IngestAsync()
        Svc->>Repo: GetOrCreateSubject()
        Repo->>Storage: Query/Write
        Svc->>Repo: AddAsync()
        Repo->>Storage: UpsertEntity()
        API-->>Sensor: Result
    and Client polls state
        loop Every N seconds
            Client->>API: GET /observer/state
            API-->>Client: RuntimeStateDto
        end
    end

    Clinician->>Client: Navigate to Archives
    Client->>API: GET /archives/{date}
    API->>Repo: GetByDateAsync()
    Repo->>Storage: QueryEntities
    API-->>Client: DailyChapterDto
