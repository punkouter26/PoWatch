flowchart TD
    subgraph Source["Source Control"]
        FEAT["Feature Branch\nlocal development"]
        DEV["dev Branch\nintegration baseline"]
        MAIN["main Branch\nproduction-ready"]
    end

    subgraph Build["Build Stage — dotnet build PoWatch.slnx"]
        RESTORE["NuGet Restore\nDirectory.Packages.props — centralized versions"]
        COMPILE["Compile All Projects\nTreatWarningsAsErrors=true, Nullable=enable"]
    end

    subgraph UnitGate["Unit Test Gate — dotnet test PoWatch.UnitTests"]
        UT_ARCH["ArchivesServiceTests\nChapter generation, highlights, narrative"]
        UT_CLIN["ClinicalTagParserTests\nPayload validation, tag extraction"]
        UT_DIAG["DiagnosticsMaskingTests\nMasking utility coverage"]
        UT_ID["IdentityServiceTests\nRename and merge logic"]
        UT_OBS["ObservationServiceTests\nIngest pipeline, redundancy, gate backpressure"]
    end

    subgraph IntegGate["Integration Test Gate — dotnet test PoWatch.IntegrationTests"]
        IT_AZURITE["AzuriteWebApplicationFactory\nTestcontainers.Azurite — isolated storage per test"]
        IT_FLOW["ApiFlowTests\nEnd-to-end API workflows"]
        IT_ARCH["ArchivesApiTests\nDate parsing, chapter retrieval"]
        IT_INGEST["ObserverIngestFlowTests\nRedundancy, timeline consistency"]
        IT_ID["IdentityRevisionistTests\nRename/merge via HTTP client"]
    end

    subgraph E2EGate["E2E Gate — npm test (Playwright)"]
        E2E_LINT["npm run lint\nESLint TypeScript validation"]
        E2E_ARCH["archives.spec.ts\nArchives page UI"]
        E2E_DIAG["diagnostics.spec.ts\nDiagnostics refresh + health display"]
        E2E_ID["identity-nexus.spec.ts\nRename and merge UI workflows"]
        E2E_OBS["observer-hub.spec.ts\nIngest and monitoring scenarios"]
    end

    subgraph Environments["Environments"]
        ENV_DEV["Dev\nAzurite emulator\nFeatureFlags: ExposeDebugDetailsInUi=true\nDeveloperBypassAuth=true"]
        ENV_STAGE["Staging\nAzure Table + Blob Storage\nAll feature flags default"]
        ENV_PROD["Production\nApp Insights connected\nSerilog file + AI sinks\nFeatureFlags: DeveloperBypassAuth=false"]
    end

    FEAT -->|"PR to dev"| RESTORE
    RESTORE --> COMPILE
    COMPILE -->|"Build success"| UT_ARCH
    COMPILE -->|"Build success"| UT_CLIN
    COMPILE -->|"Build success"| UT_DIAG
    COMPILE -->|"Build success"| UT_ID
    COMPILE -->|"Build success"| UT_OBS

    UT_ARCH & UT_CLIN & UT_DIAG & UT_ID & UT_OBS -->|"All pass"| IT_AZURITE
    IT_AZURITE --> IT_FLOW & IT_ARCH & IT_INGEST & IT_ID

    IT_FLOW & IT_ARCH & IT_INGEST & IT_ID -->|"All pass"| E2E_LINT
    E2E_LINT --> E2E_ARCH & E2E_DIAG & E2E_ID & E2E_OBS

    E2E_ARCH & E2E_DIAG & E2E_ID & E2E_OBS -->|"All pass"| DEV
    DEV -->|"Manual promotion"| ENV_STAGE
    ENV_STAGE -->|"Manual approval gate"| MAIN
    MAIN --> ENV_PROD

    ENV_DEV -.->|"local dev"| FEAT

