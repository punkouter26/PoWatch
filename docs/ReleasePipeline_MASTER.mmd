flowchart TD
    subgraph Source["Source Control"]
        FEAT["Feature Branch"]
        DEV["dev Branch"]
        MAIN["main Branch"]
    end

    subgraph Build["Build Stage — dotnet build PoWatch.slnx"]
        RESTORE["NuGet Restore"]
        COMPILE["Compile All Projects"]
    end

    subgraph UnitGate["Unit Test Gate"]
        UT_ARCH["ArchivesServiceTests"]
        UT_CLIN["ClinicalTagParserTests"]
        UT_DIAG["DiagnosticsMaskingTests"]
        UT_ID["IdentityServiceTests"]
        UT_OBS["ObservationServiceTests"]
    end

    subgraph IntegGate["Integration Test Gate"]
        IT_AZURITE["AzuriteWebApplicationFactory"]
        IT_FLOW["ApiFlowTests"]
        IT_ARCH["ArchivesApiTests"]
        IT_INGEST["ObserverIngestFlowTests"]
        IT_ID["IdentityRevisionistTests"]
    end

    subgraph E2EGate["E2E Gate — Playwright"]
        E2E_LINT["npm run lint"]
        E2E_ARCH["archives.spec.ts"]
        E2E_DIAG["diagnostics.spec.ts"]
        E2E_ID["identity-nexus.spec.ts"]
        E2E_OBS["observer-hub.spec.ts"]
    end

    subgraph Environments["Environments"]
        ENV_DEV["Dev — Azurite emulator"]
        ENV_STAGE["Staging — Azure Storage"]
        ENV_PROD["Production — App Insights"]
    end

    FEAT -->|"PR to dev"| RESTORE
    RESTORE --> COMPILE
    COMPILE -->|"Build success"| UT_ARCH
    COMPILE -->|"Build success"| UT_CLIN
    COMPILE -->|"Build success"| UT_DIAG
    COMPILE -->|"Build success"| UT_ID
    COMPILE -->|"Build success"| UT_OBS

    UT_ARCH & UT_CLIN & UT_DIAG & UT_ID & UT_OBS -->|"All pass"| IT_AZURITE
    IT_AZURITE --> IT_FLOW & IT_ARCH & IT_INGEST & IT_ID

    IT_FLOW & IT_ARCH & IT_INGEST & IT_ID -->|"All pass"| E2E_LINT
    E2E_LINT --> E2E_ARCH & E2E_DIAG & E2E_ID & E2E_OBS

    E2E_ARCH & E2E_DIAG & E2E_ID & E2E_OBS -->|"All pass"| DEV
    DEV -->|"Manual promotion"| ENV_STAGE
    ENV_STAGE -->|"Manual approval gate"| MAIN
    MAIN --> ENV_PROD

    ENV_DEV -.->|"local dev"| FEAT

