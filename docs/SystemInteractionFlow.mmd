sequenceDiagram
    actor Sensor as "Observation Sensor"
    actor Clinician as "Clinician Browser"
    participant WASM as "Blazor WASM Client"
    participant API as "PoWatch.Api"
    participant Gate as "ProcessingGate (Semaphore)"
    participant ObsSvc as "ObservationService"
    participant SubjRepo as "ISubjectRepository"
    participant ObsRepo as "IObservationRepository"
    participant BlobSvc as "IBlobSasProvider"
    participant TableStorage as "Azure Table Storage"

    note over Sensor,TableStorage: Concurrent Real-time Ingest and Client Polling — State Synchronization

    par Sensor posts observation
        Sensor->>+API: POST /api/observer/ingest {activity, clinicalPayload, subjectHint, isSignificant}
        API->>Gate: TryEnter()
        alt Gate available
            Gate-->>API: true
            API->>+ObsSvc: IngestAsync(request, ct)
            ObsSvc->>+SubjRepo: GetOrCreateAsync(hint)
            SubjRepo->>+TableStorage: QueryEntities (PoWatchSubjects)
            TableStorage-->>-SubjRepo: SubjectProfile or null
            alt Subject not found
                SubjRepo->>TableStorage: UpsertEntityAsync (Subject-N)
            end
            SubjRepo-->>-ObsSvc: SubjectProfile
            ObsSvc->>ObsSvc: ClinicalTagParser.TryExtract(payload)
            ObsSvc->>ObsSvc: Check redundancy vs LastActivity
            alt activity != LastActivity OR isOutlier
                ObsSvc->>+ObsRepo: AddAsync(observationEvent)
                ObsRepo->>+TableStorage: UpsertEntityAsync (PoWatchObservations)
                TableStorage-->>-ObsRepo: EntityAdded
                ObsRepo-->>-ObsSvc: void
                alt isSignificant AND SaveSignificantImages
                    ObsSvc->>+BlobSvc: CreateUploadAccessAsync(subjectId, date)
                    BlobSvc-->>-ObsSvc: BlobAccessDescriptorDto {sasUrl, blobPath, expiresAt}
                end
                ObsSvc->>+SubjRepo: UpdateLastActivityAsync(subjectId, activity, isOutlier)
                SubjRepo->>+TableStorage: UpsertEntityAsync (PoWatchSubjects)
                TableStorage-->>-SubjRepo: EntityUpdated
                SubjRepo-->>-ObsSvc: void
            else redundant — skip persistence
                note right of ObsSvc: Event silently dropped
            end
            ObsSvc-->>-API: IngestObservationResultDto {accepted, isOutlier, eventId}
            API->>Gate: Exit()
            API-->>-Sensor: 200 OK IngestObservationResultDto
        else Gate locked
            Gate-->>API: false
            API-->>-Sensor: 200 OK {accepted:false, reason:"backpressure"}
        end

    and Client polls observer state
        loop Every PollingIntervalSeconds
            WASM->>+API: GET /api/observer/state
            API-->>-WASM: ObserverRuntimeStateDto {flags, pollingIntervalSeconds, status}
            WASM->>WASM: ObserverHub.razor re-renders
        end
    end

    Clinician->>WASM: Navigate to Archives
    WASM->>+API: GET /api/archives/{today}
    API->>+ObsRepo: GetByDateAsync(today)
    ObsRepo->>+TableStorage: QueryEntities (PoWatchObservations, PartitionKey=yyyyMMdd)
    TableStorage-->>-ObsRepo: ObservationEvent[]
    ObsRepo-->>-API: ObservationEvent[]
    API->>API: ArchivesService: sort + filter + narrative
    API-->>-WASM: DailyChapterDto {narrative, timeline[], highlights[]}
    WASM->>WASM: Archives.razor renders

    Clinician->>WASM: Rename Subject-1 to "Patient A"
    WASM->>+API: PATCH /api/identity/subjects/subject-1 {newName:"Patient A"}
    API->>+SubjRepo: RenameAsync("subject-1", "Patient A")
    SubjRepo->>TableStorage: UpsertEntity "patient-a" in PoWatchSubjects
    SubjRepo->>TableStorage: DeleteEntity "subject-1"
    SubjRepo-->>-API: SubjectProfile {subjectId:"patient-a"}
    API->>+ObsRepo: MergeSubjectAsync("subject-1", newProfile)
    loop For each observation
        ObsRepo->>TableStorage: UpsertEntityAsync with new SubjectId + rebuilt RowKey
        ObsRepo->>TableStorage: DeleteEntityAsync old row
    end
    ObsRepo-->>-API: eventsRewritten count
    API-->>-WASM: IdentityRevisionResultDto {canonicalId:"patient-a", eventsRewritten:N}
