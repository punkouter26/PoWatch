flowchart TD
    subgraph AppShell["App Shell — Blazor Host"]
        PROG["Program.cs\nHttpClient + PoWatchApiClient registered\nClientFeatureFlagsOptions registered\nRadzen components registered"]
        APPROUTER["App.razor\nBlazor Router — route table"]
        LAYOUT["MainLayout.razor\nShared page wrapper + NavMenu sidebar"]
    end

    subgraph Pages["Routed Pages"]
        OBSHUB["ObserverHub.razor\nRoute: /observer-hub\ncode-behind: ObserverHub.razor.cs\nMonitor runtime state + manual ingest trigger"]
        ARCHIVES["Archives.razor\nRoute: /archives\nDate picker → GetChapterAsync(date)\nRenders: Narrative card, Timeline list, Highlights grid"]
        IDNEXUS["IdentityNexus.razor\nRoute: /identity\nSubject list → RenameSubjectAsync inline\nMerge modal → MergeIdentityAsync"]
        DIAG["Diagnostics.razor\nRoute: /diagnostics\nAuto-refresh every N seconds\nRenders: CPU%, memory, storage status, masked keys"]
        NOTFOUND["NotFound.razor\n404 catch-all page"]
    end

    subgraph ApiClientLayer["API Client Layer"]
        APICLNT["PoWatchApiClient\nScoped — typed HttpClient wrapper\nBase URL from appsettings/HostEnvironment"]
        subgraph ObserverMethods["Observer API Methods"]
            M_STATE["GetObserverStateAsync()\nGET /api/observer/state"]
            M_INGEST["IngestObservationAsync(request)\nPOST /api/observer/ingest"]
        end
        subgraph ArchivesMethods["Archives API Methods"]
            M_CHAPTER["GetChapterAsync(date)\nGET /api/archives/{date}"]
        end
        subgraph BlobMethods["Blob API Methods"]
            M_BLOB_UP["GetBlobUploadAccessAsync(subjectId, date)\nGET /api/blobs/sas"]
            M_BLOB_RD["GetBlobReadUrlAsync(blobPath)\nGET /api/blobs/sas"]
        end
        subgraph IdentityMethods["Identity API Methods"]
            M_SUBJS["GetSubjectsAsync()\nGET /api/identity/subjects"]
            M_RENAME["RenameSubjectAsync(id, request)\nPATCH /api/identity/subjects/{id}"]
            M_MERGE["MergeIdentityAsync(request)\nPOST /api/identity/merge"]
        end
        subgraph DiagMethods["Diagnostics API Methods"]
            M_DIAG["GetDiagnosticsAsync()\nGET /api/diagnostics/status"]
        end
    end

    subgraph Configuration["Client Configuration"]
        FLAGS["ClientFeatureFlagsOptions\nObservationLoopEnabled: bool\nSaveSignificantImages: bool\nDiagnosticsAutoRefreshIntervalSeconds: int"]
        HTTP_CLIENT["HttpClient\nBaseAddress from appsettings.json"]
    end

    subgraph SharedDTOs["Shared DTOs — PoWatch.Shared"]
        OBS_DTOS["Observer DTOs\nIngestObservationRequestDto\nIngestObservationResultDto\nObserverRuntimeStateDto"]
        ARCH_DTOS["Archives DTOs\nDailyChapterDto\nObservationEventDto"]
        ID_DTOS["Identity DTOs\nSubjectProfileDto\nRenameSubjectRequestDto\nMergeIdentityRequestDto"]
        BLOB_DTOS["Blob DTOs\nBlobAccessDescriptorDto"]
        DIAG_DTOS["Diagnostics DTOs\nDiagnosticsSnapshotDto"]
    end

    PROG --> APPROUTER
    APPROUTER --> LAYOUT
    LAYOUT --> OBSHUB
    LAYOUT --> ARCHIVES
    LAYOUT --> IDNEXUS
    LAYOUT --> DIAG
    LAYOUT --> NOTFOUND

    OBSHUB -->|"uses"| M_STATE
    OBSHUB -->|"uses"| M_INGEST
    OBSHUB -->|"reads flag"| FLAGS
    ARCHIVES -->|"uses"| M_CHAPTER
    IDNEXUS -->|"uses"| M_SUBJS
    IDNEXUS -->|"uses"| M_RENAME
    IDNEXUS -->|"uses"| M_MERGE
    DIAG -->|"uses"| M_DIAG
    DIAG -->|"reads flag"| FLAGS

    M_STATE --- APICLNT
    M_INGEST --- APICLNT
    M_CHAPTER --- APICLNT
    M_BLOB_UP --- APICLNT
    M_BLOB_RD --- APICLNT
    M_SUBJS --- APICLNT
    M_RENAME --- APICLNT
    M_MERGE --- APICLNT
    M_DIAG --- APICLNT

    APICLNT --> HTTP_CLIENT
    PROG --> HTTP_CLIENT
    PROG --> FLAGS

    M_STATE -->|"request/response"| OBS_DTOS
    M_INGEST -->|"request/response"| OBS_DTOS
    M_CHAPTER -->|"response"| ARCH_DTOS
    M_BLOB_UP -->|"response"| BLOB_DTOS
    M_BLOB_RD -->|"response"| BLOB_DTOS
    M_SUBJS -->|"response"| ID_DTOS
    M_RENAME -->|"request/response"| ID_DTOS
    M_MERGE -->|"request/response"| ID_DTOS
    M_DIAG -->|"response"| DIAG_DTOS

