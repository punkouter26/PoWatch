flowchart TD
    subgraph External["External Actors"]
        SENSOR["Observation Sensor\nCamera / External REST client"]
        CLINICIAN["Clinician\nBlazor WASM browser"]
    end

    subgraph Middleware["Auth and Logging Middleware"]
        SERILOG["Serilog RequestLogging\nEnriches UserId + SessionId + TraceId"]
        FAKEAUTH["FakeAuth Handler (Dev only)\nDeveloperBypassAuth=true\nReads X-Dev-User-Id header"]
        OTEL["OpenTelemetry ActivitySource\nPoWatch.Storage spans"]
    end

    subgraph ObserverPipeline["Observation Ingestion Pipeline"]
        INGEST_EP["POST /api/observer/ingest"]
        FLAG_CHK["FeatureFlagsOptions.ObservationLoopEnabled"]
        GATE["InMemoryObservationProcessingGate\nSemaphore(1) — single concurrent slot"]
        OBS_SVC["ObservationService.IngestAsync()"]
        SUBJ_RESOLVE["ISubjectRepository.GetOrCreateAsync(hint)\nSubjectIdSlugger generates Subject-N or named slug"]
        CLINICAL["ClinicalTagParser.TryExtract(payload)\nValidates format, rejects >500 chars, nested tags"]
        REDUND_CHK["Redundancy Gate\nSubjectProfile.LastActivity == activity?"]
        BLOB_SAS["IBlobSasProvider.CreateUploadAccessAsync()\nif IsSignificant + SaveSignificantImages flag"]
        OBS_PERSIST["IObservationRepository.AddAsync(event)\nAzureObservationRepository — Table Storage"]
        SUBJ_CACHE["ISubjectRepository.UpdateLastActivityAsync()\nAzureSubjectRepository — O(1) upsert"]
        INGEST_RESP["IngestObservationResultDto\naccepted/dropped, eventId, isOutlier, detail"]
    end

    subgraph ArchivesPipeline["Archives Read Pipeline"]
        ARCH_EP["GET /api/archives/{date}"]
        DATE_PARSE["DateOnly.TryParse(date) — ISO yyyy-MM-dd"]
        ARCH_SVC["ArchivesService.GetChapterAsync(date)"]
        DATE_FETCH["IObservationRepository.GetByDateAsync(date)\nQuery by partition key — yyyyMMdd"]
        TIMELINE["Order by ObservedAtUtc ASC → DailyChapter.Timeline"]
        HL_FILTER["IsSignificant=true → top 30 DESC → DailyChapter.Highlights"]
        NARR["Narrative: count + primary subject + dominant activity + outlier count"]
        ARCH_RESP["DailyChapterDto\nnarrative + timeline[] + highlights[]"]
    end

    subgraph IdentityPipeline["Identity Management Pipeline"]
        ID_GET["GET /api/identity/subjects"]
        ID_RENAME["PATCH /api/identity/subjects/{subjectId}"]
        ID_MERGE["POST /api/identity/merge"]
        ID_SVC["IdentityService.Rename/MergeAsync()"]
        SLUG["SubjectIdSlugger.ResolveCanonicalSubjectId()\nPreserves named IDs, converts Subject-N → slug"]
        SUBJ_RENAME["ISubjectRepository.RenameAsync()\nProfile updated, old profile deleted if ID changed"]
        OBS_REWRITE["IObservationRepository.MergeSubjectAsync(oldId, newProfile)\nRebuilds row keys — SubjectId_InvTicks_EventId"]
        SUBJ_DELETE["Old SubjectProfile deleted from PoWatchSubjects"]
        ID_RESP["IdentityRevisionResultDto\ncanonicalId + eventsRewritten + subjectsRemoved"]
    end

    subgraph DiagnosticsPipeline["Diagnostics Pipeline"]
        DIAG_EP["GET /api/diagnostics/status"]
        DIAG_SVC["LocalDiagnosticsProvider.CaptureSnapshot()"]
        MASK["MaskingUtility.Mask()\nfirst 3 + '****' + last 3 chars"]
        DIAG_RESP["DiagnosticsSnapshotDto\nCPU%, memory, storageStatus, maskedKeys"]
    end

    SENSOR --> SERILOG
    CLINICIAN --> SERILOG
    SERILOG --> FAKEAUTH
    FAKEAUTH --> OTEL

    OTEL --> INGEST_EP
    OTEL --> ARCH_EP
    OTEL --> ID_GET
    OTEL --> ID_RENAME
    OTEL --> ID_MERGE
    OTEL --> DIAG_EP

    INGEST_EP --> FLAG_CHK
    FLAG_CHK -->|"enabled"| GATE
    GATE -->|"available"| OBS_SVC
    OBS_SVC --> SUBJ_RESOLVE
    OBS_SVC --> CLINICAL
    CLINICAL --> REDUND_CHK
    REDUND_CHK -->|"new event"| OBS_PERSIST
    OBS_PERSIST --> BLOB_SAS
    OBS_PERSIST --> SUBJ_CACHE
    SUBJ_CACHE --> INGEST_RESP

    ARCH_EP --> DATE_PARSE
    DATE_PARSE --> ARCH_SVC
    ARCH_SVC --> DATE_FETCH
    DATE_FETCH --> TIMELINE
    TIMELINE --> HL_FILTER
    HL_FILTER --> NARR
    NARR --> ARCH_RESP

    ID_GET --> ID_SVC
    ID_RENAME --> ID_SVC
    ID_MERGE --> ID_SVC
    ID_SVC --> SLUG
    SLUG --> SUBJ_RENAME
    SUBJ_RENAME --> OBS_REWRITE
    OBS_REWRITE --> SUBJ_DELETE
    SUBJ_DELETE --> ID_RESP

    DIAG_EP --> DIAG_SVC
    DIAG_SVC --> MASK
    MASK --> DIAG_RESP

