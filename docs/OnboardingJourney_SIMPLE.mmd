flowchart TD
    subgraph Access["Access"]
        START(["New User"])
        AUTH["Auth Check"]
        ANON["Anonymous"]
        AUTHCTX["Authenticated"]
    end

    subgraph Hub["ObserverHub"]
        LOAD["Hub loads"]
        READY["Polling started"]
    end

    subgraph Events["First Event"]
        POST["Sensor POST"]
        CREATED["Subject created"]
        STORED["Event stored"]
    end

    subgraph Discovery["Discovery"]
        ARCHIVES["View Archives"]
        RENAME["Rename subject"]
        AHA(["Aha moment!"])
    end

    START --> AUTH -->|"Dev"| AUTHCTX
    AUTH -->|"Prod"| ANON
    ANON & AUTHCTX --> LOAD --> READY
    READY --> POST --> CREATED --> STORED --> ARCHIVES --> RENAME --> AHA

    style Access fill:#1a1a2e,stroke:#4a90d9,color:#fff
    style Hub fill:#16213e,stroke:#f0a500,color:#fff
    style Events fill:#0f3460,stroke:#52b788,color:#fff
    style Discovery fill:#1b4332,stroke:#52b788,color:#fff

    style START fill:#2d6a4f,stroke:#52b788,color:#fff
    style AHA fill:#2d6a4f,stroke:#52b788,color:#fff
    style ANON fill:#3d4b5c,stroke:#7f8c8d,color:#fff
    style AUTHCTX fill:#1e3a5f,stroke:#4a90d9,color:#fff
