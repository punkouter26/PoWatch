flowchart TD
    subgraph Roles["Roles"]
        ANON["Anonymous"]
        DEV["Dev Authenticated"]
    end

    subgraph Public["Public Endpoints"]
        OBS["GET /observer/state"]
        ARCH["GET /archives/{date}"]
        DIAG["GET /diagnostics/status"]
        HEALTH["GET /health"]
    end

    subgraph Private["Private Endpoints"]
        INGEST["POST /observer/ingest"]
        ID["GET/PATCH /identity/*"]
    end

    subgraph Modules["Modules"]
        OBS_MOD["Observer"]
        ARCH_MOD["Archives"]
        ID_MOD["Identity"]
        DIAG_MOD["Diagnostics"]
    end

    ANON --> Public
    DEV --> Public
    DEV --> Private
    ANON -.-> Private

    OBS --- OBS_MOD
    INGEST --- OBS_MOD
    ARCH --- ARCH_MOD
    ID --- ID_MOD
    DIAG --- DIAG_MOD

    style Roles fill:#2c3e50,stroke:#7f8c8d,color:#fff
    style Public fill:#1b4332,stroke:#52b788,color:#fff
    style Private fill:#1a1a2e,stroke:#4a90d9,color:#fff
    style Modules fill:#16213e,stroke:#f0a500,color:#fff

    style ANON fill:#3d4b5c,stroke:#7f8c8d,color:#fff
