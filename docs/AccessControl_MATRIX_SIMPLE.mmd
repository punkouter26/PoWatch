flowchart LR
    subgraph Matrix["Access Control (Simple)"]
        ANON["Anonymous"]
        DEV["Dev-Authenticated"]
        PUBLIC["Public Endpoints\n/observer/state\n/archives/{date}\n/diagnostics/status\n/health"]
        AUTH_EP["Auth Endpoints\n/observer/ingest\n/blobs/sas\n/identity/*"]
    end

    ANON --> PUBLIC
    DEV --> PUBLIC
    DEV --> AUTH_EP
    ANON -.->|"401 if enforced"| AUTH_EP

    style Matrix fill:#1a1a2e,stroke:#4a90d9,color:#fff
    style ANON fill:#3d4b5c,stroke:#7f8c8d,color:#fff
    style DEV fill:#1e3a5f,stroke:#4a90d9,color:#fff
    style PUBLIC fill:#1a3a2a,stroke:#52b788,color:#fff
    style AUTH_EP fill:#1e3a5f,stroke:#4a90d9,color:#fff
