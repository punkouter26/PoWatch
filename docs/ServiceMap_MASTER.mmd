flowchart TD
    subgraph SolutionProjects["Solution Projects — PoWatch.slnx"]
        CLIENT["PoWatch.Client\nBlazor WASM SPA\n.NET 10 / Radzen.Blazor"]
        API["PoWatch.Api\n.NET 10 Minimal API\nSerilog + OpenTelemetry + Scalar"]
        APP["PoWatch.Application\nBusiness Logic\nService interfaces + implementations"]
        DOMAIN["PoWatch.Domain\nCore domain — zero external dependencies\nModels + Services"]
        INFRA["PoWatch.Infrastructure\nData Access\nAzure Table/Blob + InMemory fallbacks"]
        SHARED["PoWatch.Shared\nDTO contracts — Client-API surface"]
    end

    subgraph Contracts["Application Contracts — Dependency Inversion"]
        I_OBS_REPO["IObservationRepository\nAddAsync, GetByDateAsync, MergeSubjectAsync"]
        I_SUBJ_REPO["ISubjectRepository\nGetAllAsync, GetOrCreateAsync, RenameAsync, MergeAsync"]
        I_BLOB["IBlobSasProvider\nCreateUploadAccessAsync, CreateReadAccessUrlAsync"]
        I_GATE["IObservationProcessingGate\nTryEnter, Exit"]
        I_DIAG["IDiagnosticsProvider\nCaptureSnapshot"]
    end

    subgraph Implementations["Infrastructure Implementations"]
        AZ_OBS["AzureObservationRepository\nAzure Table Storage"]
        MEM_OBS["InMemoryObservationRepository\nConcurrentDictionary fallback"]
        AZ_SUBJ["AzureSubjectRepository\nAzure Table Storage"]
        MEM_SUBJ["InMemorySubjectRepository\nConcurrentDictionary"]
        AZ_BLOB["AzureBlobSasProvider\nAzure.Storage.Blobs SDK"]
        MEM_GATE["InMemoryObservationProcessingGate\nSemaphoreSlim(1,1)"]
        LOCAL_DIAG["LocalDiagnosticsProvider\nCPU/memory snapshot"]
        AZ_CLIENTS["AzureStorageClients (Singleton)\nTableServiceClient + BlobServiceClient"]
    end

    subgraph ExternalServices["External Services"]
        AZ_TABLE["Azure Table Storage\nPoWatchObservations + PoWatchSubjects"]
        AZ_BLOB_STORE["Azure Blob Storage\nsignificant-images container"]
        APP_INSIGHTS["Application Insights\nOpenTelemetry OTLP exporter"]
        AZURITE["Azurite Emulator (Dev)\nDocker — ports 10000/10001/10002"]
        TESTCONTAINERS["Testcontainers.Azurite\nIntegration tests"]
    end

    subgraph TestProjects["Test Projects"]
        UNIT_TESTS["PoWatch.UnitTests\nxUnit — domain + service logic"]
        INT_TESTS["PoWatch.IntegrationTests\nAzuriteWebApplicationFactory"]
        E2E_TESTS["PoWatch.E2E\nPlaywright TypeScript"]
    end

    CLIENT -->|"HttpClient → REST"| API
    CLIENT --> SHARED
    API --> APP
    API --> INFRA
    API --> SHARED

    APP --> DOMAIN
    APP --> SHARED
    APP --> I_OBS_REPO
    APP --> I_SUBJ_REPO
    APP --> I_BLOB
    APP --> I_GATE
    APP --> I_DIAG

    INFRA --> I_OBS_REPO
    INFRA --> I_SUBJ_REPO
    INFRA --> I_BLOB
    INFRA --> I_GATE
    INFRA --> I_DIAG
    INFRA --> DOMAIN

    I_OBS_REPO -->|"Azure impl"| AZ_OBS
    I_OBS_REPO -->|"InMemory impl"| MEM_OBS
    I_SUBJ_REPO -->|"Azure impl"| AZ_SUBJ
    I_SUBJ_REPO -->|"InMemory impl"| MEM_SUBJ
    I_BLOB --> AZ_BLOB
    I_GATE --> MEM_GATE
    I_DIAG --> LOCAL_DIAG

    AZ_OBS --> AZ_CLIENTS
    AZ_SUBJ --> AZ_CLIENTS
    AZ_BLOB --> AZ_CLIENTS

    AZ_CLIENTS -->|"Azure SDK"| AZ_TABLE
    AZ_CLIENTS -->|"Azure SDK"| AZ_BLOB_STORE
    AZURITE -.->|"dev substitute"| AZ_TABLE
    AZURITE -.->|"dev substitute"| AZ_BLOB_STORE
    API -->|"OpenTelemetry OTLP"| APP_INSIGHTS

    UNIT_TESTS -->|"tests"| APP
    UNIT_TESTS -->|"tests"| DOMAIN
    INT_TESTS -->|"tests"| API
    INT_TESTS --> TESTCONTAINERS
    TESTCONTAINERS -.->|"test substitute"| AZURITE
    E2E_TESTS -->|"tests"| CLIENT

