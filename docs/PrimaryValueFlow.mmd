flowchart LR
    subgraph Sensor["Observation Source"]
        CAM["Camera / Sensor\nDetects patient activity\nand clinical context"]
    end

    subgraph Ingest["POST /api/observer/ingest — Ingest Pipeline"]
        REQ["IngestObservationRequestDto\nactivity, clinicalPayload, subjectHint\nisSignificant, outlierReason"]
        GATE_CHECK["ProcessingGate.TryEnter()\nSemaphore backpressure — 1 concurrent inference"]
        SUBJ["ISubjectRepository.GetOrCreateAsync(hint)\nResolves or auto-creates Subject-N"]
        CLIN["ClinicalTagParser.TryExtract(payload)\nValidates <S>text<E> format, max 500 chars"]
        REDUND["Redundancy Check\nCompare activity vs SubjectProfile.LastActivity"]
        TS["Server Timestamp Applied\nClient ObservedAtUtc overwritten by server clock"]
        PERSIST["IObservationRepository.AddAsync(event)\nPartition: yyyyMMdd, Row: SubjectId_InvTicks_EventId"]
        BLOB["IBlobSasProvider.CreateUploadAccessAsync()\nif IsSignificant=true AND SaveSignificantImages=true"]
        CACHE["ISubjectRepository.UpdateLastActivityAsync()\nO(1) cache write on SubjectProfile"]
        RESP["IngestObservationResultDto\naccepted=true, eventId, outlierStatus"]
    end

    subgraph Storage["Azure Table Storage"]
        OBS_TABLE["PoWatchObservations\nRow stored under yyyyMMdd partition"]
        SUBJ_TABLE["PoWatchSubjects\nLastActivity + LastSeenUtc updated"]
        BLOB_STORE["Azure Blob Storage\nsignificant-images/{date}/{subjectId}/{guid}.svg"]
    end

    subgraph Polling["Client Polling Loop"]
        POLL["ObserverHub polling\nGET /api/observer/state every PollingIntervalSeconds"]
        STATE_UPDATE["ObserverRuntimeStateDto\nUI reflects current system state"]
    end

    subgraph Archives["Archives Retrieval"]
        ARCH_REQ["GET /api/archives/{today}\nDateOnly.TryParse(date)"]
        DATE_QUERY["IObservationRepository.GetByDateAsync(today)\nQuery by partition key"]
        SORT["Timeline ordered by ObservedAtUtc ASC"]
        HIGHLIGHTS["IsSignificant=true filtered\nTop 30 reverse-chrono highlights"]
        NARRATIVE["Narrative: 'Room recorded N events.\nPrimary: {name}. Dominant: {activity}. Outliers: N.'"]
        CHAPTER["DailyChapterDto rendered\nTimeline + Highlights + Narrative"]
    end

    CAM -->|"HTTP POST"| REQ
    REQ --> GATE_CHECK
    GATE_CHECK -->|"Available"| SUBJ
    SUBJ --> CLIN
    CLIN --> REDUND
    REDUND -->|"New/Different"| TS
    TS --> PERSIST
    PERSIST --> OBS_TABLE
    PERSIST --> BLOB
    BLOB --> BLOB_STORE
    PERSIST --> CACHE
    CACHE --> SUBJ_TABLE
    CACHE --> RESP
    RESP -->|"Accepted"| POLL

    OBS_TABLE --> DATE_QUERY

    POLL --> STATE_UPDATE
    STATE_UPDATE -->|"User navigates to Archives"| ARCH_REQ
    ARCH_REQ --> DATE_QUERY
    DATE_QUERY --> SORT
    SORT --> HIGHLIGHTS
    HIGHLIGHTS --> NARRATIVE
    NARRATIVE --> CHAPTER

