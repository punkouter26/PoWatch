stateDiagram-v2
    [*] --> Received : POST /api/observer/ingest

    state "Observation Lifecycle" as ObsLC {
        Received --> GateCheck
        GateCheck --> Dropped : Backpressure or disabled
        GateCheck --> Processing : Gate available
        Processing --> Persisting : Valid payload
        Processing --> Outlier : Malformed payload
        Outlier --> Persisting : Continue with outlier flag
        Persisting --> Accepted : Event stored
        Accepted --> [*] : Response sent
        Dropped --> [*] : accepted=false
    }

    state "Subject Lifecycle" as SubjLC {
        [*] --> Generated : Auto-create
        Generated --> Named : PATCH rename
        Named --> Renamed : Re-rename
        Generated --> Merged : POST merge
        Named --> Merged : merge as secondary
        Merged --> [*] : Profile deleted
    }

    state "Gate Lifecycle" as GateLC {
        [*] --> Gate_Open
        Gate_Open --> Gate_Locked : TryEnter()
        Gate_Locked --> Gate_Open : Exit()
        Gate_Locked --> Gate_Locked : Rejected
    }
