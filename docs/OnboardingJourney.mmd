flowchart TD
    subgraph Access["Access and Authentication"]
        START(["New User Accesses PoWatch URL"])
        AUTHFLAG{"DeveloperBypassAuth Feature Flag?"}
        FAKEAUTH["FakeAuth Handler registered — Dev mode"]
        HEADER{"X-Dev-User-Id header present?"}
        ANON["Anonymous session — UserId=anonymous"]
        AUTHCTX["Authenticated session — UserId enriched in logs"]
        PRODAUTH["Production Auth — not yet implemented"]
    end

    subgraph FirstView["First View — ObserverHub"]
        HUB_LOAD["ObserverHub.razor loads — GET /api/observer/state"]
        STATE_RESP["ObserverRuntimeStateDto received"]
        LOOP_CHECK{"ObservationLoopEnabled = true?"}
        FLAG_WARN["Warning banner — Loop disabled"]
        HUB_READY["Hub active — polling started"]
    end

    subgraph FirstEvent["First Observation — System Comes Alive"]
        SENSOR_POST["Camera/Sensor sends POST /api/observer/ingest"]
        SUBJ_CREATED["Subject-1 auto-created by SubjectIdSlugger"]
        OBS_STORED["ObservationEvent persisted to PoWatchObservations"]
        CACHE_UPDATED["SubjectProfile.LastActivity cached"]
        POLL_DETECTS["Client polling detects new state"]
    end

    subgraph Discovery["Discovery — Aha! Moment"]
        ARCHIVES["User navigates to Archives"]
        CHAPTER["DailyChapterDto rendered — Narrative + Timeline + Highlights"]
        IDENTITY["User navigates to IdentityNexus"]
        RENAME["User renames Subject-1 to 'Patient A'"]
        REWRITE["All observations rewritten via MergeSubjectAsync()"]
        AHA(["Aha! Named subject with clinical context"])
    end

    START --> AUTHFLAG
    AUTHFLAG -->|"true — Dev"| FAKEAUTH
    AUTHFLAG -->|"false — Production"| PRODAUTH
    FAKEAUTH --> HEADER
    HEADER -->|"Missing"| ANON
    HEADER -->|"Present"| AUTHCTX
    PRODAUTH --> ANON
    ANON --> HUB_LOAD
    AUTHCTX --> HUB_LOAD

    HUB_LOAD --> STATE_RESP
    STATE_RESP --> LOOP_CHECK
    LOOP_CHECK -->|"false"| FLAG_WARN
    LOOP_CHECK -->|"true"| HUB_READY

    HUB_READY --> SENSOR_POST
    SENSOR_POST --> SUBJ_CREATED
    SUBJ_CREATED --> OBS_STORED
    OBS_STORED --> CACHE_UPDATED
    CACHE_UPDATED --> POLL_DETECTS
    POLL_DETECTS --> ARCHIVES

    ARCHIVES --> CHAPTER
    CHAPTER --> IDENTITY
    IDENTITY --> RENAME
    RENAME --> REWRITE
    REWRITE --> AHA

    style Access fill:#1a1a2e,stroke:#4a90d9,color:#fff
    style FirstView fill:#16213e,stroke:#f0a500,color:#fff
    style FirstEvent fill:#0f3460,stroke:#52b788,color:#fff
    style Discovery fill:#1b4332,stroke:#52b788,color:#fff

    style START fill:#2d6a4f,stroke:#52b788,color:#fff
    style AHA fill:#2d6a4f,stroke:#52b788,color:#fff
    style FLAG_WARN fill:#6b2737,stroke:#e63946,color:#fff
    style ANON fill:#3d4b5c,stroke:#7f8c8d,color:#fff
    style AUTHCTX fill:#1e3a5f,stroke:#4a90d9,color:#fff
    style PRODAUTH fill:#4a3000,stroke:#f0a500,color:#fff
    style FAKEAUTH fill:#1e3a5f,stroke:#4a90d9,color:#fff
    style HEADER fill:#0f3460,stroke:#4a90d9,color:#fff
    style LOOP_CHECK fill:#0f3460,stroke:#4a90d9,color:#fff
    style AUTHFLAG fill:#0f3460,stroke:#4a90d9,color:#fff
    style SENSOR_POST fill:#1e3a5f,stroke:#52b788,color:#fff
    style SUBJ_CREATED fill:#1a3a2a,stroke:#52b788,color:#fff
    style OBS_STORED fill:#1a3a2a,stroke:#52b788,color:#fff
    style CACHE_UPDATED fill:#1a3a2a,stroke:#52b788,color:#fff
    style POLL_DETECTS fill:#1a3a2a,stroke:#52b788,color:#fff
    style RENAME fill:#1a3a2a,stroke:#52b788,color:#fff
    style REWRITE fill:#1a3a2a,stroke:#52b788,color:#fff
