    style ARCH fill:#1a3a2a,stroke:#52b788,color:#fff
    style DIAG fill:#1a3a2a,stroke:#52b788,color:#fff
    style HEALTH fill:#1a3a2a,stroke:#52b788,color:#fff
    style SCALAR fill:#1a3a2a,stroke:#52b788,color:#fff
    style OPENAPI fill:#1a3a2a,stroke:#52b788,color:#fff
    style INGEST fill:#1e3a5f,stroke:#4a90d9,color:#fff
    style BLOB_SAS fill:#1e3a5f,stroke:#4a90d9,color:#fff
