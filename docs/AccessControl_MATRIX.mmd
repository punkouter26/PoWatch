flowchart TD
    subgraph Roles["User Roles — Current State"]
        ANON["Anonymous\nNo identity headers or production mode"]
        DEV_AUTH["Dev-Authenticated\nX-Dev-User-Id + X-Dev-User-Name headers\nDeveloperBypassAuth=true only"]
        NOTE_PROD["SECURITY NOTE: Production currently has\nno enforced authentication scheme.\nAll endpoints accessible without credentials."]
    end

    subgraph PublicGroup["Public Endpoints — No Auth Required"]
        OBS_STATE["GET /api/observer/state\nObserverRuntimeStateDto"]
        ARCH["GET /api/archives/{date}\nDailyChapterDto"]
        DIAG["GET /api/diagnostics/status\nDiagnosticsSnapshotDto"]
        HEALTH["GET /health\nJSON health check"]
        SCALAR["GET /scalar/v1\nScalar interactive API documentation"]
        OPENAPI["GET /openapi/v1.json\nOpenAPI 3.x specification"]
    end

    subgraph AuthGroup["Auth-Required Endpoints"]
        INGEST["POST /api/observer/ingest\nIngestObservationRequestDto"]
        BLOB_SAS["GET /api/blobs/sas\nBlobAccessDescriptorDto (30-min SAS)"]
        SUBJ_GET["GET /api/identity/subjects\nSubjectProfileDto[]"]
        SUBJ_RENAME["PATCH /api/identity/subjects/{subjectId}\nRenameSubjectRequestDto"]
        SUBJ_MERGE["POST /api/identity/merge\nMergeIdentityRequestDto"]
    end

    subgraph Modules["Controller Modules"]
        OBS_MOD["ObserverEndpoints /api/observer/*"]
        ARCH_MOD["ArchivesEndpoints /api/archives/*"]
        BLOB_MOD["BlobEndpoints /api/blobs/*"]
        ID_MOD["IdentityEndpoints /api/identity/*"]
        DIAG_MOD["DiagnosticsEndpoints /api/diagnostics/*"]
    end

    ANON -->|"Full access"| PublicGroup
    DEV_AUTH -->|"Full access"| PublicGroup
    DEV_AUTH -->|"Authenticated access (dev)"| AuthGroup
    ANON -.->|"Would return 401 if auth enforced"| AuthGroup

    OBS_STATE --- OBS_MOD
    INGEST --- OBS_MOD
    ARCH --- ARCH_MOD
    BLOB_SAS --- BLOB_MOD
    SUBJ_GET --- ID_MOD
    SUBJ_RENAME --- ID_MOD
    SUBJ_MERGE --- ID_MOD
    DIAG --- DIAG_MOD

    style Roles fill:#2c3e50,stroke:#7f8c8d,color:#fff
    style PublicGroup fill:#1b4332,stroke:#52b788,color:#fff
    style AuthGroup fill:#1a1a2e,stroke:#4a90d9,color:#fff
    style Modules fill:#16213e,stroke:#f0a500,color:#fff

    style ANON fill:#3d4b5c,stroke:#7f8c8d,color:#fff
    style DEV_AUTH fill:#1e3a5f,stroke:#4a90d9,color:#fff
    style NOTE_PROD fill:#6b2737,stroke:#e63946,color:#fff
