flowchart TD
    subgraph Roles["User Roles — Current State"]
        ANON["Anonymous\nNo identity headers\nor production mode"]
        DEV_AUTH["Dev-Authenticated\nX-Dev-User-Id + X-Dev-User-Name headers\nDeveloperBypassAuth=true only"]
        NOTE_PROD["SECURITY NOTE: Production currently has\nno enforced authentication scheme.\nAll endpoints accessible without credentials.\nFakeAuth is dev-only via feature flag."]
    end

    subgraph PublicGroup["Public Endpoints — No Auth Required"]
        OBS_STATE["GET /api/observer/state\nObserverRuntimeStateDto\nFeature flags + poll interval + status"]
        ARCH["GET /api/archives/{date}\nDailyChapterDto\nTimeline, highlights, narrative"]
        DIAG["GET /api/diagnostics/status\nDiagnosticsSnapshotDto\nMasked credentials — safe for display"]
        HEALTH["GET /health\nJSON health check\nAzure Storage ping or in-memory"]
        SCALAR["GET /scalar/v1\nScalar interactive API documentation"]
        OPENAPI["GET /openapi/v1.json\nOpenAPI 3.x specification"]
    end

    subgraph AuthGroup["Auth-Required Endpoints (Dev: FakeAuth / Prod: to be implemented)"]
        INGEST["POST /api/observer/ingest\nAccepts IngestObservationRequestDto\nCore ingestion pipeline"]
        BLOB_SAS["GET /api/blobs/sas\nQuery: subjectId+date OR blobPath\nReturns BlobAccessDescriptorDto (30-min SAS)"]
        SUBJ_GET["GET /api/identity/subjects\nReturns SubjectProfileDto[] sorted by DisplayName"]
        SUBJ_RENAME["PATCH /api/identity/subjects/{subjectId}\nRenameSubjectRequestDto\nRewrites all observations for subject"]
        SUBJ_MERGE["POST /api/identity/merge\nMergeIdentityRequestDto (primary, secondary, optional name)\nDeletes merged profiles, rewrites all observations"]
    end

    subgraph Modules["Controller Modules"]
        OBS_MOD["ObserverEndpoints\n/api/observer/*"]
        ARCH_MOD["ArchivesEndpoints\n/api/archives/*"]
        BLOB_MOD["BlobEndpoints\n/api/blobs/*"]
        ID_MOD["IdentityEndpoints\n/api/identity/*"]
        DIAG_MOD["DiagnosticsEndpoints\n/api/diagnostics/*"]
    end

    ANON -->|"Full access"| PublicGroup
    DEV_AUTH -->|"Full access"| PublicGroup
    DEV_AUTH -->|"Authenticated access (dev)"| AuthGroup
    ANON -.->|"Would return 401 if auth enforced"| AuthGroup

    OBS_STATE --- OBS_MOD
    INGEST --- OBS_MOD
    ARCH --- ARCH_MOD
    BLOB_SAS --- BLOB_MOD
    SUBJ_GET --- ID_MOD
    SUBJ_RENAME --- ID_MOD
    SUBJ_MERGE --- ID_MOD
    DIAG --- DIAG_MOD

    style Roles fill:#2c3e50,stroke:#7f8c8d,color:#fff
    style PublicGroup fill:#1b4332,stroke:#52b788,color:#fff
    style AuthGroup fill:#1a1a2e,stroke:#4a90d9,color:#fff
    style Modules fill:#16213e,stroke:#f0a500,color:#fff

