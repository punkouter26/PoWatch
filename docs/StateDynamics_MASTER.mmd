stateDiagram-v2
    [*] --> Received : POST /api/observer/ingest

    state "Observation Ingest Lifecycle" as IngestLC {
        Received --> GateCheck
        GateCheck --> Dropped_Backpressure : TryEnter() = false (semaphore locked)
        GateCheck --> FlagCheck : TryEnter() = true

        FlagCheck --> Dropped_LoopDisabled : ObservationLoopEnabled = false
        FlagCheck --> SubjectResolution : ObservationLoopEnabled = true

        SubjectResolution --> ClinicalParsing : Subject resolved or Subject-N created
        ClinicalParsing --> RedundancyCheck : Valid payload
        ClinicalParsing --> Outlier_Flagged : Malformed payload (nested tags, >500 chars, wrong format)
        Outlier_Flagged --> RedundancyCheck : IsOutlier=true set, proceed to persist

        RedundancyCheck --> Dropped_Redundant : activity == LastActivity AND no outlier
        RedundancyCheck --> Persisting : activity differs OR is outlier

        Persisting --> BlobRefGenerated : IsSignificant=true AND SaveSignificantImages=true
        Persisting --> CacheUpdated : SaveSignificantImages=false or not significant
        BlobRefGenerated --> CacheUpdated : SAS URL generated for upload

        CacheUpdated --> Accepted
    }

    Dropped_Backpressure --> [*] : accepted=false, reason=backpressure
    Dropped_LoopDisabled --> [*] : accepted=false, reason=loop disabled
    Dropped_Redundant --> [*] : accepted=false, reason=redundant
    Accepted --> [*] : accepted=true, eventId assigned

    state "Subject Identity Lifecycle" as SubjectLC {
        [*] --> Generated : Auto-created as Subject-N (no hint provided)
        Generated --> Named : PATCH /api/identity/subjects/{id} (rename)
        Named --> Renamed : PATCH with new display name (canonical ID changes)
        Renamed --> Named : subsequent renames
        Generated --> Merged_Secondary : POST /api/identity/merge as secondary
        Named --> Merged_Secondary : POST /api/identity/merge as secondary
        Renamed --> Merged_Secondary : POST /api/identity/merge as secondary
        Merged_Secondary --> [*] : Profile deleted, all observations rewritten to primary
    }

    state "Processing Gate Lifecycle" as GateLC {
        [*] --> Gate_Open
        Gate_Open --> Gate_Locked : TryEnter() called — inference slot taken
        Gate_Locked --> Gate_Open : Exit() called — inference complete
        Gate_Locked --> Gate_Locked : TryEnter() rejected — event dropped
    }
