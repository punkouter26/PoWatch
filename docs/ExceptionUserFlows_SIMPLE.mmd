flowchart TD
    subgraph Exceptions["Exception User Flows (Simple)"]
        INGEST["POST /api/observer/ingest"]
        FLAG_FAIL["Dropped — Loop disabled"]
        GATE_FAIL["Dropped — Backpressure"]
        OUTLIER["Flagged — Clinical outlier"]
        REDUND_FAIL["Dropped — Redundant"]
        OK["Accepted"]

        AUTH["Authentication"]
        AUTH_FAIL["Anonymous session"]
        AUTH_OK["Authenticated session"]

        IDENTITY["Identity operations"]
        ID_FAIL["400/404 error"]
        ID_OK["IdentityRevisionResultDto"]
    end

    INGEST -->|"loop off"| FLAG_FAIL
    INGEST -->|"gate busy"| GATE_FAIL
    INGEST -->|"bad payload"| OUTLIER
    INGEST -->|"duplicate"| REDUND_FAIL
    INGEST -->|"success"| OK

    AUTH -->|"no header"| AUTH_FAIL
    AUTH -->|"header present"| AUTH_OK

    IDENTITY -->|"invalid input"| ID_FAIL
    IDENTITY -->|"valid"| ID_OK

    style Exceptions fill:#1a1a2e,stroke:#4a90d9,color:#fff
    style FLAG_FAIL fill:#6b2737,stroke:#e63946,color:#fff
    style GATE_FAIL fill:#6b2737,stroke:#e63946,color:#fff
    style REDUND_FAIL fill:#6b2737,stroke:#e63946,color:#fff
    style ID_FAIL fill:#6b2737,stroke:#e63946,color:#fff
    style OUTLIER fill:#7d4e00,stroke:#f0a500,color:#fff
    style AUTH_FAIL fill:#3d4b5c,stroke:#7f8c8d,color:#fff
    style OK fill:#1a3a2a,stroke:#52b788,color:#fff
    style AUTH_OK fill:#1a3a2a,stroke:#52b788,color:#fff
    style ID_OK fill:#1a3a2a,stroke:#52b788,color:#fff
    style INGEST fill:#1e3a5f,stroke:#4a90d9,color:#fff
    style AUTH fill:#3d2163,stroke:#9b72cf,color:#fff
    style IDENTITY fill:#1b4332,stroke:#52b788,color:#fff
