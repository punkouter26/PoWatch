@page "/diagnostics"
@page "/diag"
@using PoWatch.Shared.Models
@inject PoWatch.Client.Services.PoWatchApiClient ApiClient
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>PoWatch | Diagnostics</PageTitle>

<div class="sector-grid">
    <RadzenCard class="panel">
        <header class="panel-header">
            <h1>System Diagnostics</h1>
            <p>Zero-waste transparency into runtime resource usage and connection health.</p>
        </header>

        <RadzenButton Text="Refresh Diagnostics" ButtonStyle="ButtonStyle.Primary" Click="LoadAsync" />

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="status-line">@statusMessage</div>
        }

        @if (snapshot is not null)
        {
            <div class="hud-grid diagnostics-grid">
                <div><label>Captured</label><span>@snapshot.CapturedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span></div>
                <div><label>CPU Load</label><span>@snapshot.CpuLoadPercent.ToString("0")%</span></div>
                <div><label>Memory</label><span>@snapshot.MemoryMb.ToString("0.0") MB</span></div>
                <div><label>Storage</label><span>@snapshot.StorageConnectionStatus</span></div>
                <div><label>Masked Endpoint</label><span>@snapshot.MaskedEndpoint</span></div>
                <div><label>Masked Key</label><span>@snapshot.MaskedApiKey</span></div>
            </div>
        }
    </RadzenCard>

    <RadzenCard class="panel">
        <header class="panel-header">
            <h1>Inference Engine</h1>
            <p>WebGPU / WASM model status and runtime telemetry.</p>
        </header>

        <RadzenButton Text="Refresh Inference Diagnostics" ButtonStyle="ButtonStyle.Secondary" Click="RefreshInferenceDiagnosticsAsync" />

        @if (inferenceDiag is not null)
        {
            var isReady = inferenceDiag.LoadState == "ready";
            var isLoading = inferenceDiag.LoadState == "loading";
            var isError = inferenceDiag.LoadState == "error";
            var isIdle = !isReady && !isLoading && !isError;

            <div style="margin-top: 1rem; padding: 1rem; border-radius: 6px; background: @(isReady ? "rgba(0,200,100,0.08)" : isLoading ? "rgba(255,180,0,0.08)" : isError ? "rgba(220,50,50,0.08)" : "rgba(120,120,120,0.08)"); border: 1px solid @(isReady ? "var(--rz-success)" : isLoading ? "var(--rz-warning)" : isError ? "var(--rz-danger)" : "var(--rz-border-disabled-color)");">
                <div style="display: flex; align-items: center; gap: 0.6rem;">
                    <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: @(isReady ? "var(--rz-success)" : isLoading ? "var(--rz-warning)" : isError ? "var(--rz-danger)" : "var(--rz-text-disabled-color)");"></span>
                    <span style="font-size: 1rem; font-weight: 700; color: @(isReady ? "var(--rz-success)" : isLoading ? "var(--rz-warning)" : isError ? "var(--rz-danger)" : "var(--rz-text-secondary-color)");">
                        @(isReady ? "MODEL LOADED" : isLoading ? "LOADING…" : isError ? "LOAD FAILED" : "NOT STARTED")
                    </span>
                </div>
                @if (isReady)
                {
                    <div style="margin-top: 0.4rem; font-size: 0.85rem; color: var(--rz-text-secondary-color);">
                        Running on <strong>@inferenceDiag.Device!.ToUpperInvariant()</strong> · dtype <strong>@inferenceDiag.Dtype</strong>
                        @if (inferenceDiag.Fp16FallbackUsed) { <span> · fp16 → fp32 fallback active</span> }
                        @if (inferenceDiag.LoadDurationMs.HasValue) { <span> · loaded in @($"{inferenceDiag.LoadDurationMs:N0} ms")</span> }
                    </div>
                }
                @if (isError && !string.IsNullOrWhiteSpace(inferenceDiag.LoadError))
                {
                    <div style="margin-top: 0.4rem; font-size: 0.85rem; color: var(--rz-danger);">@inferenceDiag.LoadError</div>
                }
            </div>

            <div class="hud-grid diagnostics-grid" style="margin-top: 1rem;">
                <div><label>Model</label><span style="font-size: 0.78rem;">@inferenceDiag.ModelId</span></div>
                <div><label>WebGPU Adapter</label><span>@(inferenceDiag.WebGpuPresent ? "AVAILABLE" : "NONE")</span></div>
                <div><label>Inference Count</label><span>@inferenceDiag.InferenceCount</span></div>
                <div><label>Last Inference</label><span>@(inferenceDiag.LastInferenceTimestamp is not null ? DateTime.Parse(inferenceDiag.LastInferenceTimestamp).ToLocalTime().ToString("HH:mm:ss") : "—")</span></div>
                <div><label>Last Inference Duration</label><span>@(inferenceDiag.LastInferenceMs.HasValue ? $"{inferenceDiag.LastInferenceMs:N0} ms" : "—")</span></div>
            </div>

            @if (!string.IsNullOrWhiteSpace(inferenceDiag.LastInferenceOutput))
            {
                <div style="margin-top: 1rem;">
                    <label style="display: block; margin-bottom: 0.25rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">Last Raw Output</label>
                    <pre style="background: var(--rz-base-background-color); padding: 0.75rem; border-radius: 4px; font-size: 0.8rem; white-space: pre-wrap; word-break: break-word;">@inferenceDiag.LastInferenceOutput</pre>
                </div>
            }
        }
    </RadzenCard>
</div>

@code {
    private DiagnosticsSnapshotDto? snapshot;
    private string statusMessage = string.Empty;
    private InferenceDiagnosticsDto? inferenceDiag;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _ = PollInferenceDiagnosticsAsync(_cts.Token);
    }

    private async Task PollInferenceDiagnosticsAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(5000, ct);
                await RefreshInferenceDiagnosticsAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task LoadAsync()
    {
        try
        {
            snapshot = await ApiClient.GetDiagnosticsAsync();
            statusMessage = snapshot is null
                ? "Diagnostics unavailable in current environment."
                : "Diagnostics refreshed successfully.";
        }
        catch
        {
            snapshot = null;
            statusMessage = "Diagnostics unavailable in current environment.";
        }

        await RefreshInferenceDiagnosticsAsync();
    }

    private async Task RefreshInferenceDiagnosticsAsync()
    {
        try
        {
            inferenceDiag = await JS.InvokeAsync<InferenceDiagnosticsDto>("powatchInference.getInferenceDiagnostics");
        }
        catch
        {
            inferenceDiag = null;
        }
    }

    private sealed class InferenceDiagnosticsDto
    {
        public string ModelId { get; set; } = string.Empty;
        public string LoadState { get; set; } = string.Empty;
        public string? LoadError { get; set; }
        public string? Device { get; set; }
        public string? Dtype { get; set; }
        public bool Fp16FallbackUsed { get; set; }
        public int? LoadDurationMs { get; set; }
        public int InferenceCount { get; set; }
        public int? LastInferenceMs { get; set; }
        public string? LastInferenceTimestamp { get; set; }
        public string? LastInferenceOutput { get; set; }
        public bool WebGpuPresent { get; set; }
    }
}
