@page "/system"
@page "/diagnostics"
@page "/health"
@attribute [Authorize]
@using System.Globalization
@using PoWatch.Shared.Models
@using Microsoft.Extensions.Options
@using PoWatch.Client.Components.Stats
@inject PoWatchApiClient ApiClient
@inject IJSRuntime JS
@inject IOptions<ClientFeatureFlagsOptions> ClientFlags
@inject ModelRegistryService ModelRegistry
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>PoWatch | System</PageTitle>

@* Everything operational on one page, refreshed on one timer: connections (what /health reports),
   the server runtime, the on-device inference engine, the pipeline counters, and the model self-test. *@
<div class="term-grid">
    <TerminalPanel Number="S1" Title="Connections" Class="term-span-2" Test="health-overall" Flush="true">
        <Aside>@(_lastRefreshed is { } at ? $"UPDATED {at:HH:mm:ss} · EVERY {_interval.TotalSeconds:0} S" : "CHECKING…")</Aside>
        <ChildContent>
            @if (_healthError is not null)
            {
                @* A failed fetch is itself a health signal — the API is unreachable from this browser. *@
                <p class="sys-line" role="status"><span class="term-dot term-dot--bad"></span><b>Cannot reach the server</b> @_healthError</p>
            }
            else if (_health is null)
            {
                <p class="sys-line" role="status"><span class="term-dot"></span><b>Checking…</b></p>
            }
            else
            {
                <p class="sys-line" role="status">
                    <span class="term-dot @Dot(_health.Status)"></span>
                    <b data-test="health-overall-status">@FriendlyStatus(_health.Status)</b>
                    <span class="term-stat-hint">@_health.Checks.Count checked in @_health.DurationMs.ToString("0", CultureInfo.CurrentCulture) ms</span>
                </p>
                <table class="term-table" data-test="health-check-list">
                    <tbody>
                        @foreach (var check in _health.Checks)
                        {
                            <tr data-test="health-check">
                                <td><span class="term-dot @Dot(check.Status)"></span> @FriendlyName(check.Name)</td>
                                <td class="term-stat-hint">@check.Description</td>
                                <td>@FriendlyCheckStatus(check.Status)</td>
                                <td class="r">@check.DurationMs.ToString("0", CultureInfo.CurrentCulture) ms</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
    </TerminalPanel>

    <TerminalPanel Number="S2" Title="Server" Class="term-span-2">
        @if (_snapshot is null)
        {
            <p class="term-empty">Server runtime details are unavailable in this environment.</p>
        }
        else
        {
            <div class="term-stats">
                <StatCell Label="CPU load" Value="@_snapshot.CpuLoadPercent.ToString("0", CultureInfo.InvariantCulture)" Unit="%" />
                <StatCell Label="Memory" Value="@_snapshot.MemoryMb.ToString("0.0", CultureInfo.InvariantCulture)" Unit="MB" />
                <StatCell Label="Storage" Value="@FriendlyStorageLabel(_snapshot.StorageConnectionStatus)" />
                <StatCell Label="Endpoint" Value="@FriendlyEndpointLabel(_snapshot.MaskedEndpoint)" />
                <StatCell Label="API key" Value="@FriendlyKeyLabel(_snapshot.MaskedApiKey)" />
                <StatCell Label="Captured" Value="@DisplayText.RelativeTime(_snapshot.CapturedAtUtc)" />
            </div>
        }
    </TerminalPanel>

    <TerminalPanel Number="S3" Title="Inference engine" Class="term-span-4">
        @if (_inference is { } inf)
        {
            var state = inf.LoadState switch { "ready" => "ok", "loading" => "warn", "error" => "bad", _ => "idle" };
            <p class="sys-line">
                <span class="term-dot term-dot--@state"></span>
                <b>@(state switch { "ok" => "MODEL LOADED", "warn" => "LOADING…", "bad" => "LOAD FAILED", _ => "NOT STARTED" })</b>
                @if (state == "ok")
                {
                    <span class="term-stat-hint">
                        on @inf.Device?.ToUpperInvariant() · @inf.Dtype@(inf.Fp16FallbackUsed ? " · fp16 → fp32 fallback" : string.Empty)@(inf.LoadDurationMs is { } ms ? $" · loaded in {ms:N0} ms" : string.Empty)
                    </span>
                }
            </p>
            @if (state == "bad" && !string.IsNullOrWhiteSpace(inf.LoadError))
            {
                <p class="live-error">@inf.LoadError</p>
            }
            <div class="term-stats">
                <StatCell Label="Model" Value="@(inf.ModelId.Split('/').Last())" Hint="@inf.ModelId" />
                <StatCell Label="WebGPU" Value="@(inf.WebGpuPresent ? "YES" : "NONE")" />
                <StatCell Label="Inferences" Value="@inf.InferenceCount.ToString(CultureInfo.InvariantCulture)" />
                <StatCell Label="Last" Value="@(inf.LastInferenceTimestamp is { } t ? DateTime.Parse(t, CultureInfo.InvariantCulture).ToLocalTime().ToString("HH:mm:ss", CultureInfo.CurrentCulture) : "—")"
                          Hint="@(inf.LastInferenceMs is { } lms ? $"{lms:N0} ms" : null)" />
            </div>
            @if (!string.IsNullOrWhiteSpace(inf.LastInferenceOutput))
            {
                <details class="sys-raw">
                    <summary>Last raw output</summary>
                    <pre>@inf.LastInferenceOutput</pre>
                </details>
            }
        }
        else
        {
            <p class="sys-line" data-test="inference-worker-unreachable">
                <span class="term-dot term-dot--idle"></span><b>WORKER NOT REACHABLE</b>
                <span class="term-stat-hint">The on-device worker hasn't reported in yet. Start a camera session on Live — the model loads on first use.</span>
            </p>
        }
    </TerminalPanel>
</div>

<PipelineTab Query="@_pipelineQuery" />

@* Per-model self-test: which registry models will actually load and generate on THIS device. Each row
   drives the real worker path (load → generate) against one fixed synthetic frame, so the numbers are
   comparable between models and machines. *@
<TerminalPanel Number="S4" Title="Model self-test" Class="sys-selftest">
    <details data-test="diagnostics-advanced">
        <summary>Test which vision models run on this device</summary>
        <div data-test="model-selftest-card">
            <div class="timelapse-actions">
                <button class="term-button term-button--primary" @onclick="TestAllModelsAsync" disabled="@(_modelTestRunning || _modelTests.Count == 0)"
                        data-test="model-selftest-run-all">Test every model</button>
                <span class="term-stat-hint">
                    @(_modelTestRunning
                        ? $"Testing {_runningModelLabel} — a first run can take several minutes."
                        : "A first run downloads the weights (slow, needs a network); later runs read the browser cache. Testing unloads the Live model.")
                </span>
            </div>

            @if (_modelTests.Count == 0)
            {
                <p class="sys-line" data-test="model-selftest-registry-error">
                    <span class="term-dot term-dot--bad"></span><b>MODEL LIST UNAVAILABLE</b>
                    <span class="term-stat-hint">The model registry could not be read; see the browser console.</span>
                </p>
            }
            else
            {
                <table class="term-table sys-models">
                    <thead><tr><th>Model</th><th>Result</th><th>Runs on</th><th class="r">Download</th><th class="r">Load</th><th class="r">Inference</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var row in _modelTests)
                        {
                            var result = row.Result;
                            var state = row.Running ? "warn" : result is null ? "idle" : result.Ok ? "ok" : "bad";
                            <tr data-test="model-selftest-row">
                                <td><span class="term-dot term-dot--@state"></span> @row.Label<div class="term-stat-hint">@row.ModelId</div></td>
                                <td>@(row.Running ? "TESTING…" : result is null ? "NOT TESTED" : result.Ok ? "RUNS HERE" : "FAILED")</td>
                                <td>@(result is null ? "—" : DescribeBackend(result))</td>
                                <td class="r">@(result is null ? "—" : FormatBytes(result.BytesFetched))</td>
                                <td class="r">@(result is null ? "—" : FormatDuration(result.LoadMs))</td>
                                <td class="r">@(result is null ? "—" : FormatDuration(result.InferenceMs))</td>
                                <td class="r"><button class="term-button" @onclick="() => TestOneModelAsync(row.Key)" disabled="@_modelTestRunning">Test</button></td>
                            </tr>
                            @if (result is not null && (!string.IsNullOrWhiteSpace(result.Error) || !string.IsNullOrWhiteSpace(result.RawOutput)))
                            {
                                <tr>
                                    <td colspan="7">
                                        @if (!string.IsNullOrWhiteSpace(result.Error))
                                        {
                                            <p class="live-error">@result.Error</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(result.RawOutput))
                                        {
                                            <details class="sys-raw">
                                                <summary>What the model said about the test image</summary>
                                                <pre>@result.RawOutput</pre>
                                            </details>
                                        }
                                        @if (result.Ok && !string.IsNullOrWhiteSpace(result.PipelineStatus) && result.PipelineStatus != "OK")
                                        {
                                            @* Engine pass, recording fail: the hardware is fine and the model is too small for
                                               the observation loop's quality gates — a model choice, not a machine problem. *@
                                            <p class="term-stat-hint">The engine works. This reply would not have been recorded: @result.PipelineStatus</p>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }

            @if (_lastTestFrameDataUrl is not null)
            {
                <figure class="away-exposure">
                    <img src="@_lastTestFrameDataUrl" alt="Synthetic test scene: a person lying on a bed in a room with a window" />
                    <figcaption>THE TEST IMAGE EVERY MODEL WAS SHOWN</figcaption>
                </figure>
            }
        </div>
    </details>
</TerminalPanel>

@code {
    private HealthReportDto? _health;
    private string? _healthError;
    private DiagnosticsSnapshotDto? _snapshot;
    private InferenceDiagnosticsDto? _inference;
    private StatsQuery _pipelineQuery = StatsQuery.For("today");
    private DateTime? _lastRefreshed;
    private TimeSpan _interval;
    private readonly PollLoop _poll = new();

    // ── Per-model self-test ──────────────────────────────────────────────────────────────────
    // One row per registry model. The worker holds a single model at a time, so tests run strictly
    // one after another and `_modelTestRunning` disables every button for the duration; two
    // concurrent tests would fight over the same slot and report each other's numbers.
    private sealed class ModelTestRow
    {
        public required string Key { get; init; }
        public required string Label { get; init; }
        public string? ModelId { get; set; }
        public bool Running { get; set; }
        public ModelSelfTestResult? Result { get; set; }
    }

    private List<ModelTestRow> _modelTests = [];
    private bool _modelTestRunning;
    private string _runningModelLabel = string.Empty;
    private string? _lastTestFrameDataUrl;

    protected override async Task OnInitializedAsync()
    {
        // The old /health and /diagnostics addresses land here; settle on /system so the SYSTEM key lights up.
        if (!Navigation.Uri.Contains("/system", StringComparison.OrdinalIgnoreCase))
            Navigation.NavigateTo("system", replace: true);

        _interval = TimeSpan.FromSeconds(Math.Max(1, ClientFlags.Value.DiagnosticsAutoRefreshIntervalSeconds));
        await LoadModelTestRowsAsync();
        // One timer for the whole page; a health page showing stale numbers reads as broken.
        _poll.Start(_interval, _ => LoadAsync(), InvokeAsync);
    }

    public async ValueTask DisposeAsync() => await _poll.DisposeAsync();

    private async Task LoadAsync()
    {
        var health = LoadHealthAsync();
        var snapshot = LoadSnapshotAsync();
        await Task.WhenAll(health, snapshot);
        // Paint the server numbers now — the inference query below can take seconds to time out
        // when no worker is running, and the page looked broken meanwhile.
        _pipelineQuery = _pipelineQuery with { Stamp = _pipelineQuery.Stamp + 1 };
        _lastRefreshed = DateTime.Now;
        await InvokeAsync(StateHasChanged);
        await RefreshInferenceDiagnosticsAsync();
    }

    private async Task LoadHealthAsync()
    {
        try
        {
            _health = await ApiClient.GetHealthAsync();
            _healthError = _health is null ? "The server returned an empty health document." : null;
        }
        catch (OperationCanceledException)
        {
            // Page is being disposed — nothing to report.
        }
        catch (Exception ex)
        {
            _health = null;
            _healthError = ex.Message;
        }
    }

    private async Task LoadSnapshotAsync()
    {
        try
        {
            _snapshot = await ApiClient.GetDiagnosticsAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _snapshot = null;
        }
    }

    private async Task RefreshInferenceDiagnosticsAsync()
    {
        // A model self-test can block the worker inside a multi-second ONNX session build, long enough
        // for this query's 5 s bridge timeout to expire. Answering that with "WORKER NOT REACHABLE"
        // would be a lie told while the operator is watching, so hold the last snapshot meanwhile.
        if (_modelTestRunning) return;

        try
        {
            _inference = await JS.TryInvokeAsync<InferenceDiagnosticsDto>("powatchInference.getInferenceDiagnostics");
        }
        catch
        {
            _inference = null;
        }
    }

    private static string Dot(string status) => status switch
    {
        "Healthy" => "term-dot--ok",
        "Degraded" => "term-dot--warn",
        _ => "term-dot--bad"
    };

    // Overall verdict — reads as a summary of the whole system.
    private static string FriendlyStatus(string status) => status switch
    {
        "Healthy" => "All systems connected",
        "Degraded" => "Running with reduced service",
        "Unhealthy" => "Connection problem",
        _ => status
    };

    // Per-connection verdict — the summary wording would be wrong on a single row.
    private static string FriendlyCheckStatus(string status) => status switch
    {
        "Healthy" => "Connected",
        "Degraded" => "Degraded",
        "Unhealthy" => "Not connected",
        _ => status
    };

    // Check names are registration keys ("azure-storage"); nobody should have to decode them.
    private static string FriendlyName(string name) => name switch
    {
        "azure-storage" => "Storage (stats & snapshots)",
        "azure-key-vault" => "Key Vault (secrets)",
        _ => name
    };

    // The raw values are dev-only labels (Azurite is a local emulator; masked endpoint / key rows
    // are for screenshots). Translate them into plain words without losing the status signal.
    private static string FriendlyStorageLabel(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Not connected";
        var s = status.Trim();
        if (s.Contains("azurite", StringComparison.OrdinalIgnoreCase)) return "Local emulator";
        if (s.Contains("ok", StringComparison.OrdinalIgnoreCase)) return "Connected";
        if (s.Contains("error", StringComparison.OrdinalIgnoreCase) || s.Contains("fail", StringComparison.OrdinalIgnoreCase))
            return "Problem";
        return s;
    }

    private static string FriendlyEndpointLabel(string? raw) => string.IsNullOrWhiteSpace(raw) ? "Platform" : "Hidden";

    // The DEV… prefix marks a development-environment credential — don't surface it on a kiosk.
    private static string FriendlyKeyLabel(string? raw) =>
        string.IsNullOrWhiteSpace(raw) ? "Platform" : raw.StartsWith("DEV", StringComparison.OrdinalIgnoreCase) ? "Dev key" : "Configured";

    /// <summary>
    /// One row per registry model. Shares <see cref="ModelRegistryService"/> with the Live picker so
    /// the two screens can never disagree about which models exist.
    /// </summary>
    private async Task LoadModelTestRowsAsync()
    {
        try
        {
            var entries = await ModelRegistry.GetAsync();
            _modelTests = entries.Select(e => new ModelTestRow { Key = e.Key, Label = e.Label, ModelId = e.Id }).ToList();
        }
        catch (Exception ex)
        {
            // The card renders its own "model list unavailable" state from the empty list; the cause
            // goes to the console rather than a toast, which would fire on every visit.
            Console.Error.WriteLine($"[PoWatch] Model self-test could not read the registry: {ex.GetType().Name}: {ex.Message}");
            _modelTests = [];
        }
    }

    private async Task TestOneModelAsync(string modelKey)
    {
        if (_modelTestRunning || _modelTests.FirstOrDefault(r => r.Key == modelKey) is not { } row) return;

        _modelTestRunning = true;
        _runningModelLabel = row.Label;
        row.Running = true;
        row.Result = null;
        StateHasChanged();

        try
        {
            var result = await InvokeModelTestAsync(modelKey);
            row.Result = result;
            row.ModelId = result?.ModelId ?? row.ModelId;
            if (!string.IsNullOrWhiteSpace(result?.TestFrameDataUrl))
                _lastTestFrameDataUrl = result.TestFrameDataUrl;
        }
        finally
        {
            row.Running = false;
            _modelTestRunning = false;
            _runningModelLabel = string.Empty;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Every model, in registry order, one at a time: the worker holds a single model, and running two
    /// at once is the fastest way to exhaust a laptop's GPU memory and fail a model that would pass.
    /// </summary>
    private async Task TestAllModelsAsync()
    {
        foreach (var row in _modelTests.ToList())
            await TestOneModelAsync(row.Key);
    }

    private async Task<ModelSelfTestResult?> InvokeModelTestAsync(string modelKey)
    {
        try
        {
            // CancellationToken.None opts out of JSInterop's default timeout: a first load of the 2.2B
            // model pulls well over a gigabyte, and timing it out would report a slow-but-working
            // machine as a failure — the exact wrong answer for a page that tells those two apart.
            return await JS.InvokeAsync<ModelSelfTestResult>("powatchInference.runModelTest", CancellationToken.None, modelKey);
        }
        catch (JSException ex)
        {
            return new ModelSelfTestResult { ModelKey = modelKey, Stage = "bridge", Error = ex.Message };
        }
        catch (InvalidOperationException ex)
        {
            return new ModelSelfTestResult { ModelKey = modelKey, Stage = "bridge", Error = ex.Message };
        }
    }

    /// <summary>Which backend carried the run, in the terms that decide whether it is usable.</summary>
    private static string DescribeBackend(ModelSelfTestResult result)
    {
        if (string.IsNullOrWhiteSpace(result.Device))
            return result.WebGpuPresent ? "Did not load (GPU available)" : "Did not load (no GPU)";

        var backend = result.Device.Equals("webgpu", StringComparison.OrdinalIgnoreCase) ? "Graphics card" : "Processor (slower)";
        var precision = string.IsNullOrWhiteSpace(result.Dtype) ? string.Empty : $" · {result.Dtype}";
        var fallback = result.Fp16FallbackUsed ? " · reduced precision" : string.Empty;
        return $"{backend}{precision}{fallback}";
    }

    /// <summary>Download size in 1024-based units, matching the browser's own network panel.</summary>
    private static string FormatBytes(long bytes) => bytes switch
    {
        <= 0 => "—",
        < 1024L * 1024L => $"{bytes / 1024d:N0} KB",
        < 1024L * 1024L * 1024L => $"{bytes / (1024d * 1024d):N0} MB",
        _ => $"{bytes / (1024d * 1024d * 1024d):N2} GB"
    };

    /// <summary>Milliseconds below ten seconds, seconds above — a five-digit millisecond count reads as noise.</summary>
    private static string FormatDuration(int? milliseconds) => milliseconds switch
    {
        null => "—",
        < 10_000 and var ms => $"{ms:N0} ms",
        var ms => $"{ms / 1000d:N1} s"
    };

    private sealed class InferenceDiagnosticsDto
    {
        public string ModelId { get; set; } = string.Empty;
        public string LoadState { get; set; } = string.Empty;
        public string? LoadError { get; set; }
        public string? Device { get; set; }
        public string? Dtype { get; set; }
        public bool Fp16FallbackUsed { get; set; }
        public int? LoadDurationMs { get; set; }
        public int InferenceCount { get; set; }
        public int? LastInferenceMs { get; set; }
        public string? LastInferenceTimestamp { get; set; }
        public string? LastInferenceOutput { get; set; }
        public bool WebGpuPresent { get; set; }
    }
}
