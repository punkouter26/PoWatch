@page "/diagnostics"
@attribute [Authorize]
@using PoWatch.Shared.Models
@using Microsoft.Extensions.Options
@inject PoWatch.Client.Services.PoWatchApiClient ApiClient
@inject IJSRuntime JS
@inject IOptions<ClientFeatureFlagsOptions> ClientFlags
@inject NotificationService NotificationService
@inject DialogService DialogService
@implements IDisposable

<PageTitle>PoWatch | System</PageTitle>

<div class="sector-grid diagnostics-page">
    @* Consolidation #8: one Health card — server row + inference row, one refresh control,
       auto-refresh on by default. *@
    <RadzenCard class="panel">
        <header class="panel-header">
            <h1>System</h1>
            <p>Runtime, storage &amp; inference — refreshed automatically.</p>
        </header>

        <div class="diagnostics-toolbar">
            <RadzenButton Text="Refresh Now" ButtonStyle="ButtonStyle.Primary" Click="LoadAsync" />
            <div class="auto-refresh-toggle">
                <span>Auto-Refresh</span>
                <RadzenSwitch TValue="bool" Value="autoRefresh" Change="OnAutoRefreshChanged" />
            </div>
            @if (lastRefreshed.HasValue)
            {
                <div class="refresh-indicator">
                    <span class="refresh-dot @(autoRefresh ? "refresh-dot--active" : string.Empty)"></span>
                    <span>@lastRefreshed.Value.ToString("HH:mm:ss")</span>
                </div>
            }
        </div>

        @if (snapshot is not null)
        {
            <div class="hud-grid diagnostics-grid">
                <div><label>Captured</label><span>@snapshot.CapturedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span></div>
                <div><label>CPU Load</label><span>@snapshot.CpuLoadPercent.ToString("0")%</span></div>
                <div><label>Memory</label><span>@snapshot.MemoryMb.ToString("0.0") MB</span></div>
                <div><label>Storage</label><span>@FriendlyStorageLabel(snapshot.StorageConnectionStatus)</span></div>
                <div><label>Server endpoint</label><span title="@snapshot.MaskedEndpoint" class="masked-value">@FriendlyEndpointLabel(snapshot.MaskedEndpoint)</span></div>
                <div><label>API key</label><span>@FriendlyKeyLabel(snapshot.MaskedApiKey)</span></div>
            </div>
        }
        <h2 class="health-section-label">Inference engine</h2>

        @* Fix #6: the inference section used to render only its header when the worker hadn't
           yet reported in, leaving the operator with "why isn't inference working?" and no
           answer. Always render a state block — even if it's "worker not reachable yet" —
           so the page never reads as broken. *@
        @if (inferenceDiag is not null)
        {
            var isReady = inferenceDiag.LoadState == "ready";
            var isLoading = inferenceDiag.LoadState == "loading";
            var isError = inferenceDiag.LoadState == "error";
            var stateClass = isReady ? "status-ready" : isLoading ? "status-loading" : isError ? "status-error" : "status-idle";

            <div class="inference-status @stateClass">
                <div class="status-indicator">
                    <span class="status-dot @stateClass"></span>
                    <span class="status-label @stateClass">
                        @(isReady ? "MODEL LOADED" : isLoading ? "LOADING…" : isError ? "LOAD FAILED" : "NOT STARTED")
                    </span>
                </div>
                @if (isReady)
                {
                    <div class="status-sub">
                        Running on <strong>@inferenceDiag.Device!.ToUpperInvariant()</strong> · dtype <strong>@inferenceDiag.Dtype</strong>
                        @if (inferenceDiag.Fp16FallbackUsed) { <span> · fp16 → fp32 fallback active</span> }
                        @if (inferenceDiag.LoadDurationMs.HasValue) { <span> · loaded in @($"{inferenceDiag.LoadDurationMs:N0} ms")</span> }
                    </div>
                }
                @if (isError && !string.IsNullOrWhiteSpace(inferenceDiag.LoadError))
                {
                    <div class="status-error-detail">@inferenceDiag.LoadError</div>
                }
            </div>

            <div class="hud-grid diagnostics-grid diagnostics-grid-spacer">
                <div><label>Model</label><span class="model-id-text">@inferenceDiag.ModelId</span></div>
                <div><label>WebGPU Adapter</label><span>@(inferenceDiag.WebGpuPresent ? "AVAILABLE" : "NONE")</span></div>
                <div><label>Inference Count</label><span>@inferenceDiag.InferenceCount</span></div>
                <div><label>Last Inference</label><span>@(inferenceDiag.LastInferenceTimestamp is not null ? DateTime.Parse(inferenceDiag.LastInferenceTimestamp).ToLocalTime().ToString("HH:mm:ss") : "—")</span></div>
                <div><label>Last Inference Duration</label><span>@(inferenceDiag.LastInferenceMs.HasValue ? $"{inferenceDiag.LastInferenceMs:N0} ms" : "—")</span></div>
            </div>

            @if (!string.IsNullOrWhiteSpace(inferenceDiag.LastInferenceOutput))
            {
                <div class="raw-output-container">
                    <label class="raw-output-label">Last Raw Output</label>
                    <pre class="raw-output-pre">@inferenceDiag.LastInferenceOutput</pre>
                </div>
            }
        }
        else
        {
            <div class="inference-status status-idle" data-test="inference-worker-unreachable">
                <div class="status-indicator">
                    <span class="status-dot status-idle"></span>
                    <span class="status-label status-idle">WORKER NOT REACHABLE</span>
                </div>
                <div class="status-sub">The on-device inference worker hasn't reported in yet. Open the Live Room and press Start watching — the model loads on first use and will appear here.</div>
            </div>
        }
    </RadzenCard>

    @* Gated on the SERVER's developer-mode signal, matching the Live Room's "Clear data" button.
   This used to read the client-only ExposeDebugDetailsInUi flag, which the WASM app never
   picks up (it does not load the Development appsettings) — so the same destructive action
   had two different gates and this one effectively never appeared. The card also lived
   outside the page's .sector-grid, so on the rare occasion it did render it fell out of the
   page layout; it is inside the grid now. *@
    @if (observerState?.DeveloperModeEnabled == true)
    {
        <RadzenCard class="panel panel--danger">
        <header class="panel-header">
            <h1>Danger Zone</h1>
            <p>Irreversible operations. Guarded by the <code>AllowDataReset</code> server feature flag.</p>
        </header>

        <div class="danger-zone-actions">
            <RadzenButton Text="Clear All Data" ButtonStyle="ButtonStyle.Danger"
                          Click="ResetAllDataAsync" Disabled="resetBusy" />
            @if (resetBusy)
            {
                <span class="reset-status">Resetting&#8230;</span>
            }
            @if (resetResult is not null)
            {
                @if (resetResult.Success)
                {
                    <span class="reset-status reset-status--ok">
                        Done &#8212; @resetResult.ObservationsDeleted observations, @resetResult.SubjectsDeleted subjects, @resetResult.BlobsDeleted blobs deleted in @resetResult.Duration.TotalSeconds.ToString("0.0")s
                    </span>
                }
                else
                {
                    <span class="reset-status reset-status--err">Failed: @resetResult.ErrorMessage</span>
                }
            }
        </div>
        </RadzenCard>
    }
</div>

@code {
    private DiagnosticsSnapshotDto? snapshot;
    private ObserverRuntimeStateDto? observerState;
    private InferenceDiagnosticsDto? inferenceDiag;
    private bool autoRefresh = true;
    private DateTime? lastRefreshed;
    private int _autoRefreshIntervalSeconds;
    private CancellationTokenSource _cts = new();
    private bool resetBusy;
    private StorageResetResultDto? resetResult;

    protected override async Task OnInitializedAsync()
    {
        _autoRefreshIntervalSeconds = ClientFlags.Value.DiagnosticsAutoRefreshIntervalSeconds;
        await LoadAsync();
        // Auto-refresh is the default (consolidation #8) — a health page that shows stale
        // numbers until someone clicks Refresh reads as broken.
        if (autoRefresh)
            _ = AutoRefreshLoopAsync(_cts.Token);
    }

    private void OnAutoRefreshChanged(bool value)
    {
        autoRefresh = value;
        // Dispose the old source before replacing it — toggling repeatedly used to leak one
        // CancellationTokenSource (and its registrations) per flip.
        _cts.Cancel();
        _cts.Dispose();
        _cts = new CancellationTokenSource();

        if (autoRefresh)
            _ = AutoRefreshLoopAsync(_cts.Token);
    }

    private async Task AutoRefreshLoopAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(_autoRefreshIntervalSeconds), ct);
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task LoadAsync()
    {
        try
        {
            snapshot = await ApiClient.GetDiagnosticsAsync();
            // DeveloperModeEnabled lives on the observer runtime state, and it is what gates
            // the Danger Zone below (same signal the Live Room's "Clear data" button uses).
            try { observerState = await ApiClient.GetObserverStateAsync(); } catch { observerState = null; }
            if (snapshot is null)
                NotificationService.Notify(NotificationSeverity.Warning, "Diagnostics", "Unavailable in current environment.", duration: 4000);
            // Paint the snapshot immediately — the inference query below can take seconds to
            // time out when no worker is running, and the page looked broken meanwhile.
            StateHasChanged();
        }
        catch
        {
            snapshot = null;
            NotificationService.Notify(NotificationSeverity.Warning, "Diagnostics", "Unavailable in current environment.", duration: 4000);
        }

        await RefreshInferenceDiagnosticsAsync();
        lastRefreshed = DateTime.Now;
    }

    private async Task RefreshInferenceDiagnosticsAsync()
    {
        try
        {
            inferenceDiag = await JS.TryInvokeAsync<InferenceDiagnosticsDto>("powatchInference.getInferenceDiagnostics");
        }
        catch
        {
            inferenceDiag = null;
        }
    }

    // Fix #5: the raw values from the API are dev-only labels (Azurite is a local emulator,
    // masked-endpoint / masked-key rows are designed for screenshots, not users). Translate
    // them into caregiver-friendly copy without losing the actual status signal.
    private static string FriendlyStorageLabel(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Not connected";
        var s = status.Trim();
        if (s.Contains("azurite", StringComparison.OrdinalIgnoreCase)) return "Connected (local emulator)";
        if (s.Contains("ok", StringComparison.OrdinalIgnoreCase)) return "Connected";
        if (s.Contains("error", StringComparison.OrdinalIgnoreCase) || s.Contains("fail", StringComparison.OrdinalIgnoreCase))
            return "Connection problem";
        return s;
    }

    private static string FriendlyEndpointLabel(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "Managed by platform";
        // The server already masks the value; surface that fact plainly.
        return "Hidden (configured)";
    }

    private static string FriendlyKeyLabel(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "Managed by platform";
        // The DEV... prefix indicates a development-environment credential — don't surface that on a kiosk.
        if (raw.StartsWith("DEV", StringComparison.OrdinalIgnoreCase)) return "Development credential";
        return "Configured";
    }

    private async Task ResetAllDataAsync()
    {
        var confirmed = await DialogService.Confirm(
            "This will permanently delete ALL observations, subjects, and blobs from storage. This cannot be undone.",
            "Confirm Clear All Data",
            new ConfirmOptions { OkButtonText = "Clear Everything", CancelButtonText = "Cancel", CloseDialogOnOverlayClick = true });

        if (confirmed != true)
            return;

        resetBusy = true;
        resetResult = null;

        try
        {
            resetResult = await ApiClient.ClearAllDataAsync();
            if (resetResult?.Success == true)
                NotificationService.Notify(NotificationSeverity.Success, "Reset Complete",
                    $"{resetResult.ObservationsDeleted} observations, {resetResult.SubjectsDeleted} subjects, {resetResult.BlobsDeleted} blobs deleted.",
                    duration: 8000);
            else
                NotificationService.Notify(NotificationSeverity.Error, "Reset Failed",
                    resetResult?.ErrorMessage ?? "Unknown error", duration: 6000);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Reset Failed", ex.Message, duration: 6000);
        }
        finally
        {
            resetBusy = false;
        }
    }

    private sealed class InferenceDiagnosticsDto
    {
        public string ModelId { get; set; } = string.Empty;
        public string LoadState { get; set; } = string.Empty;
        public string? LoadError { get; set; }
        public string? Device { get; set; }
        public string? Dtype { get; set; }
        public bool Fp16FallbackUsed { get; set; }
        public int? LoadDurationMs { get; set; }
        public int InferenceCount { get; set; }
        public int? LastInferenceMs { get; set; }
        public string? LastInferenceTimestamp { get; set; }
        public string? LastInferenceOutput { get; set; }
        public bool WebGpuPresent { get; set; }
    }
}
