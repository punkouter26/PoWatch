@page "/settings"
@using System.Globalization
@using System.Security.Claims
@inject SensingSession Sensing
@inject PoWatchApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>PoWatch | Settings</PageTitle>

@* Every optional choice in one place, so the pages you work on carry none. Each starts on the value
   that suits most rooms (dark, quiet cues, captions on, no rules) and is remembered in this browser. *@
<div class="term-grid" data-test="settings-page">
    <TerminalPanel Title="Preferences" Class="term-span-2" Test="settings-preferences" Flush="true">
        <Aside>REMEMBERED IN THIS BROWSER</Aside>
        <ChildContent>
            <div class="settings-list">
                <button class="term-menu-item" @onclick="ToggleThemeAsync" data-test="theme-toggle">
                    <span>Theme</span><b>@_theme.ToUpperInvariant()</b>
                </button>
                <button class="term-menu-item" @onclick="CycleSoundAsync" data-test="sound-toggle">
                    <span>Sound cues <i>off · low · mid · high</i></span><b>@_sound.ToUpperInvariant()</b>
                </button>
                <button class="term-menu-item" role="switch" aria-checked="@(Sensing.Captions ? "true" : "false")" @onclick="ToggleCaptionsAsync" data-test="captions-toggle">
                    <span>Captions <i>an on-device vision model describes the scene</i></span><b>@(Sensing.Captions ? "ON" : "OFF")</b>
                </button>
                <button class="term-menu-item" onclick="powatchMenus.openPalette()" data-test="open-palette">
                    <span>Commands and shortcuts</span><b>CTRL K</b>
                </button>
            </div>
        </ChildContent>
    </TerminalPanel>

    <TerminalPanel Title="Watch rules" Class="term-span-2" Test="watch-rules">
        <Aside>@_rules.Count OF @WatchRules.Max</Aside>
        <ChildContent>
            @foreach (var rule in _rules)
            {
                <div class="rule-row">
                    <span>@rule</span>
                    <button class="term-icon-button" @onclick="() => RemoveRuleAsync(rule)" aria-label="@($"Remove rule: {rule}")">✕</button>
                </div>
            }
            @if (_rules.Count < WatchRules.Max)
            {
                <form class="rule-form" @onsubmit="AddRuleAsync">
                    <label class="visually-hidden" for="rule-class">Alert me when this appears</label>
                    <select id="rule-class" @bind="_ruleClass">
                        <option value="person">person</option>
                        <option value="cat">cat</option>
                        <option value="dog">dog</option>
                        <option value="@WatchRules.Any">anything</option>
                    </select>
                    <label class="visually-hidden" for="rule-from">From hour</label>
                    <input id="rule-from" type="number" min="0" max="23" @bind="_ruleFrom" />
                    <span aria-hidden="true">→</span>
                    <label class="visually-hidden" for="rule-to">Until hour</label>
                    <input id="rule-to" type="number" min="0" max="23" @bind="_ruleTo" />
                    <button type="submit" class="term-button" data-test="rule-add">Add</button>
                </form>
            }
            <p class="term-stat-hint">Alerts land in the bell. Hours are local; the same hour twice means any time. @(_notifications ?? "They also show as desktop notifications if you allow them.")</p>
        </ChildContent>
    </TerminalPanel>

    <TerminalPanel Title="Kept on the server" Class="term-span-2" Test="settings-server" Flush="true">
        <Aside>FOR YOUR ACCOUNT</Aside>
        <ChildContent>
            @if (_profile is null)
            {
                <p class="term-empty">@(_profileLoaded ? "Could not load these settings — the server did not answer." : "Loading…")</p>
            }
            else
            {
                <div class="settings-list">
                    <button class="term-menu-item" @onclick="NextRetention" disabled="@_saving" data-test="retention-toggle">
                        <span>Raw detail kept <i>replays, captions, moments; charts and totals stay forever</i></span><b>@RetentionLabel(_profile.RetentionDays)</b>
                    </button>
                    @if (_pendingRetention is { } shorter)
                    {
                        <div class="settings-confirm" role="alert" data-test="retention-confirm">
                            <span>Raw detail older than @RetentionLabel(shorter).ToLowerInvariant() will be deleted within a few hours. It cannot be brought back.</span>
                            <button class="term-button term-button--danger" @onclick="() => SaveRetentionAsync(shorter)" disabled="@_saving">Keep @RetentionLabel(shorter).ToLowerInvariant()</button>
                            <button class="term-button" @onclick="() => _pendingRetention = null">Cancel</button>
                        </div>
                    }

                    <div class="settings-place" data-test="weather-place">
                        <span>Weather from <i>daily weather beside each day on History</i></span>
                        @if (_profile.Place is { } place)
                        {
                            <b>@place.Name.ToUpperInvariant()</b>
                            <button class="term-icon-button" @onclick="ClearPlaceAsync" disabled="@_saving" aria-label="Stop showing weather" title="Stop showing weather">✕</button>
                        }
                        else
                        {
                            <b>OFF</b>
                        }
                    </div>
                    <form class="settings-search" @onsubmit="SearchPlacesAsync">
                        <label class="visually-hidden" for="place-search">Find a town or city</label>
                        <input id="place-search" @bind="_placeQuery" placeholder="Find a town or city…" autocomplete="off" maxlength="80" data-test="place-search" />
                        <button type="submit" class="term-button" disabled="@_searching" data-test="place-search-go">@(_searching ? "…" : "Find")</button>
                    </form>
                    @if (_places is { } places)
                    {
                        @if (places.Count == 0)
                        {
                            <p class="term-stat-hint">NO PLACE BY THAT NAME</p>
                        }
                        <ul class="settings-results" data-test="place-results">
                            @foreach (var found in places)
                            {
                                <li><button class="term-menu-item" @onclick="() => SavePlaceAsync(found)" disabled="@_saving"><span>@found.Name <i>@found.Detail</i></span><b>USE</b></button></li>
                            }
                        </ul>
                    }

                    <button class="term-menu-item" role="switch" aria-checked="@(_profile.DigestEmail ? "true" : "false")" @onclick="ToggleDigestEmailAsync"
                            disabled="@(_saving || !_profile.DigestEmailAvailable)" data-test="digest-toggle">
                        <span>Weekly email <i>@(_profile.DigestEmailAvailable ? (_profile.DigestEmail ? $"Mondays, to {_profile.Email}" : "the week in review, Monday mornings") : "this server cannot send email; the week is on History")</i></span>
                        <b>@(_profile.DigestEmail ? "ON" : "OFF")</b>
                    </button>
                </div>
                @if (_profileMessage is not null)
                {
                    <p class="term-stat-hint settings-note" role="status">@_profileMessage</p>
                }
            }
        </ChildContent>
    </TerminalPanel>

    <TerminalPanel Title="Shared recaps" Class="term-span-2" Test="settings-shares">
        <Aside>@(_shares?.Count ?? 0) LIVE</Aside>
        <ChildContent>
            @if (_shares is null)
            {
                <p class="term-empty">Could not load your links.</p>
            }
            else if (_shares.Count == 0)
            {
                <p class="term-empty">No shared recaps. Share a day from its recap on History; the link works without signing in until it expires.</p>
            }
            else
            {
                @foreach (var share in _shares)
                {
                    <div class="rule-row" data-test="share-row">
                        <span><a href="@share.Path" target="_blank" rel="noopener">@share.Day.ToString("ddd d MMM", CultureInfo.CurrentCulture)</a> <i class="term-stat-hint">UNTIL @share.ExpiresUtc.ToLocalTime().ToString("d MMM HH:mm", CultureInfo.CurrentCulture)</i></span>
                        <button class="term-icon-button" @onclick="() => RevokeAsync(share)" aria-label="@($"Take down the link to {share.Day:d MMM}")" title="Take the link down" data-test="share-revoke">✕</button>
                    </div>
                }
            }
        </ChildContent>
    </TerminalPanel>

    <TerminalPanel Title="Account and data" Class="term-span-4" Test="your-data">
        <Aside>@_email</Aside>
        <ChildContent>
            <div class="settings-actions">
                <button class="term-button" @onclick="SignOutAsync" disabled="@_signingOut" data-test="sign-out">Sign out</button>
                <a class="term-button" href="system" data-test="nav-system">System status →</a>
                <a class="term-button" href="@PoWatchApiClient.ExportUrl(TimeZoneInfo.Local.Id)" download="PoWatch-days.csv" data-test="export-csv">Export days as CSV ↓</a>
                @if (!_confirmDelete)
                {
                    <button class="term-button term-button--danger" @onclick="() => _confirmDelete = true" data-test="delete-data">Delete everything…</button>
                }
                else
                {
                    <button class="term-button term-button--danger" @onclick="DeleteAllAsync" disabled="@_deleting" data-test="delete-data-confirm">@(_deleting ? "Deleting…" : "Yes, delete it all")</button>
                    <button class="term-button" @onclick="() => _confirmDelete = false" disabled="@_deleting">Keep it</button>
                    <span class="live-error" role="alert">Sessions, stats, regulars and snapshots go for good.</span>
                }
                @if (_dataMessage is not null)
                {
                    <span class="term-stat-hint" role="status">@_dataMessage</span>
                }
            </div>
        </ChildContent>
    </TerminalPanel>
</div>

@code {
    private string _theme = "dark";
    private string _sound = "low";
    private string? _email;
    private bool _signingOut;
    private List<WatchRule> _rules = [];
    private string? _notifications;
    private string _ruleClass = "person";
    private int _ruleFrom = 22;
    private int _ruleTo = 6;
    private bool _confirmDelete;
    private bool _deleting;
    private string? _dataMessage;

    private ProfileDto? _profile;
    private bool _profileLoaded;
    private bool _saving;
    private string? _profileMessage;
    private int? _pendingRetention;
    private string? _placeQuery;
    private bool _searching;
    private IReadOnlyList<PlaceDto>? _places;
    private List<ShareDto>? _shares = [];

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _email = user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("preferred_username")?.Value ?? user.Identity?.Name;
        }

        var profile = Api.GetProfileAsync();
        var shares = Api.ListSharesAsync();
        _rules = await WatchRules.LoadAsync(JS);
        var theme = await JS.TryInvokeAsync<string>("powatchTheme.get");
        if (!string.IsNullOrEmpty(theme)) _theme = theme;
        _sound = await JS.TryInvokeAsync<string>("powatchCues.level") ?? _sound;
        (_profile, _profileLoaded) = (await profile, true);
        _shares = (await shares)?.ToList();
    }

    private static string RetentionLabel(int? days) => days switch
    {
        null => "FOREVER",
        365 => "1 YEAR",
        _ => $"{days} DAYS"
    };

    /// <summary>Forever, 1 year, 90 days, 30 days, then forever again. Keeping less deletes, so it asks first.</summary>
    private async Task NextRetention()
    {
        if (_profile is null) return;
        var choices = _profile.RetentionChoices.OrderByDescending(d => d).Select(d => (int?)d).Prepend(null).ToList();
        var next = choices[(choices.IndexOf(_profile.RetentionDays) + 1) % choices.Count];
        if (next is { } shorter && (_profile.RetentionDays is null || shorter < _profile.RetentionDays)) _pendingRetention = shorter;
        else await SaveRetentionAsync(next);
    }

    private Task SaveRetentionAsync(int? days) => SaveAsync(p => new() { RetentionDays = days, Place = p.Place, DigestEmail = p.DigestEmail },
        days is null ? "Everything is kept." : $"Raw detail older than {RetentionLabel(days).ToLowerInvariant()} goes within a few hours.");

    private async Task SearchPlacesAsync()
    {
        if (string.IsNullOrWhiteSpace(_placeQuery)) return;
        _searching = true;
        _places = await Api.SearchPlacesAsync(_placeQuery.Trim());
        _searching = false;
    }

    private async Task SavePlaceAsync(PlaceDto place)
    {
        await SaveAsync(p => new() { RetentionDays = p.RetentionDays, Place = place, DigestEmail = p.DigestEmail }, $"Weather now comes from {place.Name}.");
        (_places, _placeQuery) = (null, null);
    }

    private Task ClearPlaceAsync() => SaveAsync(p => new() { RetentionDays = p.RetentionDays, Place = null, DigestEmail = p.DigestEmail }, "Weather is off.");

    private Task ToggleDigestEmailAsync() => SaveAsync(p => new() { RetentionDays = p.RetentionDays, Place = p.Place, DigestEmail = !p.DigestEmail },
        _profile?.DigestEmail == true ? "The weekly email is off." : "The weekly email is on.");

    /// <summary>The profile is replaced as a whole; the page shows what the server saved, or keeps the old values.</summary>
    private async Task SaveAsync(Func<ProfileDto, UpdateProfileDto> change, string done)
    {
        if (_profile is null) return;
        _saving = true;
        var update = change(_profile);
        var saved = await Api.UpdateProfileAsync(new UpdateProfileDto
        {
            RetentionDays = update.RetentionDays,
            Place = update.Place,
            DigestEmail = update.DigestEmail,
            TimeZoneId = TimeZoneInfo.Local.Id
        });
        if (saved is not null) _profile = saved;
        _profileMessage = saved is null ? "Could not save — nothing was changed." : done;
        (_saving, _pendingRetention) = (false, null);
    }

    private async Task RevokeAsync(ShareDto share)
    {
        if (await Api.RevokeShareAsync(share.Token)) _shares?.Remove(share);
    }

    private async Task ToggleThemeAsync()
    {
        var next = await JS.TryInvokeAsync<string>("powatchTheme.toggle");
        _theme = string.IsNullOrEmpty(next) ? (_theme == "dark" ? "light" : "dark") : next;
    }

    private async Task CycleSoundAsync() => _sound = await JS.TryInvokeAsync<string>("powatchCues.cycle") ?? _sound;

    private async Task ToggleCaptionsAsync()
    {
        Sensing.Captions = !Sensing.Captions;
        await JS.TryInvokeVoidAsync("localStorage.setItem", PoWatch.Client.Layout.MainLayout.CaptionsKey, Sensing.Captions ? "on" : "off");
    }

    private async Task AddRuleAsync()
    {
        var rule = new WatchRule(_ruleClass, Math.Clamp(_ruleFrom, 0, 23), Math.Clamp(_ruleTo, 0, 23));
        if (!_rules.Contains(rule)) _rules.Add(rule);
        await SaveRulesAsync();
        // Asking needs a click, and this is one: the first rule is the moment the permission makes sense.
        _notifications = await JS.TryInvokeAsync<string>("powatchCues.allowNotifications") switch
        {
            "granted" => "Desktop notifications are on.",
            "denied" => "Desktop notifications are blocked for this site; alerts still show in the bell and play a sound.",
            _ => null
        };
    }

    private Task RemoveRuleAsync(WatchRule rule)
    {
        _rules.Remove(rule);
        return SaveRulesAsync();
    }

    private async Task SaveRulesAsync()
    {
        await WatchRules.SaveAsync(JS, _rules);
        Sensing.Rules = [.. _rules];
    }

    private async Task DeleteAllAsync()
    {
        _deleting = true;
        _dataMessage = await Api.DeleteMyDataAsync() ? "Everything was deleted." : "Could not delete — nothing was changed. Try again.";
        (_deleting, _confirmDelete) = (false, false);
    }

    private async Task SignOutAsync()
    {
        _signingOut = true;
        try
        {
            if (Sensing.IsRunning) await Sensing.StopAsync();
            using var response = await Http.PostAsync("auth/logout", content: null);
        }
        catch (HttpRequestException)
        {
            // The cookie may already be gone; the reload below settles it either way.
        }
        finally
        {
            Navigation.NavigateTo("login", forceLoad: true);
        }
    }
}
