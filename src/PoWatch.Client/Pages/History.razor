@page "/history"
@page "/history/{Day}"
@using System.Globalization
@using PoWatch.Shared.Services.Recaps
@inject PoWatchApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>PoWatch | History</PageTitle>

@* Master-detail in one viewport: the year and the chosen day's numbers on the left, everything about
   that day on the right: the recap with its motion, sessions and captions, then moments and the time-lapse. The day is in the address (/history/2026-10-03), so it survives a
   reload and Back/Forward walk the days you looked at. ◀ ▶ and the arrow keys step a day (menus.js). *@
<div class="history-grid">
    <div class="history-col">
        <TerminalPanel Title="The year" Test="history-calendar">
            <Aside>@(_patterns?.Calendar.Count ?? 0) DAYS · CLICK ONE TO OPEN IT</Aside>
            <ChildContent>
                <HeatGrid Values="@_calendarCells" Columns="53" Rows="7" Label="Daily occupancy over the last year"
                          Selected="@CellFor(_day)" OnCellClick="@(i => { if (DayFor(i) is { } d) Go(d); })"
                          CellTitle="@((i, v) => DayFor(i) is { } d ? $"{d:ddd dd MMM} · {(v > 0 ? v.ToString("P0", CultureInfo.CurrentCulture) : "no data")}" : string.Empty)" />
            </ChildContent>
        </TerminalPanel>

        <TerminalPanel Title="The day" Class="history-day-panel" Test="history-day-stats">
            <Aside>
                <span class="history-nav" data-test="history-toolbar">
                    <button class="term-button" @onclick="() => Move(-1)" aria-label="Previous day" title="Previous day (←)" data-test="history-prev">◀</button>
                    <span class="history-day" data-test="history-day">@_day.ToString("ddd d MMM yyyy", CultureInfo.CurrentCulture)</span>
                    <button class="term-button" @onclick="() => Move(1)" disabled="@(_day >= Today)" aria-label="Next day" title="Next day (→)" data-test="history-next">▶</button>
                    <button class="term-button" @onclick="() => Go(Today)" disabled="@(_day == Today)" aria-label="Go to today">Today</button>
                </span>
            </Aside>
            <ChildContent>
                @if (!_loaded)
                {
                    <Skeleton Heights="@([96])" />
                }
                else if (_presence is null || _presence.SecondsObserved == 0)
                {
                    <p class="term-empty" data-test="history-empty">Nothing was observed on this day.</p>
                }
                else
                {
                    <div class="history-numbers">
                        <Dial Value="@_presence.Occupancy" Label="occupied" />
                        <div class="term-stats">
                            <StatCell Label="Occupancy" Value="@_presence.Occupancy.ToString("0.0%", CultureInfo.InvariantCulture)" Test="history-occupancy" />
                            <StatCell Label="Observed" Value="@DisplayText.Duration(_presence.SecondsObserved)" />
                            <StatCell Label="Visits" Value="@_presence.Visits.ToString(CultureInfo.InvariantCulture)" />
                            <StatCell Label="Peak at once" Value="@_presence.PeakConcurrency.ToString(CultureInfo.InvariantCulture)" />
                            <StatCell Label="Busiest" Value="@(_presence.BusiestStartUtc?.ToLocalTime().ToString("HH:mm", CultureInfo.CurrentCulture) ?? "—")" />
                            <StatCell Label="Longest empty" Value="@DisplayText.Duration(_presence.LongestEmptySeconds)" />
                        </div>
                    </div>
                }
            </ChildContent>
        </TerminalPanel>
    </div>

    <RadzenTabs @bind-SelectedIndex="_tab" RenderMode="TabRenderMode.Server" class="history-tabs" data-test="history-tabs">
        <Tabs>
            <RadzenTabsItem Text="Recap">
                @if (_recap is null || _presence is not { SecondsObserved: > 0 })
                {
                    <p class="term-empty">@(_loaded ? "No recap: nothing was observed on this day." : "Loading…")</p>
                }
                else
                {
                    <div class="history-recap" data-test="history-recap">
                        @* Keyed on who wrote it: when a model's version replaces the template's, it eases in. *@
                        <p class="recap-summary fx-rise" @key="_recap.Source">@_recap.Summary</p>
                        @if (_recap.Highlights.Count > 0)
                        {
                            <ul class="recap-highlights">
                                @foreach (var highlight in _recap.Highlights)
                                {
                                    <li>@highlight</li>
                                }
                            </ul>
                        }
                        <p class="history-recap-foot">
                            <span class="term-stat-hint">WRITTEN BY @_recap.Source.ToUpperInvariant()@(_rewriting ? " · A MODEL IS REWORDING IT…" : string.Empty)</span>
                            <a class="term-button" href="@PoWatchApiClient.DayRecapPdfUrl(_day, TimeZoneInfo.Local.Id)" download="PoWatch-@(DayKey).pdf" data-test="history-recap-pdf">Recap PDF ↓</a>
                        </p>
                    </div>
                }

                @if (_motion.Count > 0)
                {
                <h3 class="history-sub">Motion</h3>
                <RadzenChart class="history-chart" aria-label="Motion across the day">
                    <RadzenAreaSeries Data="@_motion" CategoryProperty="@nameof(Point.At)" ValueProperty="@nameof(Point.Value)" Title="Motion" />
                    <RadzenCategoryAxis Formatter="@(v => v is DateTime t ? t.ToString("HH:mm", CultureInfo.CurrentCulture) : string.Empty)" />
                    <RadzenValueAxis Min="0" FormatString="{0:0.00}" />
                    <RadzenLegend Visible="false" />
                </RadzenChart>
                }

                <div data-test="history-sessions">
                    @if (_sessions.Count > 0)
                    {
                        <h3 class="history-sub">Sessions · @_sessions.Count</h3>
                        <table class="term-table">
                            <thead><tr><th>Session</th><th>From</th><th>To</th><th class="r">Length</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var s in _sessions)
                                {
                                    <tr>
                                        <td>@DisplayText.SessionTag(s.Id)</td>
                                        <td>@s.StartedUtc.ToLocalTime().ToString("HH:mm", CultureInfo.CurrentCulture)</td>
                                        <td>@(s.EndedUtc?.ToLocalTime().ToString("HH:mm", CultureInfo.CurrentCulture) ?? "running")</td>
                                        <td class="r">@DisplayText.Duration(s.DurationSeconds)</td>
                                        <td class="r"><a href="stats?session=@s.Id" title="Open this session on the Stats page">stats</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

                @if (_environment is { Words.Count: > 0 })
                {
                    <h3 class="history-sub">Captions · @_environment.CaptionCount</h3>
                    <div class="stats-cloud">
                        @foreach (var word in _environment.Words.Take(30))
                        {
                            <span style="font-size: @((11 + (16.0 * word.Count / _environment.Words[0].Count)).ToString("0", CultureInfo.InvariantCulture))px">@word.Word</span>
                        }
                    </div>
                    @if (_environment.WeirdestCaption is { } weird)
                    {
                        <p class="stats-weird"><b>WEIRDEST</b> “@weird”</p>
                    }
                }
            </RadzenTabsItem>

            <RadzenTabsItem Text="@($"Moments · {_moments.Count}")">
                <div data-test="history-moments">
                    @if (_moments.Count == 0)
                    {
                        <p class="term-empty">No highlights kept on this day.</p>
                    }
                    else
                    {
                        <ol class="away-moments">
                            @foreach (var moment in _moments.Take(9))
                            {
                                <li>
                                    @if (moment.ImageUrl is { } url)
                                    {
                                        <img src="@url" alt="Snapshot: @moment.Text" loading="lazy" />
                                    }
                                    <span class="num">@moment.AtUtc.ToLocalTime().ToString("HH:mm:ss", CultureInfo.CurrentCulture)</span>
                                    <span>@moment.Text</span>
                                </li>
                            }
                        </ol>
                    }
                </div>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Time-lapse">
                <div data-test="history-timelapse">
                    <p class="term-stat-hint">@_frames FRAMES · THIS DEVICE</p>
                    @if (_frames == 0)
                    {
                        <p class="term-empty">No time-lapse for this day on this device. While a camera session runs, one frame a minute is saved in this browser only, for 7 days.</p>
                    }
                    else
                    {
                        <canvas @ref="_timelapse" class="timelapse-canvas" aria-label="Time-lapse of the day"></canvas>
                        <div class="timelapse-actions">
                            <button class="term-button" @onclick="PlayTimelapseAsync" disabled="@_playing" data-test="timelapse-play">@(_playing ? "Playing…" : "▶ Play")</button>
                            @if (_videoUrl is { } url)
                            {
                                <a class="term-button" href="@url" download="powatch-@(DayKey).webm" data-test="timelapse-save">Save video</a>
                            }
                            <span class="term-stat-hint">@DisplayText.Duration((double)_frames / TimelapseFps) at @TimelapseFps fps</span>
                        </div>
                    }
                </div>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</div>

@code {
    public sealed record Point(DateTime At, double Value);

    private const string DayFormat = "yyyy-MM-dd";

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    /// <summary>The Sunday the 53-week calendar starts on; cell index = weekday × 53 + week.</summary>
    private static DateOnly CalendarStart => Today.AddDays(-(52 * 7) - (int)Today.DayOfWeek);

    private DateOnly _day = Today;
    private DateOnly? _shown;
    private int _tab;
    private bool _loaded;
    private bool _rewriting;
    private PresenceStatsDto? _presence;
    private RecapDto? _recap;
    private EnvironmentStatsDto? _environment;
    private PatternStatsDto? _patterns;
    private List<Point> _motion = [];
    private IReadOnlyList<SessionDto> _sessions = [];
    private List<MomentDto> _moments = [];
    private List<double> _calendarCells = [];

    private const int TimelapseFps = 24;
    private ElementReference _timelapse;
    private int _frames;
    private bool _playing;
    private string? _videoUrl;

    /// <summary>The day in the address, yyyy-MM-dd; today when absent, unreadable or in the future.</summary>
    [Parameter] public string? Day { get; set; }

    private string DayKey => _day.ToString(DayFormat, CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        _patterns = await Api.GetPatternsAsync(StatsQuery.For("today"));
        BuildCalendar();
    }

    protected override async Task OnParametersSetAsync()
    {
        _day = DateOnly.TryParseExact(Day, DayFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out var day) && day <= Today ? day : Today;
        if (_day == _shown) return;
        _shown = _day;
        await LoadDayAsync();
    }

    private void Move(int days) => Go(_day.AddDays(days) > Today ? Today : _day.AddDays(days));

    private void Go(DateOnly day) =>
        Navigation.NavigateTo(day == Today ? "history" : $"history/{day.ToString(DayFormat, CultureInfo.InvariantCulture)}");

    private static DateOnly? DayFor(int index)
    {
        var day = CalendarStart.AddDays(((index % 53) * 7) + (index / 53));
        return day > Today ? null : day;
    }

    private static int CellFor(DateOnly day)
    {
        var offset = day.DayNumber - CalendarStart.DayNumber;
        return offset < 0 || offset >= 53 * 7 ? -1 : ((int)day.DayOfWeek * 53) + (offset / 7);
    }

    private async Task LoadDayAsync()
    {
        var day = _day;
        _loaded = false;
        var start = new DateTimeOffset(day.ToDateTime(TimeOnly.MinValue));
        var query = StatsQuery.ForDay(day);
        var presence = Api.GetPresenceAsync(query);
        var environment = Api.GetEnvironmentAsync(query);
        var sessions = Api.ListSessionsBetweenAsync(start, start.AddDays(1));
        // The template recap answers at once; a model's rewording replaces it when (if) it arrives.
        var recap = Api.GetDayRecapAsync(day, TimeZoneInfo.Local.Id, ai: false);
        await Task.WhenAll(presence, environment, sessions, recap);
        if (day != _day) return; // A newer ◀/▶ press owns the panels now.

        (_presence, _environment, _recap, _sessions) = (presence.Result, environment.Result, recap.Result, sessions.Result);
        _motion = _presence?.Series.Select(p => new Point(p.AtUtc.LocalDateTime, p.Motion)).ToList() ?? [];
        _moments = [];
        _videoUrl = null;
        _loaded = true;
        StateHasChanged();

        var rewrite = RewordRecapAsync(day);
        _frames = await JS.TryInvokeAsync<int>("powatchTimelapse.count", DayKey);
        var moments = await Task.WhenAll(_sessions.Select(s => Api.GetMomentsAsync(s.Id)));
        if (day == _day)
        {
            _moments = moments.SelectMany(m => m)
                .Where(m => DateOnly.FromDateTime(m.AtUtc.LocalDateTime) == day)
                .OrderByDescending(m => m.Score)
                .ToList();
            StateHasChanged();
        }

        await rewrite;
    }

    /// <summary>
    /// Asks the server's model for its version of the day's recap; where the server has none, the
    /// browser's built-in model gets the same prompt. Either answer must keep to the template's numbers.
    /// </summary>
    private async Task RewordRecapAsync(DateOnly day)
    {
        if (_recap is not { } template || _presence is not { SecondsObserved: > 0 }) return;
        _rewriting = true;
        StateHasChanged();

        var reworded = await Api.GetDayRecapAsync(day, TimeZoneInfo.Local.Id, ai: true);
        if (reworded is null || reworded.Source == template.Source)
        {
            var prompt = RecapPrompt.User(template);
            var text = await JS.TryInvokeAsync<string>("powatchLocalAi.rewrite", RecapPrompt.System + " Reply with the summary paragraph only.", prompt);
            reworded = !string.IsNullOrWhiteSpace(text) && RecapPrompt.KeepsToFacts(text, prompt)
                ? RecapPrompt.Rewritten(template, text, "this browser's model")
                : null;
        }

        _rewriting = false;
        if (day == _day && reworded is not null) _recap = reworded;
        StateHasChanged();
    }

    /// <summary>Plays the day's frames (stored only in this browser) and offers the recording as a download.</summary>
    private async Task PlayTimelapseAsync()
    {
        _playing = true;
        _videoUrl = await JS.TryInvokeAsync<string>("powatchTimelapse.play", _timelapse, DayKey, TimelapseFps);
        _playing = false;
    }

    private void BuildCalendar()
    {
        var cells = new double[53 * 7];
        foreach (var day in _patterns?.Calendar ?? [])
        {
            if (CellFor(day.Date) is var index and >= 0) cells[index] = Math.Max(day.Occupancy, 0.0001);
        }
        _calendarCells = [.. cells];
    }
}
