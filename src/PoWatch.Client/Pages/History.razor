@page "/history"
@page "/history/{Day}"
@using System.Globalization
@using PoWatch.Shared.Services.Recaps
@inject PoWatchApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject UiPrefs Prefs
@implements IDisposable

<PageTitle>PoWatch | History</PageTitle>

@* Master-detail in one viewport: on the left the year, the chosen day's numbers beside its week, and
   its sessions; on the right two tabs: the recap with its motion and captions, and the replay with the
   day's moments and time-lapse under it. On a desktop each column scrolls on its own, never the page. The day is in the address
   (/history/2026-10-03), so it survives a reload and Back/Forward walk the days you looked at. ◀ ▶ and
   the arrow keys step a day (menus.js); the calendar button jumps to any day. *@
<div class="history-grid">
    <div class="history-col">
        <TerminalPanel Title="The year" Test="history-calendar">
            <Aside>
                @(_patterns?.Calendar.Count ?? 0) DAYS · CLICK ONE TO OPEN IT
                @if (Prefs.Advanced)
                {
                    <span class="history-view" role="group" aria-label="Year view">
                        <button class="term-button @(_year3d ? null : "term-button--on")" aria-pressed="@(_year3d ? "false" : "true")" @onclick="() => SetYearViewAsync(false)" data-test="year-2d">2D</button>
                        <button class="term-button @(_year3d ? "term-button--on" : null)" aria-pressed="@(_year3d ? "true" : "false")" @onclick="() => SetYearViewAsync(true)" data-test="year-3d">3D</button>
                    </span>
                }
            </Aside>
            <ChildContent>
                @if (_year3d && Prefs.Advanced)
                {
                    <YearSkyline Values="@_skyValues" Wet="@_skyWet" Labels="@_skyLabels" Selected="@CellFor(_day)" OnPick="@(i => { if (DayFor(i) is { } d) Go(d); })" />
                }
                else
                {
                    <HeatGrid Values="@_calendarCells" Columns="53" Rows="7" Label="Daily occupancy over the last year"
                              Selected="@CellFor(_day)" OnCellClick="@(i => { if (DayFor(i) is { } d) Go(d); })"
                              CellTitle="@((i, v) => CellLabel(i, v))" />
                }
                @if (_weather?.Insight is { } insight)
                {
                    <p class="history-insight" data-test="weather-insight">@insight.Sentence</p>
                }
            </ChildContent>
        </TerminalPanel>

        <TerminalPanel Title="The day" Class="history-day-panel" Test="history-day-stats">
            <Aside>
                <span class="history-nav" data-test="history-toolbar">
                    <button class="term-button" @onclick="() => Move(-1)" aria-label="Previous day" title="Previous day (←)" data-test="history-prev">◀</button>
                    <span class="history-day" data-test="history-day">@_day.ToString("ddd d MMM yyyy", CultureInfo.CurrentCulture)</span>
                    <RadzenDatePicker TValue="DateOnly" Value="@_day" ValueChanged="@((DateOnly d) => Go(d))" ShowInput="false"
                                      Max="@Today.ToDateTime(TimeOnly.MinValue)" class="history-pick" aria-label="Pick a day" title="Pick a day" />
                    <button class="term-button" @onclick="() => Move(1)" disabled="@(_day >= Today)" aria-label="Next day" title="Next day (→)" data-test="history-next">▶</button>
                    <button class="term-button" @onclick="() => Go(Today)" disabled="@(_day == Today)" aria-label="Go to today">Today</button>
                </span>
            </Aside>
            <ChildContent>
                @if (!_loaded)
                {
                    <Skeleton Heights="@([0])" Span="term-span-4 history-skel-day" />
                }
                else if (_presence is null || _presence.SecondsObserved == 0)
                {
                    <p class="term-empty" data-test="history-empty">Nothing was observed on this day.</p>
                }
                else
                {
                    <div class="history-numbers">
                        <Dial Value="@_presence.Occupancy" Label="occupied" />
                        <div class="term-stats">
                            <StatCell Label="Occupancy" Value="@_presence.Occupancy.ToString("0.0%", CultureInfo.InvariantCulture)" Test="history-occupancy" />
                            <StatCell Label="Observed" Value="@DisplayText.Duration(_presence.SecondsObserved)" />
                            <StatCell Label="Visits" Value="@_presence.Visits.ToString(CultureInfo.InvariantCulture)" />
                            <StatCell Label="Peak at once" Value="@_presence.PeakConcurrency.ToString(CultureInfo.InvariantCulture)" />
                            <StatCell Label="Busiest" Value="@(_presence.BusiestStartUtc?.ToLocalTime().ToString("HH:mm", CultureInfo.CurrentCulture) ?? "—")" />
                            <StatCell Label="Longest empty" Value="@DisplayText.Duration(_presence.LongestEmptySeconds)" />
                        </div>
                    </div>
                }
                @if (WeatherOn(_day) is { } weather)
                {
                    <p class="history-weather" data-test="history-weather" title="Weather at @_weather!.Place?.Name">@DisplayText.Weather(weather)</p>
                }

                @* The day's week against the week before: one row of numbers and the sentence. *@
                <div class="history-week" data-test="history-week">
                    <h3 class="history-sub">
                        The week · @WeekStart(_day).ToString("d MMM", CultureInfo.CurrentCulture) – @WeekStart(_day).AddDays(6).ToString("d MMM", CultureInfo.CurrentCulture) vs the week before
                    </h3>
                    @if (_week is null)
                    {
                        <Skeleton Heights="@([0])" Span="term-span-4 history-skel-week" />
                    }
                    else
                    {
                        <div class="term-stats history-week-stats">
                            <StatCell Label="Occupancy" Value="@_week.ThisWeek.Occupancy.ToString("0%", CultureInfo.InvariantCulture)" Hint="@Change(_week.ThisWeek.Occupancy, _week.LastWeek.Occupancy)" Test="week-occupancy" />
                            <StatCell Label="Observed" Value="@DisplayText.Duration(_week.ThisWeek.SecondsObserved)" Hint="@($"was {DisplayText.Duration(_week.LastWeek.SecondsObserved)}")" />
                            <StatCell Label="Visits" Value="@_week.ThisWeek.Visits.ToString(CultureInfo.InvariantCulture)" Hint="@($"was {_week.LastWeek.Visits}")" />
                            <StatCell Label="Busiest day" Value="@(_week.ThisWeek.BusiestDay?.ToString("ddd", CultureInfo.CurrentCulture) ?? "—")"
                                      Hint="@(_week.ThisWeek.BusiestDay is null ? null : _week.ThisWeek.BusiestOccupancy.ToString("0% occupied", CultureInfo.InvariantCulture))" />
                        </div>
                        @if (_week.Headline is { } headline)
                        {
                            <p class="history-week-headline" data-test="week-headline" title="Written by the server's AI model from the numbers below">✦ @headline</p>
                        }
                        <p class="history-week-summary" data-test="week-summary">@_week.Summary</p>
                    }
                </div>
            </ChildContent>
        </TerminalPanel>

        <TerminalPanel Title="Sessions" Class="history-sessions" Test="history-sessions" Flush="true">
            <Aside>@_sessions.Count ON THIS DAY</Aside>
            <ChildContent>
                @if (_sessions.Count == 0)
                {
                    <p class="term-empty">@(_loaded ? "No sessions on this day." : "Loading…")</p>
                }
                else
                {
                    <table class="term-table">
                        <thead><tr><th>Session</th><th>From</th><th>To</th><th class="r">Length</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var s in _sessions)
                            {
                                <tr>
                                    <td>@SessionDto.Tag(s.Id)</td>
                                    <td>@s.StartedUtc.ToLocalTime().ToString("HH:mm", CultureInfo.CurrentCulture)</td>
                                    <td>@(s.EndedUtc?.ToLocalTime().ToString("HH:mm", CultureInfo.CurrentCulture) ?? "running")</td>
                                    <td class="r">@DisplayText.Duration(s.DurationSeconds)</td>
                                    <td class="r"><a class="term-link" href="?session=@s.Id" title="Open this session's stats on Live">stats →</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </ChildContent>
        </TerminalPanel>
    </div>

    <RadzenTabs @bind-SelectedIndex="_tab" RenderMode="TabRenderMode.Server" class="history-tabs" data-test="history-tabs">
        <Tabs>
            <RadzenTabsItem Text="Recap">
                <DayRecap Day="@_day" Recap="@_recap" Presence="@_presence" Captions="@_environment" Loaded="@_loaded" Rewriting="@_rewriting" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Replay">
                <DayReplay Day="@_day" StartAt="@_replayAt" />
                <DayMoments Day="@_day" Sessions="@_sessions" />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</div>

@code {
    private const string DayFormat = "yyyy-MM-dd";

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    /// <summary>The Sunday the 53-week calendar starts on; cell index = weekday × 53 + week.</summary>
    private static DateOnly CalendarStart => Today.AddDays(-(52 * 7) - (int)Today.DayOfWeek);

    private DateOnly _day = Today;
    private DateOnly? _shown;
    private int _tab;
    private const string YearViewKey = "powatch:year-view";
    private bool _year3d;
    private IReadOnlyList<double> _skyValues = [];
    private IReadOnlyList<bool> _skyWet = [];
    private IReadOnlyList<string> _skyLabels = [];
    private bool _loaded;
    private bool _rewriting;
    private PresenceStatsDto? _presence;
    private RecapDto? _recap;
    private EnvironmentStatsDto? _environment;
    private PatternStatsDto? _patterns;
    private IReadOnlyList<SessionDto> _sessions = [];
    private List<double> _calendarCells = [];
    private WeatherYearDto? _weather;
    private Dictionary<DateOnly, WeatherDayDto> _weatherByDay = [];
    private WeekDigestDto? _week;
    private DateOnly? _weekShown;

    /// <summary>The day in the address, yyyy-MM-dd; today when absent, unreadable or in the future.</summary>
    [Parameter] public string? Day { get; set; }

    /// <summary>?tab=replay&amp;at={unix ms}: a caption search result, opened on its minute in the replay.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    [SupplyParameterFromQuery(Name = "at")] public long? At { get; set; }

    private long? _replayAt;
    private (string?, long?) _appliedQuery;

    protected override async Task OnInitializedAsync()
    {
        Prefs.Changed += OnPrefsChanged;
        var weather = Api.GetWeatherYearAsync();
        _patterns = await Api.GetPatternsAsync(StatsQuery.For("today"));
        BuildCalendar();
        _weather = await weather;
        _weatherByDay = _weather?.Days.ToDictionary(d => d.Date) ?? [];
        BuildSkyline();
        _year3d = await JS.TryInvokeAsync<string>("localStorage.getItem", YearViewKey) == "3d";
    }

    private WeatherDayDto? WeatherOn(DateOnly day) => _weatherByDay.GetValueOrDefault(day);

    private static DateOnly WeekStart(DateOnly day) => day.AddDays(-(((int)day.DayOfWeek + 6) % 7));

    /// <summary>"+6 pts on the week before", or "no week before" when there is nothing to compare with.</summary>
    private string Change(double now, double before)
    {
        if (_week is not { LastWeek.SecondsObserved: > 0 }) return "no week before";
        var points = Math.Round((now - before) * 100);
        return points == 0 ? "same as the week before" : $"{(points > 0 ? "+" : "−")}{Math.Abs(points)} pts on the week before";
    }

    private void OnPrefsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Prefs.Changed -= OnPrefsChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (Day is null)
        {
            _day = Today;
        }
        else if (!DateOnly.TryParseExact(Day, DayFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out var day) || day > Today)
        {
            Navigation.NavigateTo("history", replace: true);
            return;
        }
        else
        {
            _day = day;
        }
        // Once per distinct link, so choosing another tab afterwards is not undone by a re-render.
        if (Tab == "replay" && (Tab, At) != _appliedQuery) (_tab, _replayAt, _appliedQuery) = (1, At, (Tab, At));
        if (_day == _shown) return;
        _shown = _day;
        await LoadDayAsync();
    }

    private void Move(int days) => Go(_day.AddDays(days) > Today ? Today : _day.AddDays(days));

    private void Go(DateOnly day) =>
        Navigation.NavigateTo(day == Today ? "history" : $"history/{day.ToString(DayFormat, CultureInfo.InvariantCulture)}");

    private static DateOnly? DayFor(int index)
    {
        var day = CalendarStart.AddDays(((index % 53) * 7) + (index / 53));
        return day > Today ? null : day;
    }

    private static int CellFor(DateOnly day)
    {
        var offset = day.DayNumber - CalendarStart.DayNumber;
        return offset < 0 || offset >= 53 * 7 ? -1 : ((int)day.DayOfWeek * 53) + (offset / 7);
    }

    private async Task LoadDayAsync()
    {
        var day = _day;
        _loaded = false;
        if (_weekShown != WeekStart(day)) (_week, _weekShown) = (null, WeekStart(day));
        var week = _week is null ? Api.GetWeekDigestAsync(day) : Task.FromResult<WeekDigestDto?>(_week);
        var start = new DateTimeOffset(day.ToDateTime(TimeOnly.MinValue));
        var query = StatsQuery.ForDay(day);
        var presence = Api.GetPresenceAsync(query);
        var environment = Api.GetEnvironmentAsync(query);
        var sessions = Api.ListSessionsBetweenAsync(start, start.AddDays(1));
        // The template recap answers at once; a model's rewording replaces it when (if) it arrives.
        var recap = Api.GetDayRecapAsync(day, TimeZoneInfo.Local.Id, ai: false);
        await Task.WhenAll(presence, environment, sessions, recap, week);
        if (day != _day) return; // A newer ◀/▶ press owns the panels now.

        (_presence, _environment, _recap, _sessions, _week) = (presence.Result, environment.Result, recap.Result, sessions.Result, week.Result);
        _loaded = true;
        StateHasChanged();

        await RewordRecapAsync(day);
    }

    /// <summary>
    /// Asks the server's model for its version of the day's recap; where the server has none, the
    /// browser's built-in model gets the same prompt. Either answer must keep to the template's numbers.
    /// </summary>
    private async Task RewordRecapAsync(DateOnly day)
    {
        if (_recap is not { } template || _presence is not { SecondsObserved: > 0 }) return;
        _rewriting = true;
        StateHasChanged();

        var reworded = await Api.GetDayRecapAsync(day, TimeZoneInfo.Local.Id, ai: true);
        if (reworded is null || reworded.Source == template.Source)
        {
            var prompt = RecapPrompt.User(template);
            var text = await JS.TryInvokeAsync<string>("powatchLocalAi.rewrite", RecapPrompt.System + " Reply with the summary paragraph only.", prompt);
            reworded = !string.IsNullOrWhiteSpace(text) && RecapPrompt.KeepsToFacts(text, prompt)
                ? RecapPrompt.Rewritten(template, text, "this browser's model")
                : null;
        }

        _rewriting = false;
        if (day == _day && reworded is not null) _recap = reworded;
        StateHasChanged();
    }

    private string CellLabel(int index, double value) => DayFor(index) is { } d
        ? $"{d:ddd dd MMM} · {(value > 0 ? value.ToString("P0", CultureInfo.CurrentCulture) : "no data")}{(WeatherOn(d) is { } w ? $" · {w.Summary}" : string.Empty)}"
        : string.Empty;

    /// <summary>The calendar as the skyline wants it: −1 marks days still to come, so they get no tower.</summary>
    private void BuildSkyline()
    {
        var cells = Enumerable.Range(0, _calendarCells.Count).ToList();
        _skyValues = cells.Select(i => DayFor(i) is null ? -1 : _calendarCells[i]).ToList();
        _skyWet = cells.Select(i => DayFor(i) is { } d && WeatherOn(d) is { Wet: true }).ToList();
        _skyLabels = cells.Select(i => CellLabel(i, _calendarCells[i])).ToList();
    }

    private async Task SetYearViewAsync(bool threeD)
    {
        _year3d = threeD;
        await JS.TryInvokeVoidAsync("localStorage.setItem", YearViewKey, threeD ? "3d" : "2d");
    }

    private void BuildCalendar()
    {
        var cells = new double[53 * 7];
        foreach (var day in _patterns?.Calendar ?? [])
        {
            if (CellFor(day.Date) is var index and >= 0) cells[index] = Math.Max(day.Occupancy, 0.0001);
        }
        _calendarCells = [.. cells];
    }
}
