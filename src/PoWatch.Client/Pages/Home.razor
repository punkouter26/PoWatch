@page "/home"
@inject NavigationManager Nav

<PageTitle>PoWatch</PageTitle>

<div class="cp-home">
    <div class="cp-home-hero">
        <div class="cp-hero-tag">// LOCAL ROOM MONITOR v1.0</div>
        <h1 class="cp-hero-title">
            <span class="po-green">PO</span><span class="po-purple">WATCH</span>
        </h1>
        <p class="cp-hero-sub">Privacy-First · Local Intelligence · Indefinite Retention</p>
        <p class="cp-hero-desc">
            Turn a webcam feed into local observations.
            Inference stays on-device via WebGPU.
        </p>
        <div class="cp-hero-actions">
            <button class="btn btn-primary btn-lg" @onclick='@(() => Nav.NavigateTo("/"))'>
                ▶ START MONITORING
            </button>
            <button class="btn btn-outline-secondary btn-lg" @onclick='@(() => Nav.NavigateTo("/archives"))'>
                ◉ VIEW ARCHIVES
            </button>
        </div>
    </div>

    <div class="cp-sectors-grid sector-grid">
        <div class="sector-card" @onclick='@(() => Nav.NavigateTo("/"))'>
            <div class="sector-num">01</div>
            <div class="sector-title">MONITOR</div>
            <div class="sector-desc">
                Live webcam feed, observation stream, and current status.
            </div>
            <div class="sector-tags">
                <span class="tag">WebGPU</span>
                <span class="tag">Gemma 4</span>
                <span class="tag">TTS</span>
            </div>
        </div>

        <div class="sector-card" @onclick='@(() => Nav.NavigateTo("/archives"))'>
            <div class="sector-num">02</div>
            <div class="sector-title">ARCHIVES</div>
            <div class="sector-desc">
                Review timeline and significant events by day.
            </div>
            <div class="sector-tags">
                <span class="tag">Chapters</span>
                <span class="tag">Timeline</span>
                <span class="tag">Evidence</span>
            </div>
        </div>

        <div class="sector-card" @onclick='@(() => Nav.NavigateTo("/identity"))'>
            <div class="sector-num">03</div>
            <div class="sector-title">SUBJECTS</div>
            <div class="sector-desc">
                Manage subject names and optional history merge.
            </div>
            <div class="sector-tags">
                <span class="tag">Subjects</span>
                <span class="tag">Merge</span>
                <span class="tag">History</span>
            </div>
        </div>

        <div class="sector-card" @onclick='@(() => Nav.NavigateTo("/diagnostics"))'>
            <div class="sector-num">04</div>
            <div class="sector-title">SYSTEM</div>
            <div class="sector-desc">
                Check runtime health and external connectivity.
            </div>
            <div class="sector-tags">
                <span class="tag">Health</span>
                <span class="tag">Telemetry</span>
                <span class="tag">Azure</span>
            </div>
        </div>
    </div>

    <div class="home-footer">
        <span class="text-muted">// All inference local. Zero cloud compute.</span>
    </div>
</div>
