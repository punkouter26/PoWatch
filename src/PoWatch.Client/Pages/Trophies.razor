@page "/trophies"
@using System.Globalization
@implements IDisposable
@inject PoWatchApiClient Api
@inject StatsFeed Feed

<PageTitle>PoWatch | Trophies</PageTitle>

@* One panel: personal records as a strip, then what you have unlocked, then (dimmed, foldable) what is still locked. *@
<TerminalPanel Number="E1" Title="Trophy cabinet" Test="trophy-cabinet">
    <Aside>@Unlocked.Count / @(_cabinet?.Achievements.Count ?? 0) UNLOCKED</Aside>
    <ChildContent>
        @if (_cabinet is null)
        {
            <p class="term-empty">Loading…</p>
        }
        else
        {
            <div class="term-stats trophy-records" data-test="trophy-records">
                @if (_cabinet.Records.Count == 0)
                {
                    <p class="term-empty">No records yet. Run a session and they start counting.</p>
                }
                @foreach (var r in _cabinet.Records)
                {
                    <StatCell Label="@r.Title" Value="@r.Display" Hint="@r.SetAtUtc.ToLocalTime().ToString("dd MMM HH:mm", CultureInfo.CurrentCulture)" Test="record-row" />
                }
            </div>

            @if (Unlocked.Count > 0)
            {
                <ul class="trophy-grid">
                    @foreach (var a in Unlocked)
                    {
                        <li class="trophy trophy--unlocked" data-test="trophy" data-unlocked="true">
                            <span class="trophy-mark" aria-hidden="true">▲</span>
                            <b>@a.Title</b>
                            <span>@a.Description</span>
                            <span class="trophy-when">@a.UnlockedAtUtc?.ToLocalTime().ToString("dd MMM yyyy · HH:mm", CultureInfo.CurrentCulture)</span>
                        </li>
                    }
                </ul>
            }

            @if (Locked.Count > 0)
            {
                <details class="trophy-locked" open>
                    <summary>@Locked.Count still locked</summary>
                    <ul class="trophy-grid trophy-grid--locked">
                        @foreach (var a in Locked)
                        {
                            <li class="trophy trophy--locked" data-test="trophy" data-unlocked="false">
                                <b>△ @a.Title</b>
                                <span>@a.Description</span>
                            </li>
                        }
                    </ul>
                </details>
            }
        }
    </ChildContent>
</TerminalPanel>

@code {
    private TrophyCabinetDto? _cabinet;

    private List<AchievementDto> Unlocked => _cabinet?.Achievements.Where(a => a.Unlocked).OrderByDescending(a => a.UnlockedAtUtc).ToList() ?? [];

    private List<AchievementDto> Locked => _cabinet?.Achievements.Where(a => !a.Unlocked).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        Feed.Unlocked += OnUnlocked;
        await LoadAsync();
    }

    private async Task LoadAsync() => _cabinet = await Api.GetTrophiesAsync() ?? new TrophyCabinetDto();

    private void OnUnlocked(AchievementsUnlockedDto unlocked) => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Feed.Unlocked -= OnUnlocked;
}
