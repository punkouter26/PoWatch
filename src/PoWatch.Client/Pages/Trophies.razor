@page "/trophies"
@using System.Globalization
@implements IDisposable
@inject PoWatchApiClient Api
@inject StatsFeed Feed

<PageTitle>PoWatch | Trophies</PageTitle>

<div class="term-grid">
    <TerminalPanel Number="E1" Title="Trophy cabinet" Class="term-span-4" Test="trophy-cabinet">
        <Aside>@Unlocked / @(_cabinet?.Achievements.Count ?? 0) UNLOCKED</Aside>
        <ChildContent>
            @if (_cabinet is null)
            {
                <p class="term-empty">Loading…</p>
            }
            else
            {
                <ul class="trophy-grid">
                    @foreach (var a in _cabinet.Achievements)
                    {
                        <li class="trophy @(a.Unlocked ? "trophy--unlocked" : "trophy--locked")" data-test="trophy" data-unlocked="@(a.Unlocked ? "true" : "false")">
                            <span class="trophy-mark" aria-hidden="true">@(a.Unlocked ? "▲" : "△")</span>
                            <b>@a.Title</b>
                            <span>@a.Description</span>
                            <span class="trophy-when">@(a.UnlockedAtUtc is { } at ? at.ToLocalTime().ToString("dd MMM yyyy · HH:mm", CultureInfo.CurrentCulture) : "LOCKED")</span>
                        </li>
                    }
                </ul>
            }
        </ChildContent>
    </TerminalPanel>

    <TerminalPanel Number="E2" Title="Personal records" Class="term-span-2" Test="trophy-records" Flush="true">
        @if (_cabinet is null || _cabinet.Records.Count == 0)
        {
            <p class="term-empty" style="padding: 10px;">No records yet. Run a session and they start counting.</p>
        }
        else
        {
            <table class="term-table">
                <thead><tr><th>Record</th><th class="r">Best</th><th>Set</th></tr></thead>
                <tbody>
                    @foreach (var r in _cabinet.Records)
                    {
                        <tr data-test="record-row">
                            <td>@r.Title</td>
                            <td class="r">@r.Display</td>
                            <td>@r.SetAtUtc.ToLocalTime().ToString("dd MMM HH:mm", CultureInfo.CurrentCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </TerminalPanel>
</div>

@code {
    private TrophyCabinetDto? _cabinet;

    private int Unlocked => _cabinet?.Achievements.Count(a => a.Unlocked) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        Feed.Unlocked += OnUnlocked;
        await LoadAsync();
    }

    private async Task LoadAsync() => _cabinet = await Api.GetTrophiesAsync() ?? new TrophyCabinetDto();

    private void OnUnlocked(AchievementsUnlockedDto unlocked) => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Feed.Unlocked -= OnUnlocked;
}
