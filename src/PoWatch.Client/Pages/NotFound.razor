@page "/not-found"
@layout MainLayout
@inject NavigationManager Navigation

<PageTitle>PoWatch | Page not found</PageTitle>

@* The key bar above already lists every section, so this only says what went wrong and offers Live. *@
<TerminalPanel Title="Page not found" Test="not-found">
    <p>That address isn't part of PoWatch@(RequestedPath is null ? "." : ":") @if (RequestedPath is not null) { <code>@RequestedPath</code> }</p>
    <p><a class="term-button term-button--primary" href="">Back to Live</a> <span class="term-stat-hint">or pick a section from the key bar above.</span></p>
</TerminalPanel>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "path")]
    public string? RequestedPath { get; set; }

    protected override void OnInitialized()
    {
        // The Router's NotFoundPage doesn't pass the URL; read it from the current navigation.
        if (!string.IsNullOrWhiteSpace(RequestedPath) || !Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out var uri)) return;
        RequestedPath = uri.PathAndQuery == "/" ? null : uri.PathAndQuery;
    }
}
