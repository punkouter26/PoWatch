@page "/login"
@layout PoWatch.Client.Layout.MainLayout
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Sign in · PoWatch</PageTitle>

<div class="login-shell" data-test="login-shell">
    <div class="login-card" data-test="login-card">
        <h1>Sign in to PoWatch</h1>

        @if (_error is not null)
        {
            @* An unguarded fetch used to leave this page on "Loading sign-in options…" forever when
               /auth/config was unreachable — the one screen where a dead end locks the user out. *@
            <p class="login-status" role="alert" data-test="login-error">@_error</p>
            <button class="login-btn login-btn-guest" type="button" @onclick="LoadConfigAsync" data-test="login-retry">
                <span aria-hidden="true" class="login-btn-icon">↻</span>
                <span class="login-btn-text">Try again</span>
            </button>
        }
        else if (_config is null)
        {
            <p class="login-status" role="status" aria-live="polite" data-test="login-loading">Loading sign-in options…</p>
        }
        else
        {
            @if (_config.MicrosoftEnabled)
            {
                <a class="login-btn login-btn-ms" href="@LoginUrl("auth/login/microsoft")" data-test="login-microsoft">
                    <span aria-hidden="true" class="login-btn-icon">⊞</span>
                    <span class="login-btn-text">Sign in with Microsoft</span>
                </a>
                <p class="login-btn-hint">Microsoft Entra SSO — for production caregivers with a tenant identity.</p>
            }
            @if (_config.GuestEnabled)
            {
                <a class="login-btn login-btn-guest" href="@LoginUrl("auth/login/fake")" data-test="login-guest">
                    <span aria-hidden="true" class="login-btn-icon">⌂</span>
                    <span class="login-btn-text">Continue as Guest</span>
                </a>
                <p class="login-btn-hint login-btn-hint--muted">Local demo only — no real data, no Microsoft tenant required. Disabled in production.</p>
            }
            @if (!_config.MicrosoftEnabled && !_config.GuestEnabled)
            {
                <p class="login-status" role="alert">No sign-in method is configured for the <b>@_config.Environment</b> environment.</p>
            }
        }
    </div>
</div>

@code {
    private PoWatch.Shared.Models.AuthConfigDto? _config;
    private string? _error;
    private string _returnUrl = "/";

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        foreach (var pair in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            if (kv.Length == 2 && kv[0] == "returnUrl" && !string.IsNullOrWhiteSpace(kv[1]))
                _returnUrl = Uri.UnescapeDataString(kv[1]);
        }

        await LoadConfigAsync();
    }

    private async Task LoadConfigAsync()
    {
        _error = null;
        _config = null;
        StateHasChanged();

        try
        {
            _config = await Http.GetFromJsonAsync("auth/config", PoWatch.Client.Services.PoWatchJsonContext.Default.AuthConfigDto);
            if (_config is null)
                _error = "The server did not return any sign-in options. Try again in a moment.";
        }
        catch (Exception ex)
        {
            _error = $"Couldn't reach the sign-in service. {ex.Message}";
        }
    }

    private string LoginUrl(string endpoint) => $"{endpoint}?returnUrl={Uri.EscapeDataString(_returnUrl)}";
}
