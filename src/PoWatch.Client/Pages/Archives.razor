@page "/archives"
@attribute [Authorize]
@using PoWatch.Shared.Models
@using Microsoft.JSInterop
@using Microsoft.Extensions.Options
@using PoWatch.Client.Shared
@inject PoWatch.Client.Services.PoWatchApiClient ApiClient
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject IOptions<ClientFeatureFlagsOptions> ClientFlags
@inject DialogService DialogService
@inject NavigationManager Nav

<PageTitle>PoWatch | History</PageTitle>

<div class="sector-grid archives-grid" @onkeydown="HandlePageKeyDown" tabindex="-1" @ref="_pageRef">
    <RadzenCard class="panel panel-chapter">
        <header class="panel-header">
            <h1>History</h1>
            <p>Each day's story, in plain language, with the moments that mattered.</p>
        </header>

        <div class="archive-toolbar">
            <RadzenButton Icon="chevron_left" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                Click="PreviousDayAsync" Disabled="@loading" aria-label="Previous day" />
            <span class="kbd-hint" title="Arrow Left — previous day">←</span>
            <RadzenDatePicker @bind-Value="selectedDate" TValue="DateTime?" DateFormat="yyyy-MM-dd"
                Max="@DateTime.Today"
                Change="@(async _ => await LoadChapterAsync())" aria-label="Select date" />
            <span class="kbd-hint" title="Arrow Right — next day">→</span>
            <RadzenButton Icon="chevron_right" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                Click="NextDayAsync" Disabled="@(loading || selectedDate?.Date >= DateTime.Now.Date)" aria-label="Next day" />
            <RadzenButton Icon="today" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                Click="GoToTodayAsync" Disabled="@loading" aria-label="Go to today" title="Jump to today" />
            @if (loading)
            {
                <RadzenProgressBar ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" Class="archive-progress" />
            }
            <span class="archive-toolbar-divider"></span>
            <RadzenButton Icon="assignment" Text="Handoff" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                Click="OpenHandoffDialogAsync" Disabled="@(selectedDate is null)" aria-label="Generate handoff" />
        </div>

        <h3>Summary of the day</h3>
        @if (loading)
        {
            <div class="skeleton-block">
                <div class="skeleton-line skeleton-line--wide"></div>
                <div class="skeleton-line skeleton-line--medium"></div>
                <div class="skeleton-line skeleton-line--wide"></div>
                <div class="skeleton-line skeleton-line--short"></div>
                <div class="skeleton-line skeleton-line--medium"></div>
            </div>
        }
        else
        {
            <p class="narrative">@(chapter?.ClinicalNarrative ?? "Select a chapter to begin.")</p>
        }

        @if (handoffBrief is not null)
        {
            <div class="handoff-brief-panel">
                <div class="handoff-brief-header">
                    <h3>Handoff Brief</h3>
                    <span class="brief-badge @(handoffBrief.IsAiGenerated ? "brief-badge--ai" : "brief-badge--template")">
                        @(handoffBrief.IsAiGenerated ? "AI-assisted" : "Template")
                    </span>
                    <small class="brief-meta">@handoffBrief.Audience &middot; @handoffBrief.ShiftWindow &middot; @handoffBrief.GeneratedAtUtc.ToLocalTime().ToString("HH:mm")</small>
                    <button class="brief-close" @onclick="() => handoffBrief = null" aria-label="Close brief">&times;</button>
                </div>
                <p class="brief-summary">@handoffBrief.Summary</p>
                @if (handoffBrief.PriorityItems.Count > 0)
                {
                    <div class="brief-section">
                        <h4 class="brief-section-label">Priority Items</h4>
                        <ul class="brief-list brief-list--priority">
                            @foreach (var item in handoffBrief.PriorityItems)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    </div>
                }
                @if (handoffBrief.FollowUps.Count > 0)
                {
                    <div class="brief-section">
                        <h4 class="brief-section-label">Follow-ups for Next Shift</h4>
                        <ul class="brief-list brief-list--followup">
                            @foreach (var item in handoffBrief.FollowUps)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    </div>
                }
                <details class="brief-source-notes">
                    <summary>Source notes</summary>
                    <ul>
                        @foreach (var note in handoffBrief.SourceNotes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                </details>
            </div>
        }

        @if (chapter is not null && chapter.Timeline.Count == 0)
        {
            <div class="archive-empty">
                <p>No observations recorded for this day.</p>
                <a href="/" class="archive-empty-cta">→ Go to the Live Room to start watching</a>
            </div>
        }

        @if (chapter?.Highlights?.Any() == true)
        {
            @* Consolidation (NET_RUN_10 #2): only render cards whose image actually resolved.
               Events flagged significant but without a saved image no longer produce a wall of
               empty "No image" tiles — they collapse into a single compact count. *@
            var highlightsWithImages = chapter.Highlights
                .Where(h => !string.IsNullOrWhiteSpace(GetEvidenceUrl(h)))
                .ToList();
            var missingImageCount = chapter.Highlights.Count - highlightsWithImages.Count;

            <div class="evidence-header-row">
                <h3>Evidence Highlights</h3>
                @if (missingImageCount > 0)
                {
                    <span class="evidence-missing-note" title="@missingImageCount flagged event@(missingImageCount == 1 ? "" : "s") had no image saved to storage">
                        @missingImageCount flagged · no saved image
                    </span>
                }
            </div>

            @if (highlightsWithImages.Count > 0)
            {
            <div class="evidence-grid">
                @foreach (var item in highlightsWithImages)
                {
                    var evidenceUrl = GetEvidenceUrl(item);
                    var capturedItem = item;
                    var capturedUrl = evidenceUrl;
                    var imageStatus = GetImageLoadStatus(item);
                    <div class="evidence-card"
                         @onclick="@(async () => await OpenEvidenceLightboxAsync(capturedItem, capturedUrl))"
                         role="button" tabindex="0"
                         aria-label="View full image for @item.SubjectDisplayName — @item.Activity"
                         @onkeydown="@(async args => { if (args.Key == "Enter" || args.Key == " ") await OpenEvidenceLightboxAsync(capturedItem, capturedUrl); })">
                        <div class="evidence-image-wrap">
                            @if (!string.IsNullOrWhiteSpace(evidenceUrl))
                            {
                                <img class="evidence-full-img" src="@evidenceUrl" alt="Evidence for @item.SubjectDisplayName"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div class="evidence-full-img evidence-placeholder is-hidden">No image</div>
                            }
                            else
                            {
                                <div class="evidence-full-img evidence-placeholder">@(imageStatus ?? "No image")</div>
                            }
                            <div class="evidence-overlay">
                                <span class="evidence-subject">@item.SubjectDisplayName</span>
                                <span class="evidence-activity">@item.Activity</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(imageStatus) && imageStatus != "Loaded")
                            {
                                <div class="evidence-status-chip evidence-status-chip--@imageStatus.ToLower().Replace(" ", "-")">
                                    @imageStatus
                                </div>
                            }
                        </div>
                        <div class="evidence-caption">
                            <small>@(item.SignificantReason ?? "Significant event")</small>
                            <small class="evidence-time">@item.ObservedAtUtc.ToLocalTime().ToString("HH:mm")</small>
                        </div>
                    </div>
                }
            </div>
            }
        }
    </RadzenCard>

    <RadzenCard class="panel panel-timeline">
        <h2>Chronological Timeline</h2>
        @if (chapter?.Timeline is null or { Count: 0 })
        {
            <div class="activity-empty">No events recorded for this day.</div>
        }
        else
        {
            @* Virtualized (audit #3): a full day's timeline can be hundreds of events; only the visible
               rows are materialized so the archive scrolls without frame drops. *@
            <div class="activity-list activity-list--archives">
                <Virtualize Items="AsRows(chapter.Timeline)" Context="item" ItemSize="54" OverscanCount="6">
                    <div class="activity-item @(item.IsClinicalOutlier ? "activity-item--outlier" : item.IsSignificant ? "activity-item--significant" : string.Empty)">
                        <div class="activity-item-header">
                            <span class="activity-time">@item.ObservedAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                            <span class="activity-subject">@item.SubjectDisplayName</span>
                            @if (item.IsClinicalOutlier)
                            {
                                <span class="activity-badge activity-badge--outlier">⚠ Unusual</span>
                            }
                            else if (item.IsSignificant)
                            {
                                <span class="activity-badge activity-badge--significant">Notable</span>
                            }
                            <span class="activity-activity">@item.Activity</span>
                        </div>
                        @if ((item.IsClinicalOutlier || item.IsSignificant) && !string.IsNullOrWhiteSpace(item.SignificantReason))
                        {
                            <div class="activity-why">
                                <span class="activity-why-label">Why flagged</span>
                                <span class="activity-why-text">@item.SignificantReason</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.ClinicalDescription))
                        {
                            <div class="activity-note">@item.ClinicalDescription</div>
                        }
                    </div>
                </Virtualize>
            </div>
        }
    </RadzenCard>
</div>

@code {
    // Virtualize needs an ICollection; the DTO list is a List at runtime so this cast avoids a copy.
    // Mirrors ActivityTimeline's pattern rather than inlining the cast in markup.
    private static ICollection<ObservationEventDto> AsRows(IReadOnlyList<ObservationEventDto> timeline) =>
        timeline as ICollection<ObservationEventDto> ?? timeline.ToList();

    private sealed record ShiftOption(string Value, string Label);

    private static readonly IReadOnlyList<ShiftOption> shiftOptions =
    [
        new("FullDay", "Full Day"),
        new("Morning", "Morning (06–14)"),
        new("Afternoon", "Afternoon (14–22)"),
        new("Night", "Night (22–06)")
    ];

    // Use local time so the default chapter matches the clinician's calendar day.
    private DateTime? selectedDate;
    private string selectedShift = "FullDay";
    private DailyChapterDto? chapter;
    private bool loading;
    private readonly Dictionary<string, string> evidenceUrls = [];
    private readonly Dictionary<string, string> imageLoadStatus = []; // Track image loading state per blob path
    private HandoffBriefDto? handoffBrief;
    private bool generatingBrief;
    private string briefAudience = "NurseToNurse";
    private ElementReference _pageRef;

    // One-tap handoff entry (Win #5): "End shift" on the Live Room navigates here with ?handoff=1&shift=<auto>.
    [Parameter, SupplyParameterFromQuery(Name = "handoff")] public string? HandoffQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "shift")] public string? ShiftQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Always default to today — this is a monitoring app and users primarily want current data.
        // localStorage is only used to restore the date if it IS today (same-day session continuity).
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "powatch:archivesDate");
            if (!string.IsNullOrWhiteSpace(stored)
                && DateTime.TryParse(stored, out var restored)
                && restored.Date == DateTime.Today)
            {
                selectedDate = restored;
            }
            else
            {
                selectedDate = DateTime.Today;
            }
        }
        catch
        {
            // localStorage may be unavailable; default to today
            selectedDate = DateTime.Today;
        }

        // One-tap handoff: honour the auto-detected shift passed from the Live Room "End shift" button.
        if (!string.IsNullOrWhiteSpace(ShiftQuery) &&
            shiftOptions.Any(o => string.Equals(o.Value, ShiftQuery, StringComparison.OrdinalIgnoreCase)))
        {
            selectedShift = ShiftQuery;
        }

        await LoadChapterAsync();

        // Deep-link straight into the handoff flow so "End shift" is genuinely one tap end-to-end.
        if (!string.IsNullOrWhiteSpace(HandoffQuery))
        {
            await OpenHandoffDialogAsync();
        }
    }

    private async Task PreviousDayAsync()
    {
        selectedDate = (selectedDate ?? DateTime.Today).AddDays(-1);
        await LoadChapterAsync();
    }

    private async Task NextDayAsync()
    {
        if ((selectedDate ?? DateTime.Today).Date >= DateTime.Today) return;
        selectedDate = (selectedDate ?? DateTime.Today).AddDays(1);
        await LoadChapterAsync();
    }

    private async Task GoToTodayAsync()
    {
        selectedDate = DateTime.Today;
        await LoadChapterAsync();
    }

    private async Task HandlePageKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (loading) return;
        if (e.Key == "ArrowLeft") await PreviousDayAsync();
        else if (e.Key == "ArrowRight") await NextDayAsync();
    }

    private async Task OpenEvidenceLightboxAsync(ObservationEventDto item, string? imageUrl)
    {
        await DialogService.OpenAsync(
            $"{item.SubjectDisplayName} — {item.Activity}",
            ds => builder =>
            {
                builder.OpenElement(0, "div");
                builder.AddAttribute(1, "class", "lightbox-body");

                if (!string.IsNullOrWhiteSpace(imageUrl))
                {
                    builder.OpenElement(2, "img");
                    builder.AddAttribute(3, "src", imageUrl);
                    builder.AddAttribute(4, "alt", $"Evidence: {item.Activity}");
                    builder.AddAttribute(5, "class", "lightbox-image");
                    builder.CloseElement();
                }
                else
                {
                    builder.OpenElement(6, "p");
                    builder.AddAttribute(7, "class", "lightbox-missing");
                    builder.AddContent(8, "No image available for this event.");
                    builder.CloseElement();
                }

                builder.OpenElement(9, "div");
                builder.AddAttribute(10, "class", "lightbox-meta");
                builder.AddContent(11, $"{item.ObservedAtUtc.ToLocalTime():yyyy-MM-dd HH:mm} · {item.SignificantReason ?? "Significant event"}");
                builder.CloseElement();

                builder.CloseElement();
            },
            new DialogOptions
            {
                Width = "740px",
                CloseDialogOnOverlayClick = true,
                ShowClose = true
            });
    }

    private async Task LoadChapterAsync()
    {
        loading = true;
        StateHasChanged();
        try
        {
            var date = DateOnly.FromDateTime((selectedDate ?? DateTime.Today).Date);
            chapter = await ApiClient.GetChapterAsync(date);

            // Persist selected date for session continuity
            await JS.InvokeVoidAsync("localStorage.setItem", "powatch:archivesDate", selectedDate?.ToString("O") ?? string.Empty);
            evidenceUrls.Clear();
            imageLoadStatus.Clear();
            
            var itemsWithImages = chapter?.Highlights?
                .Where(x => !string.IsNullOrWhiteSpace(x.ImageReference))
                .ToList() ?? [];

            if (itemsWithImages.Count == 0)
            {
                loading = false;
                StateHasChanged();
                return;
            }

            // Use the new direct read endpoint for better error handling
            var sasResults = await Task.WhenAll(
                itemsWithImages.Select(async item => 
                {
                    try
                    {
                        var access = await ApiClient.GetBlobReadAccessAsync(item.ImageReference!);
                        return access?.SasUrl;
                    }
                    catch (Exception)
                    {
                        imageLoadStatus[item.ImageReference!] = "Failed";
                        return null;
                    }
                }));

            for (var i = 0; i < itemsWithImages.Count; i++)
            {
                var blobPath = itemsWithImages[i].ImageReference!;
                if (!string.IsNullOrWhiteSpace(sasResults[i]))
                {
                    evidenceUrls[blobPath] = sasResults[i]!;
                    imageLoadStatus[blobPath] = "Loaded";
                }
                else if (!imageLoadStatus.ContainsKey(blobPath))
                {
                    imageLoadStatus[blobPath] = "Missing";
                }
            }

            // NET_RUN_10 #2: a SAS URL is issued even for a missing blob, so verify each
            // image actually decodes in the browser and drop the ones that don't. This
            // stops the Evidence Highlights grid from rendering a wall of broken tiles;
            // dropped events are counted in the "N flagged · no saved image" note.
            if (evidenceUrls.Count > 0)
            {
                try
                {
                    var candidates = evidenceUrls.ToList();
                    var loadable = await JS.InvokeAsync<string[]>(
                        "PoWatchImages.filterLoadable",
                        candidates.Select(kv => kv.Value).ToArray());
                    var loadableSet = new HashSet<string>(loadable, StringComparer.Ordinal);
                    foreach (var kv in candidates)
                    {
                        if (!loadableSet.Contains(kv.Value))
                        {
                            evidenceUrls.Remove(kv.Key);
                            imageLoadStatus[kv.Key] = "Missing";
                        }
                    }
                }
                catch
                {
                    // If validation interop fails, fall back to showing whatever SAS URLs we have.
                }
            }
        }
        catch (Exception ex)
        {
            chapter = null;
            evidenceUrls.Clear();
            imageLoadStatus.Clear();
            NotificationService.Notify(NotificationSeverity.Error, "Archives", ex.Message, duration: 6000);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private string? GetEvidenceUrl(ObservationEventDto item)
    {
        if (string.IsNullOrWhiteSpace(item.ImageReference))
            return null;

        return evidenceUrls.TryGetValue(item.ImageReference, out var url) ? url : null;
    }

    private string? GetImageLoadStatus(ObservationEventDto item)
    {
        if (string.IsNullOrWhiteSpace(item.ImageReference))
            return null;

        return imageLoadStatus.TryGetValue(item.ImageReference, out var status) ? status : null;
    }

    private async Task OpenHandoffDialogAsync()
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(HandoffDialog.SelectedShift)] = selectedShift,
            [nameof(HandoffDialog.ShiftOptions)] = shiftOptions,
            [nameof(HandoffDialog.HandoffCoachEnabled)] = ClientFlags.Value.HandoffCoachEnabled,
            [nameof(HandoffDialog.GeneratingBrief)] = generatingBrief,
            [nameof(HandoffDialog.SelectedShiftChanged)] = EventCallback.Factory.Create<string>(this, value => selectedShift = value),
            [nameof(HandoffDialog.OnDownload)] = (Func<Task>)DownloadHandoffReportAsync,
            [nameof(HandoffDialog.OnGenerateBrief)] = (Func<Task>)GenerateHandoffBriefAsync
        };

        await DialogService.OpenAsync<HandoffDialog>(
            "Handoff",
            parameters,
            new DialogOptions { Width = "360px", CloseDialogOnEsc = true });
    }

    private async Task DownloadHandoffReportAsync()
    {
        if (selectedDate is null) return;

        var date = DateOnly.FromDateTime(selectedDate.Value);
        var url = ApiClient.GetHandoffReportUrl(date, selectedShift);
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task GenerateHandoffBriefAsync()
    {
        if (selectedDate is null) return;
        generatingBrief = true;
        handoffBrief = null;
        StateHasChanged();

        try
        {
            var date = DateOnly.FromDateTime(selectedDate.Value);
            var request = new GenerateHandoffBriefRequestDto
            {
                ShiftWindow = selectedShift,
                Audience = briefAudience,
                IncludeUnresolvedAlerts = true,
                IncludeHighlights = true
            };

            handoffBrief = await ApiClient.GenerateHandoffBriefAsync(date, request);

            if (handoffBrief is null)
                NotificationService.Notify(NotificationSeverity.Error, "Handoff Brief", "Brief generation failed.", duration: 5000);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Handoff Brief", ex.Message, duration: 6000);
        }
        finally
        {
            generatingBrief = false;
            StateHasChanged();
        }
    }
}
