@page "/"
@implements IAsyncDisposable
@using System.Globalization
@using PoWatch.Client.Components.Stats
@inject SensingSession Sensing
@inject PoWatchApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject StatsFeed Feed
@inject UiPrefs Prefs

<PageTitle>PoWatch | Live</PageTitle>

@* Everything on one screen: one bar (range; with Advanced on, the question box and the download), then a 4×4 grid. The camera
   takes four cells; key metrics and who is in frame sit beside it, two cells tall; the motion grid and the
   six stat panels fill the last two rows (CSS dissolves each family's own grid into this one). On a phone
   the panels after "In frame" become a strip you swipe through. Range and session live in the URL, so a
   reload, a shared link and Back/Forward land where you were. *@
<div class="dash">
    <div class="stats-toolbar" data-test="stats-toolbar">
        <RadzenSelectBar TValue="string" Value="@_range" ValueChanged="@OnRangeChanged" Size="ButtonSize.Small" aria-label="Range" title="@WindowLabel">
            <Items>
                <RadzenSelectBarItem Text="SESSION" Value="@("session")" Disabled="@(_sessionId == Guid.Empty)" />
                <RadzenSelectBarItem Text="TODAY" Value="@("today")" />
                <RadzenSelectBarItem Text="7D" Value="@("7d")" />
                <RadzenSelectBarItem Text="30D" Value="@("30d")" />
                <RadzenSelectBarItem Text="ALL" Value="@("all")" />
            </Items>
        </RadzenSelectBar>

        <span class="stats-window term-stat-hint" data-test="stats-window">@WindowLabel</span>

        @if (Prefs.Advanced)
        {
            <div class="stats-ask-row">
                <form class="stats-ask" @onsubmit="AskAsync" data-test="stats-ask">
                    <label class="visually-hidden" for="ask">Ask a question about your stats</label>
                    <input id="ask" @bind="_question" @bind:event="oninput" maxlength="300" autocomplete="off" placeholder="Ask: when is it usually busiest?" disabled="@_asking" />
                    <button type="submit" class="term-button" disabled="@(_asking || string.IsNullOrWhiteSpace(_question))">@(_asking ? "…" : "Ask")</button>
                </form>
                @* The grid shows the headlines; this file has every number behind them. *@
                <a class="term-button" href="@PoWatchApiClient.AllStatsUrl(_query)" download="PoWatch-@(_range).json"
                   title="Every number for this range, as one JSON file" aria-label="Download every number for this range (JSON)" data-test="stats-json">JSON ↓</a>
            </div>
        }
    </div>

    @if (_answer is not null && Prefs.Advanced)
    {
        <p class="stats-answer" role="status" data-test="stats-answer"><b>ANSWER</b> @_answer</p>
    }

    <div class="dash-grid">
        <TerminalPanel Title="Camera" Class="live-camera" Test="live-camera" Flush="true">
            <Aside>
                @(Sensing.IsRunning ? (L.Demo ? "DEMO SCENE" : "CAMERA") : "STANDBY")
            </Aside>
            <ChildContent>
                @* The camera element itself lives in the layout and is docked over this slot. *@
                <div class="live-stage">
                    <div class="live-feed" @ref="_slot">
                        @if (Prefs.Advanced)
                        {
                            @* Comet trails of everyone in frame, drawn by fx.js. *@
                            <canvas class="fx-trails" data-fx-trails aria-hidden="true"></canvas>
                            @* The tube switching on and off (crt.js): over the picture, under nothing else. *@
                            <canvas class="crt" @ref="_crt" aria-hidden="true"></canvas>
                        }

                        @foreach (var track in L.Tracks)
                        {
                            <div class="live-box @(track.Label == "person" ? "live-box--person" : string.Empty)"
                                 style="left: @Pct(track.Box.X0 * 100)%; top: @Pct(track.Box.Y0 * 100)%; width: @Pct((track.Box.X1 - track.Box.X0) * 100)%; height: @Pct((track.Box.Y1 - track.Box.Y0) * 100)%;">
                                <span>@(L.RegularFor(track.TrackId)?.DisplayName ?? track.Label) @track.Box.Score.ToString("0.00", CultureInfo.InvariantCulture) · #@track.TrackId</span>
                            </div>
                        }

                        @if (!Sensing.IsRunning)
                        {
                            <div class="live-standby" data-test="live-standby">
                                <p>Point a camera at anything, press Start, walk away.</p>
                                <div class="live-actions">
                                    <button class="term-button term-button--primary" @onclick="() => StartAsync(demo: false)" disabled="@_starting" data-test="start-camera">Start camera</button>
                                    @* Only until the first session exists; the command palette offers the demo after that. *@
                                    @if (_firstRun)
                                    {
                                        <button class="term-button" @onclick="() => StartAsync(demo: true)" disabled="@_starting" data-test="start-demo">No camera? Try the demo</button>
                                    }
                                </div>
                                @if (_error is not null)
                                {
                                    <p class="live-error" role="alert" data-test="live-error">@_error</p>
                                }
                            </div>
                        }
                        else if (Sensing.Live.Demo)
                        {
                            <div class="live-demo-note" aria-hidden="true">DEMO SCENE · SYNTHETIC</div>
                        }
                    </div>
                </div>
                <div class="live-caption" data-test="live-caption">
                    <span class="live-caption-tag">VLM @(L.LastCaptionUtc?.ToLocalTime().ToString("HH:mm:ss", CultureInfo.CurrentCulture) ?? "--:--:--")</span>
                    @if (L.LastCaption is { } caption)
                    {
                        @* Keyed, so each new caption types itself out afresh. *@
                        <span @key="L.LastCaptionUtc" class="fx-type" style="--chars: @caption.Length">@caption</span>
                    }
                    else
                    {
                        <span>@(Sensing.IsRunning ? "Waiting for the first caption…" : "—")</span>
                    }
                    @if (L.LastError is not null)
                    {
                        <span class="live-error" role="status">@L.LastError</span>
                    }
                </div>
            </ChildContent>
        </TerminalPanel>

        <KeyMetrics Range="@_range" Presence="@_presence" Patterns="@_patterns" OccupancyTrend="@_occupancyTrend" VisitsTrend="@_visitsTrend"
                    OnExplain="@(Prefs.Advanced ? EventCallback.Factory.Create(this, ExplainAsync) : default)" Asking="@_asking" />
        <InFrame Objects="@_objects" />

        @* On a phone the rest is a strip you swipe through, with keys to jump; elsewhere it melts into the grid. *@
        <nav class="dash-pager" aria-label="Stat panels">
            @for (var i = 0; i < Pages.Length; i++)
            {
                var index = i;
                <button type="button" class="term-button" @onclick="() => ShowPanelAsync(index)">@Pages[i]</button>
            }
        </nav>
        <div class="dash-more" @ref="_more">
            <TerminalPanel Title="Motion grid" Test="live-motion-grid">
                <Aside>16×9 · EDGES TODAY</Aside>
                <ChildContent>
                    <div class="live-heat">
                        @if (_shaderHeat && Prefs.Advanced)
                        {
                            @* Drawn by heat-gl.js (a WebGL2 shader) after every render; the plain grid is the simple view and the fallback. *@
                            <canvas @ref="_heat" class="heat-gl" role="img" aria-label="Where motion is happening right now" data-test="heat-gl"></canvas>
                        }
                        else
                        {
                            <HeatGrid Values="@L.Heat.Select(v => (double)v).ToList()" Label="Where motion is happening right now" />
                        }
                    </div>
                    <div class="live-edges">
                        @foreach (var edge in Edges)
                        {
                            <span>@edge <b>@(_space?.Entries.GetValueOrDefault(edge) ?? 0)↓ @(_space?.Exits.GetValueOrDefault(edge) ?? 0)↑</b></span>
                        }
                    </div>
                </ChildContent>
            </TerminalPanel>

            @* Pipeline numbers are operations, not the room: they live on System. *@
            <PresenceTab Query="@_query" />
            <SpaceTab Query="@_query" />
            <PatternsTab Query="@_query" />
            <EnvironmentTab Query="@_query" />
        </div>
    </div>
</div>

@code {
    private const string RangeKey = "powatch:range";
    private static readonly string[] Ranges = ["session", "today", "7d", "30d", "all"];
    private static readonly string[] Edges = ["Left", "Top", "Right", "Bottom"];

    /// <summary>The phone strip's keys, in the order the panels appear.</summary>
    private static readonly string[] Pages = ["Grid", "Energy", "Space", "Curve", "Week", "Light", "Colour"];

    private string _range = "today";
    private Guid _sessionId;
    private StatsQuery _query = StatsQuery.For("today");
    private string? _question;
    private string? _answer;
    private bool _asking;

    private ElementReference _slot;
    private ElementReference _crt;
    private ElementReference _heat;
    private ElementReference _more;
    private bool _shaderHeat = true;
    private IReadOnlyList<double> _occupancyTrend = [];
    private IReadOnlyList<double> _visitsTrend = [];
    private DotNetObjectReference<Live>? _self;
    private bool _starting;
    private bool _firstRun;
    private bool _wasRunning;
    private string? _error;
    private PresenceStatsDto? _presence;
    private SpaceStatsDto? _space;
    private PatternStatsDto? _patterns;
    private ObjectStatsDto? _objects;
    private CancellationTokenSource? _refresh;
    private DateTimeOffset _lastRender;
    private DateTimeOffset _lastPush;

    [SupplyParameterFromQuery(Name = "start")] public string? StartMode { get; set; }

    [SupplyParameterFromQuery(Name = "range")] public string? RangeParameter { get; set; }

    /// <summary>A session to open straight away (History links each of its sessions here).</summary>
    [SupplyParameterFromQuery(Name = "session")] public Guid? SessionParameter { get; set; }

    private string WindowLabel => _range switch
    {
        "session" => $"Session {SessionDto.Tag(_sessionId)}, minute by minute",
        "7d" => "Last 7 days, hour by hour",
        "30d" => "Last 30 days, hour by hour",
        "all" => "Everything, day by day",
        _ => "Today so far, minute by minute"
    } + $" · {TimeZoneInfo.Local.Id}";

    private LiveSensingState L => Sensing.Live;

    protected override void OnInitialized()
    {
        _wasRunning = Sensing.IsRunning;
        Sensing.Changed += OnSensingChanged;
        Feed.Changed += OnStatsChanged;
        Prefs.Changed += OnPrefsChanged;
        _ = Feed.EnsureConnectedAsync();
        _refresh = new CancellationTokenSource();
        _ = RefreshLoopAsync(_refresh.Token);
    }

    /// <summary>The URL is the state: the range control navigates, and this reads the result back.</summary>
    protected override void OnParametersSet()
    {
        var range = SessionParameter is not null ? "session" : RangeParameter is { } r && Ranges.Contains(r) ? r : null;
        var session = SessionParameter ?? _sessionId;
        if (range is null || (range == _range && session == _sessionId)) return;

        (_range, _sessionId) = (range, session);
        Apply();
        // Key metrics and the census follow the range too (the stat panels reload themselves).
        _ = RefreshStatsAsync();
    }

    private void OnRangeChanged(string range)
    {
        if (range != "session") _ = JS.TryInvokeVoidAsync("localStorage.setItem", RangeKey, range);
        Navigation.NavigateTo($"?range={range}" + (range == "session" && _sessionId != Guid.Empty ? $"&session={_sessionId}" : string.Empty));
    }

    private void Apply() =>
        _query = StatsQuery.For(_range, _range == "session" && _sessionId != Guid.Empty ? _sessionId : null);

    private async Task AskAsync()
    {
        if (_asking || string.IsNullOrWhiteSpace(_question)) return;
        _asking = true;
        _answer = "Thinking…";
        _answer = await Api.AskAsync(_question.Trim())
            ?? "No answer: this server has no AI model configured, or it did not reply.";
        _asking = false;
    }

    private Task ExplainAsync()
    {
        _question = "Which of today's numbers are unusual against my usual day, and what stands out about today?";
        return AskAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.TryInvokeVoidAsync("powatchFeed.watchReturn", _self, 300);
            await DockFeedAsync();
        }

        if (_shaderHeat && Prefs.Advanced && !await JS.TryInvokeAsync<bool>("powatchHeat.draw", _heat, L.Heat, 16, 9))
        {
            _shaderHeat = false;
            StateHasChanged();
        }

        // ?start=camera|demo (header Start, or a typed URL) works whether or not Live was already open.
        if (StartMode is not { } mode || Sensing.IsRunning || _starting) return;
        Navigation.NavigateTo("", replace: true);
        await StartAsync(demo: mode == "demo");
    }

    private async Task StartAsync(bool demo)
    {
        _starting = true;
        _error = null;
        try
        {
            _error = await Sensing.StartAsync(demo);
        }
        finally
        {
            _starting = false;
        }
    }

    private void OnSensingChanged()
    {
        // Started or stopped, from here or the header: dock or undock the camera and recount.
        if (Sensing.IsRunning != _wasRunning)
        {
            _wasRunning = Sensing.IsRunning;
            // SESSION means the one running, else the latest.
            if (SessionParameter is null && Sensing.Live.Session is { } running)
            {
                _sessionId = running.Id;
                if (_range == "session") Apply();
            }

            InvokeAsync(async () =>
            {
                // On: the tube is black before the picture docks under it. Off: the picture stays until it is dark.
                if (Prefs.Advanced && Sensing.IsRunning) _ = JS.TryInvokeVoidAsync("powatchCrt.power", _crt, true);
                else if (Prefs.Advanced) await JS.TryInvokeVoidAsync("powatchCrt.power", _crt, false);
                await DockFeedAsync();
                await RefreshStatsAsync();
            });
            return;
        }

        // Sensing fires several times a second; four renders a second is plenty for the eye.
        var now = DateTimeOffset.UtcNow;
        if (now - _lastRender < TimeSpan.FromMilliseconds(250)) return;
        _lastRender = now;
        InvokeAsync(StateHasChanged);
    }

    private void OnPrefsChanged() => InvokeAsync(StateHasChanged);

    private void OnStatsChanged(StatsChangedDto change)
    {
        if (DateTimeOffset.UtcNow - _lastPush < TimeSpan.FromSeconds(5)) return;
        _lastPush = DateTimeOffset.UtcNow;
        _query = _query with { Stamp = _query.Stamp + 1 };
        _ = RefreshStatsAsync();
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        var latest = await Api.ListSessionsAsync(1);
        _firstRun = latest.Count == 0;
        if (_sessionId == Guid.Empty) _sessionId = Sensing.Live.Session?.Id ?? latest.FirstOrDefault()?.Id ?? Guid.Empty;

        // A bare address opens on the range you last looked at.
        if (RangeParameter is null && SessionParameter is null
            && await JS.TryInvokeAsync<string>("localStorage.getItem", RangeKey) is { } remembered
            && Ranges.Contains(remembered) && remembered != "session" && remembered != _range)
        {
            _range = remembered;
            Apply();
        }

        await RefreshStatsAsync();
        // Push (StatsFeed) refreshes as data lands; this slow timer only covers a dropped hub.
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
                await RefreshStatsAsync();
        }
        catch (OperationCanceledException)
        {
            // Page closed.
        }
    }

    /// <summary>Presence and classes follow the range; the edges and "vs usual" are always about today.</summary>
    private async Task RefreshStatsAsync()
    {
        var query = _query;
        var today = StatsQuery.For("today");
        var presence = Api.GetPresenceAsync(query);
        var space = Api.GetSpaceAsync(today);
        var patterns = Api.GetPatternsAsync(today);
        var objects = Api.GetObjectsAsync(query);
        await Task.WhenAll(presence, space, patterns, objects);
        // A newer range owns the panels now.
        if (query.Range != _query.Range || query.SessionId != _query.SessionId) return;
        (_presence, _space, _patterns, _objects) = (presence.Result, space.Result, patterns.Result, objects.Result);
        // Derived once per refresh, not once per render.
        _occupancyTrend = _presence?.Series.Select(p => p.Occupancy).TakeLast(120).ToList() ?? [];
        _visitsTrend = _presence?.Series.Select(p => (double)p.Visits).TakeLast(120).ToList() ?? [];
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>The tab was hidden for five minutes or more: show what happened meanwhile.</summary>
    [JSInvokable]
    public async Task OnReturned(int secondsAway)
    {
        if (!Sensing.IsRunning || Sensing.Live.Session is not { } session) return;
        var refreshed = await Api.ListSessionsAsync(5);
        Sensing.Recap = new SessionRecap(refreshed.FirstOrDefault(s => s.Id == session.Id) ?? session, TimeSpan.FromSeconds(secondsAway), await Sensing.ExposureAsync());
    }

    private Task DockFeedAsync() => Sensing.DockFeedAsync(_slot);

    private Task ShowPanelAsync(int index) => JS.TryInvokeVoidAsync("powatchMenus.reveal", _more, index);

    private static string Pct(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        Sensing.Changed -= OnSensingChanged;
        Feed.Changed -= OnStatsChanged;
        Prefs.Changed -= OnPrefsChanged;
        await JS.TryInvokeVoidAsync("powatchFeed.undock");
        await JS.TryInvokeVoidAsync("powatchFeed.unwatchReturn");
        _self?.Dispose();
        if (_refresh is not null)
        {
            await _refresh.CancelAsync();
            _refresh.Dispose();
        }
    }
}
