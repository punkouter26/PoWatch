@page "/"
@implements IAsyncDisposable
@using System.Globalization
@inject SensingSession Sensing
@inject PoWatchApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject StatsFeed Feed

<PageTitle>PoWatch | Live</PageTitle>

@* Four panels: the camera, the numbers, who and what is in frame, and where it moves. Recent events
   scroll on the tape below; pipeline details live on System. On a wide screen the two columns fill
   the viewport (the camera grows into the height left over); narrower, they fall back to the grid. *@
@{ var census = CensusRows(); }
<div class="term-grid live-grid">
    <div class="live-col live-col--main">
        <TerminalPanel Number="01" Title="Camera" Class="term-span-2 term-row-span-2 live-camera" Test="live-camera" Flush="true">
            <Aside>
                @if (Sensing.IsRunning)
                {
                    <span data-test="stat-pixel-hz">@L.PixelHz.ToString("0.0", CultureInfo.InvariantCulture)</span>
                    @($" FPS · DETECTOR {L.DetectorHz.ToString("0.0", CultureInfo.InvariantCulture)} Hz · {L.Tracks.Count} TRACKS")
                }
                else
                {
                    @("STANDBY")
                }
            </Aside>
            <ChildContent>
                @* The camera element itself lives in the layout and is docked over this slot. *@
                <div class="live-stage">
                    <div class="live-feed" @ref="_slot">
                        @* Comet trails of everyone in frame, drawn by fx.js. *@
                        <canvas class="fx-trails" data-fx-trails aria-hidden="true"></canvas>

                        @foreach (var track in L.Tracks)
                        {
                            <div class="live-box @(track.Label == "person" ? "live-box--person" : string.Empty)"
                                 style="left: @Pct(track.Box.X0 * 100)%; top: @Pct(track.Box.Y0 * 100)%; width: @Pct((track.Box.X1 - track.Box.X0) * 100)%; height: @Pct((track.Box.Y1 - track.Box.Y0) * 100)%;">
                                <span>@(L.RegularFor(track.TrackId)?.DisplayName ?? track.Label) @track.Box.Score.ToString("0.00", CultureInfo.InvariantCulture) · #@track.TrackId</span>
                            </div>
                        }

                        @if (!Sensing.IsRunning)
                        {
                            <div class="live-standby" data-test="live-standby">
                                <p>Point a camera at anything, press Start, walk away.</p>
                                <div class="live-actions">
                                    <button class="term-button term-button--primary" @onclick="() => StartAsync(demo: false)" disabled="@_starting" data-test="start-camera">Start camera</button>
                                    <button class="term-button" @onclick="() => StartAsync(demo: true)" disabled="@_starting" data-test="start-demo">Demo scene</button>
                                    <label class="live-toggle">
                                        <input type="checkbox" checked="@Sensing.Captions" @onchange="SetCaptionsAsync" /> Captions (vision model)
                                    </label>
                                </div>
                                @if (_error is not null)
                                {
                                    <p class="live-error" role="alert" data-test="live-error">@_error</p>
                                }
                            </div>
                        }
                        else if (Sensing.Live.Demo)
                        {
                            <div class="live-demo-note" aria-hidden="true">DEMO SCENE · SYNTHETIC</div>
                        }
                    </div>
                </div>
                <div class="live-caption" data-test="live-caption">
                    <span class="live-caption-tag">VLM @(L.LastCaptionUtc?.ToLocalTime().ToString("HH:mm:ss", CultureInfo.CurrentCulture) ?? "--:--:--")</span>
                    @if (L.LastCaption is { } caption)
                    {
                        @* Keyed, so each new caption types itself out afresh. *@
                        <span @key="L.LastCaptionUtc" class="fx-type" style="--chars: @caption.Length">@caption</span>
                    }
                    else
                    {
                        <span>@(Sensing.IsRunning ? "Waiting for the first caption…" : "—")</span>
                    }
                    @if (L.LastError is not null)
                    {
                        <span class="live-error" role="status">@L.LastError</span>
                    }
                </div>
            </ChildContent>
        </TerminalPanel>

        <TerminalPanel Number="02" Title="Key metrics" Class="term-span-2" Test="live-metrics" Flush="true">
            <Aside>TODAY vs USUAL</Aside>
            <ChildContent>
                <table class="term-table">
                    @* One cell carries the value and how unusual it is; rows without a baseline have no empty column to show. *@
                    <thead><tr><th>Metric</th><th class="r">Now · vs usual</th><th class="live-trend">Trend</th></tr></thead>
                    <tbody>
                        <tr data-test="metric-occupancy">
                            <td>OCCUPANCY TODAY</td>
                            <td class="r live-metric">@Percent(_today?.Occupancy) <ZChip Z="@Anomaly("occupancy")" /></td>
                            <td><Sparkline Values="@_occupancyTrend" Max="1" Label="Occupancy today" /></td>
                        </tr>
                        <tr>
                            <td>VISITS / HR TODAY</td>
                            <td class="r live-metric">@(_today is null ? "—" : _today.VisitsPerHour.ToString("0.0", CultureInfo.InvariantCulture)) <ZChip Z="@Anomaly("visits/hour")" /></td>
                            <td><Sparkline Values="@_visitsTrend" Cyan="true" Label="Visits today" /></td>
                        </tr>
                        <tr>
                            <td>MOTION NOW</td>
                            <td class="r live-metric"><span data-test="metric-motion">@L.Motion.ToString("0.000", CultureInfo.InvariantCulture)</span> <ZChip Z="@Anomaly("motion")" /></td>
                            <td><Sparkline Values="@L.MotionHistory" Label="Motion, last minute" /></td>
                        </tr>
                        <tr data-test="live-light">
                            <td>LIGHT · COLOURS NOW</td>
                            <td class="r">@L.Luminance.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>
                                <Sparkline Values="@L.LuminanceHistory" Max="1" Cyan="true" Label="Light, last minute" />
                                <div class="term-swatches live-swatches" aria-label="Colours in frame now">
                                    @foreach (var color in L.Palette)
                                    {
                                        <span style="background: #@color.ToString("x6", CultureInfo.InvariantCulture)"></span>
                                    }
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>PEOPLE · ANIMALS NOW</td>
                            <td class="r" data-test="metric-people"><span class="fx-tick" @key="(L.PeopleNow, L.AnimalsNow)">@L.PeopleNow · @L.AnimalsNow</span></td>
                            <td class="term-stat-hint">peak @L.PeakConcurrency this session</td>
                        </tr>
                        <tr>
                            <td>VISITS THIS SESSION</td>
                            <td class="r" data-test="metric-visits"><span class="fx-tick" @key="L.Visits">@L.Visits</span></td>
                            <td class="term-stat-hint">@L.Captions captions</td>
                        </tr>
                    </tbody>
                </table>
            </ChildContent>
        </TerminalPanel>
    </div>

    <div class="live-col">
        <TerminalPanel Number="03" Title="In frame" Class="live-grow" Test="live-tracks" Flush="true">
            <Aside>@L.Tracks.Count TRACKED · @census.Count CLASSES</Aside>
            <ChildContent>
                @if (L.Tracks.Count > 0)
                {
                    <ul class="live-who" aria-label="Tracked right now">
                        @foreach (var track in L.Tracks.Take(8))
                        {
                            <li>#@track.TrackId <b>@(L.RegularFor(track.TrackId)?.DisplayName ?? track.Label)</b> @DisplayText.Duration((DateTimeOffset.UtcNow - track.FirstSeenUtc).TotalSeconds)</li>
                        }
                    </ul>
                }
                @if (census.Count == 0)
                {
                    <p class="term-empty">Nothing seen yet.</p>
                }
                else
                {
                    <table class="term-table" data-test="live-census">
                        <thead><tr><th>Class</th><th class="r">Now</th><th class="r">Peak</th><th class="r">Share</th></tr></thead>
                        <tbody>
                            @foreach (var row in census.Take(8))
                            {
                                <tr><td>@row.Name</td><td class="r">@L.ClassesNow.GetValueOrDefault(row.Name)</td><td class="r">@row.Peak</td><td class="r">@Percent(row.Share)</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </ChildContent>
        </TerminalPanel>

        <TerminalPanel Number="04" Title="Motion grid" Test="live-motion-grid">
            <Aside>16×9 · EDGES TODAY</Aside>
            <ChildContent>
                @if (_shaderHeat)
                {
                    @* Drawn by heat-gl.js (a WebGL2 shader) after every render; the plain grid is the fallback. *@
                    <canvas @ref="_heat" class="heat-gl" role="img" aria-label="Where motion is happening right now" data-test="heat-gl"></canvas>
                }
                else
                {
                    <HeatGrid Values="@L.Heat.Select(v => (double)v).ToList()" Label="Where motion is happening right now" />
                }
                <div class="live-edges">
                    @foreach (var edge in Edges)
                    {
                        <span>@edge <b>@(_space?.Entries.GetValueOrDefault(edge) ?? 0)↓ @(_space?.Exits.GetValueOrDefault(edge) ?? 0)↑</b></span>
                    }
                </div>
            </ChildContent>
        </TerminalPanel>
    </div>
</div>

@code {
    private static readonly string[] Edges = ["Left", "Top", "Right", "Bottom"];

    private ElementReference _slot;
    private ElementReference _heat;
    private bool _shaderHeat = true;
    private IReadOnlyList<double> _occupancyTrend = [];
    private IReadOnlyList<double> _visitsTrend = [];
    private DotNetObjectReference<Live>? _self;
    private bool _starting;
    private bool _wasRunning;
    private string? _error;
    private PresenceStatsDto? _today;
    private SpaceStatsDto? _space;
    private PatternStatsDto? _patterns;
    private ObjectStatsDto? _objects;
    private CancellationTokenSource? _refresh;
    private DateTimeOffset _lastRender;
    private DateTimeOffset _lastPush;

    [SupplyParameterFromQuery(Name = "start")] public string? StartMode { get; set; }

    private LiveSensingState L => Sensing.Live;

    private Dictionary<string, ClassStatDto> _knownClasses = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Built once per render (the page renders four times a second): what is in frame now first, then history.</summary>
    private List<ClassStatDto> CensusRows() =>
        L.ClassesSeen.Keys.Concat(_knownClasses.Keys)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(name => _knownClasses.GetValueOrDefault(name) ?? new ClassStatDto { Name = name, Peak = L.ClassesNow.GetValueOrDefault(name) })
            .OrderByDescending(c => L.ClassesNow.GetValueOrDefault(c.Name))
            .ThenByDescending(c => c.TicksPresent)
            .ToList();

    protected override void OnInitialized()
    {
        _wasRunning = Sensing.IsRunning;
        Sensing.Changed += OnSensingChanged;
        Feed.Changed += OnStatsChanged;
        _ = Feed.EnsureConnectedAsync();
        _refresh = new CancellationTokenSource();
        _ = RefreshLoopAsync(_refresh.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.TryInvokeVoidAsync("powatchFeed.watchReturn", _self, 300);
            await DockFeedAsync();
        }

        if (_shaderHeat && !await JS.TryInvokeAsync<bool>("powatchHeat.draw", _heat, L.Heat, 16, 9))
        {
            _shaderHeat = false;
            StateHasChanged();
        }

        // ?start=camera|demo (header Start, or a typed URL) works whether or not Live was already open.
        if (StartMode is not { } mode || Sensing.IsRunning || _starting) return;
        Navigation.NavigateTo("", replace: true);
        await StartAsync(demo: mode == "demo");
    }

    private async Task StartAsync(bool demo)
    {
        _starting = true;
        _error = null;
        try
        {
            _error = await Sensing.StartAsync(demo);
        }
        catch (HttpRequestException)
        {
            _error = "The server could not be reached, so no session was started.";
        }
        finally
        {
            _starting = false;
        }
    }

    private void OnSensingChanged()
    {
        // Started or stopped, from here or the header: dock or undock the camera and recount.
        if (Sensing.IsRunning != _wasRunning)
        {
            _wasRunning = Sensing.IsRunning;
            InvokeAsync(async () =>
            {
                await DockFeedAsync();
                await RefreshStatsAsync();
            });
            return;
        }

        // Sensing fires several times a second; four renders a second is plenty for the eye.
        var now = DateTimeOffset.UtcNow;
        if (now - _lastRender < TimeSpan.FromMilliseconds(250)) return;
        _lastRender = now;
        InvokeAsync(StateHasChanged);
    }

    private void OnStatsChanged(StatsChangedDto change)
    {
        if (DateTimeOffset.UtcNow - _lastPush < TimeSpan.FromSeconds(5)) return;
        _lastPush = DateTimeOffset.UtcNow;
        _ = RefreshStatsAsync();
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        await RefreshStatsAsync();
        // Push (StatsFeed) refreshes as data lands; this slow timer only covers a dropped hub.
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
                await RefreshStatsAsync();
        }
        catch (OperationCanceledException)
        {
            // Page closed.
        }
    }

    private async Task RefreshStatsAsync()
    {
        var today = StatsQuery.For("today");
        var presence = Api.GetPresenceAsync(today);
        var space = Api.GetSpaceAsync(today);
        var patterns = Api.GetPatternsAsync(today);
        var objects = Api.GetObjectsAsync(today);
        await Task.WhenAll(presence, space, patterns, objects);
        (_today, _space, _patterns, _objects) = (presence.Result, space.Result, patterns.Result, objects.Result);
        // Derived once per refresh, not once per render.
        _occupancyTrend = _today?.Series.Select(p => p.Occupancy).TakeLast(120).ToList() ?? [];
        _visitsTrend = _today?.Series.Select(p => (double)p.Visits).TakeLast(120).ToList() ?? [];
        _knownClasses = _objects?.Classes.GroupBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase) ?? _knownClasses;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>The tab was hidden for five minutes or more: show what happened meanwhile.</summary>
    [JSInvokable]
    public async Task OnReturned(int secondsAway)
    {
        if (!Sensing.IsRunning || Sensing.Live.Session is not { } session) return;
        var refreshed = await Api.ListSessionsAsync(5);
        Sensing.Recap = new SessionRecap(refreshed.FirstOrDefault(s => s.Id == session.Id) ?? session, TimeSpan.FromSeconds(secondsAway), await Sensing.ExposureAsync());
    }

    /// <summary>Shows the camera over the slot while a camera session runs; hides it otherwise.</summary>
    private async Task DockFeedAsync()
    {
        if (Sensing.Feed is { } feed && Sensing.IsRunning && !Sensing.Live.Demo)
            await JS.TryInvokeVoidAsync("powatchFeed.dock", feed, _slot);
        else
            await JS.TryInvokeVoidAsync("powatchFeed.undock");
    }

    private async Task SetCaptionsAsync(ChangeEventArgs e)
    {
        Sensing.Captions = e.Value is true;
        await JS.TryInvokeVoidAsync("localStorage.setItem", PoWatch.Client.Layout.MainLayout.CaptionsKey, Sensing.Captions ? "on" : "off");
    }

    private double? Anomaly(string metric) => _patterns?.Anomalies.FirstOrDefault(a => a.Metric == metric)?.Z;

    private static string Percent(double? value) => value is { } v ? v.ToString("0.0%", CultureInfo.InvariantCulture) : "—";

    private static string Pct(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        Sensing.Changed -= OnSensingChanged;
        Feed.Changed -= OnStatsChanged;
        await JS.TryInvokeVoidAsync("powatchFeed.undock");
        await JS.TryInvokeVoidAsync("powatchFeed.unwatchReturn");
        _self?.Dispose();
        if (_refresh is not null)
        {
            await _refresh.CancelAsync();
            _refresh.Dispose();
        }
    }
}
