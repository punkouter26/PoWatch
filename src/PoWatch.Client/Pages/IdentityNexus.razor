@page "/identity"
@attribute [Authorize]
@using PoWatch.Shared.Models
@inject PoWatch.Client.Services.PoWatchApiClient ApiClient
@inject DialogService DialogService
@inject NotificationService NotificationService
@using System.Net.Http

<PageTitle>PoWatch | People</PageTitle>

<div class="sector-grid identity-grid">
    @* Consolidation #1: the old Overview page's live card grid now lives here, above the
       management table — one page owns everything about people. *@
    <RadzenCard class="panel panel-glance">
        @* Wire OnSubjectFocused. Without it the grid fell back to navigating to
           /identity?focus=… — the page it is already on — so OnInitializedAsync never re-ran
           and clicking a card did nothing at all. It now opens the inline rename below. *@
        <PoWatch.Client.Shared.SubjectGlanceGrid OnSubjectFocused="FocusSubjectAsync" />
    </RadzenCard>

    <RadzenCard class="panel panel-library">
        @* Title/subtitle live in the page-hud header bar (UI review item #7). *@
        <div class="identity-register-bar">
            <RadzenTextBox @bind-Value="newSubjectName" @bind-Value:event="oninput"
                          Placeholder="Add someone by name (e.g. Mom) — press Enter"
                          aria-label="Name of the person to add"
                          Class="identity-flex-input"
                          @onkeydown="@(async e => { if (e.Key == "Enter") await RegisterSubjectAsync(); })" />
            <RadzenButton Icon="person_add" Text="Add person" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                Click="RegisterSubjectAsync"
                Disabled="@(busy || string.IsNullOrWhiteSpace(newSubjectName))"
                title="@(string.IsNullOrWhiteSpace(newSubjectName) ? "Type a name first" : "Add this person")" />
        </div>

        <h2>All people</h2>

        @if (loading)
        {
            <div class="skeleton-block">
                <div class="skeleton-line skeleton-line--wide"></div>
                <div class="skeleton-line skeleton-line--medium"></div>
                <div class="skeleton-line skeleton-line--wide"></div>
                <div class="skeleton-line skeleton-line--short"></div>
                <div class="skeleton-line skeleton-line--medium"></div>
            </div>
        }
        else if (subjects.Count == 0)
        {
            <div class="archive-empty actionable-empty">
                <div class="empty-icon">👤</div>
                <p class="empty-title">No one seen yet</p>
                <p class="empty-subtitle">Start watching and everyone seen in the room will appear here.</p>
                <a href="/" class="archive-empty-cta primary-cta">→ Go to the Live Room to start watching</a>
            </div>
        }
        else
        {
            <RadzenDataGrid Data="subjects" TItem="SubjectProfileDto" AllowPaging="true" PageSize="8" AllowColumnResize="true" class="identity-grid-table">
                <Columns>
                    <RadzenDataGridColumn TItem="SubjectProfileDto" Property="DisplayName" Title="Name">
                        <Template Context="item">
                            @if (editingSubjectId == item.SubjectId)
                            {
                                <div class="inline-edit-row">
                                    <RadzenTextBox @bind-Value="editingName" Class="identity-flex-input"
                                                  @onkeydown="@(async e => { if (e.Key == "Enter") await CommitInlineRenameAsync(); else if (e.Key == "Escape") CancelInlineEdit(); })" />
                                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                        Click="CommitInlineRenameAsync" Disabled="@(string.IsNullOrWhiteSpace(editingName))" aria-label="Save" />
                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                        Click="CancelInlineEdit" aria-label="Cancel" />
                                </div>
                            }
                            else
                            {
                                <div class="name-cell">
                                    @* Same humanization as the glance cards above and the Live Room
                                       timeline (DisplayText.SubjectName). Rendering the raw
                                       "Subject-116" here made one person appear under two different
                                       names on the same page, so a card could not be matched to a row. *@
                                    <span class="subject-name subject-name-editable"
                                          @onclick="@(() => BeginInlineEdit(item))"
                                          title="Click to rename"
                                          role="button" tabindex="0"
                                          @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") BeginInlineEdit(item); })">@PoWatch.Client.Services.DisplayText.SubjectName(item.DisplayName, item.IsKnownIdentity)</span>
                                </div>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SubjectProfileDto" Title="Known" Width="80px">
                        <Template Context="item">@(item.IsKnownIdentity ? "Yes" : "No")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SubjectProfileDto" Title="First Seen" Width="160px">
                        <Template Context="item">@item.FirstSeenUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SubjectProfileDto" Title="Last Seen" Width="160px">
                        <Template Context="item">@item.LastSeenUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </RadzenCard>

    @* The 8-second "Undo" toast that used to sit here was a false promise: the confirm dialog
       says the merge cannot be undone, there is no undo endpoint, and pressing Undo only
       replied "Undo is not supported by the current API version". It also styled its button
       with Bootstrap classes this app does not ship. Removed — the pre-merge confirmation is
       the real safeguard, and the success toast still reports what changed. *@
    <RadzenCard class="panel panel-merge">
        <CollapsibleSection Title="Merge two people">
            <div class="merge-form">
                <label>Keep this person</label>
                <RadzenDropDown Data="subjects" TextProperty="DisplayName" ValueProperty="SubjectId" @bind-Value="primarySubjectId" Class="identity-wide-input" />

                <label>Merge this one into them</label>
                <RadzenDropDown Data="subjects.Where(x => x.SubjectId != primarySubjectId)" TextProperty="DisplayName" ValueProperty="SubjectId" @bind-Value="secondarySubjectId" Class="identity-wide-input" />

                <label>Name to keep (optional)</label>
                <RadzenTextBox @bind-Value="canonicalName" Class="identity-wide-input" />

                <RadzenButton Text="Commit Merge" ButtonStyle="ButtonStyle.Danger" Click="MergeAsync" Disabled="@(busy || subjects.Count < 2)" />
            </div>
        </CollapsibleSection>
    </RadzenCard>
</div>

@code {
    private List<SubjectProfileDto> subjects = [];
    private string? primarySubjectId;
    private string? secondarySubjectId;
    private string? canonicalName;
    private bool busy;
    private bool loading;
    private string? editingSubjectId;
    private string editingName = string.Empty;
    private string newSubjectName = string.Empty;

    // One-tap deep-link (audit #7): a subject card elsewhere links to /identity?focus=<id>.
    [Parameter]
    [SupplyParameterFromQuery(Name = "focus")]
    public string? Focus { get; set; }

    protected override async Task OnInitializedAsync()
    {
        loading = true;

        try
        {
            await LoadSubjectsAsync();

            // Open the rename inline for the focused subject so a detected subject can be named
            // in a single tap from the Observer Hub, with no scrolling/searching.
            if (!string.IsNullOrWhiteSpace(Focus))
            {
                var target = subjects.FirstOrDefault(s => string.Equals(s.SubjectId, Focus, StringComparison.OrdinalIgnoreCase));
                if (target is not null)
                {
                    editingSubjectId = target.SubjectId;
                    editingName = target.DisplayName;
                }
            }
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadSubjectsAsync()
    {
        try
        {
            subjects = (await ApiClient.GetSubjectsAsync())
                .OrderByDescending(x => x.LastSeenUtc)
                .ToList();
        }
        catch (HttpRequestException ex)
        {
            subjects = [];
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Identity API",
                $"Could not load subjects. {ex.Message}",
                duration: 6000);
            return;
        }

        if (subjects.Count > 0 && (string.IsNullOrWhiteSpace(primarySubjectId) || subjects.All(x => x.SubjectId != primarySubjectId)))
        {
            primarySubjectId = subjects[0].SubjectId;
            canonicalName = subjects[0].DisplayName;
        }

        if (subjects.Count > 1 && (string.IsNullOrWhiteSpace(secondarySubjectId) || secondarySubjectId == primarySubjectId || subjects.All(x => x.SubjectId != secondarySubjectId)))
        {
            secondarySubjectId = subjects.First(x => x.SubjectId != primarySubjectId).SubjectId;
        }
    }

    private async Task RegisterSubjectAsync()
    {
        if (string.IsNullOrWhiteSpace(newSubjectName) || busy)
            return;

        busy = true;
        try
        {
            var result = await ApiClient.RegisterSubjectAsync(new RegisterSubjectRequestDto { DisplayName = newSubjectName.Trim() });
            if (result is not null)
            {
                newSubjectName = string.Empty;
                await LoadSubjectsAsync();
            }
        }
        finally
        {
            busy = false;
        }
    }

    // A card tap on the glance grid opens that person's rename inline in the table below.
    private Task FocusSubjectAsync(string subjectId)
    {
        var target = subjects.FirstOrDefault(s => string.Equals(s.SubjectId, subjectId, StringComparison.OrdinalIgnoreCase));
        if (target is not null)
        {
            editingSubjectId = target.SubjectId;
            editingName = target.DisplayName;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    // Merge is destructive and irreversible, so the confirmation must name the two people the
    // way the rest of the page does ("Person 116"), not by their raw storage id.
    private string FriendlyName(string? subjectId)
    {
        var subject = subjects.FirstOrDefault(x => x.SubjectId == subjectId);
        return subject is null
            ? subjectId ?? string.Empty
            : PoWatch.Client.Services.DisplayText.SubjectName(subject.DisplayName, subject.IsKnownIdentity);
    }

    private void BeginInlineEdit(SubjectProfileDto subject)
    {
        editingSubjectId = subject.SubjectId;
        editingName = subject.DisplayName;
    }

    private void CancelInlineEdit()
    {
        editingSubjectId = null;
        editingName = string.Empty;
    }

    private async Task CommitInlineRenameAsync()
    {
        if (string.IsNullOrWhiteSpace(editingSubjectId) || string.IsNullOrWhiteSpace(editingName))
            return;

        var subjectId = editingSubjectId;
        var newName = editingName.Trim();

        editingSubjectId = null;
        editingName = string.Empty;

        busy = true;
        var result = await ApiClient.RenameSubjectAsync(subjectId, new RenameSubjectRequestDto { NewName = newName });
        busy = false;

        if (result is null)
            NotificationService.Notify(NotificationSeverity.Error, "Rename", "Rename failed.", duration: 5000);
        else
            NotificationService.Notify(NotificationSeverity.Success, "Renamed", $"{result.CanonicalName} — {result.EventsRewritten} events updated.", duration: 4000);

        await LoadSubjectsAsync();
    }

    private async Task MergeAsync()
    {
        if (string.IsNullOrWhiteSpace(primarySubjectId) || string.IsNullOrWhiteSpace(secondarySubjectId))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Merge", "Both primary and secondary subjects are required.", duration: 4000);
            return;
        }

        if (string.Equals(primarySubjectId, secondarySubjectId, StringComparison.OrdinalIgnoreCase))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Merge", "Choose two different subjects to merge.", duration: 4000);
            return;
        }

        var primaryName = FriendlyName(primarySubjectId);
        var secondaryName = FriendlyName(secondarySubjectId);

        var confirmed = await DialogService.Confirm(
            $"Merge '{secondaryName}' into '{primaryName}'? All historical events will be rewritten and the secondary subject will be permanently deleted. This cannot be undone.",
            "Confirm Irreversible Merge",
            new ConfirmOptions { OkButtonText = "Commit Merge", CancelButtonText = "Cancel", CloseDialogOnOverlayClick = true });

        if (confirmed != true)
            return;

        busy = true;

        var merged = await ApiClient.MergeIdentityAsync(new MergeIdentityRequestDto
        {
            PrimarySubjectId = primarySubjectId,
            SecondarySubjectId = secondarySubjectId,
            NewDisplayName = canonicalName
        });

        busy = false;

        if (merged is null)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Merge", "Merge failed.", duration: 5000);
        }
        else
        {
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Merged",
                $"{merged.CanonicalName} now owns {merged.EventsRewritten} events.",
                duration: 5000);
        }

        await LoadSubjectsAsync();
    }
}
