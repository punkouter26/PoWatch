@page "/live-dashboard"
@attribute [Authorize]
@using PoWatch.Shared.Models
@using Microsoft.Extensions.Options
@implements IAsyncDisposable
@inject PoWatch.Client.Services.PoWatchApiClient ApiClient
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IOptions<ClientFeatureFlagsOptions> FeatureFlags

<PageTitle>PoWatch | Overview</PageTitle>

<div class="live-dashboard-page">
    <header class="live-dashboard-header" data-test="live-dashboard-header">
        <div>
            <p class="observer-eyebrow">Everyone at a glance</p>
            <h1>Overview</h1>
            <p class="panel-summary">How everyone is doing right now. Updates on its own every @RefreshIntervalSeconds seconds.</p>
        </div>
        <div class="live-dashboard-controls" data-test="live-dashboard-controls">
            <RadzenTextBox Placeholder="Filter subjects…" @bind-Value="subjectFilter" @oninput="OnFilterInput"
                Class="livedashboard-filter-input" aria-label="Filter subjects by name or activity" data-test="live-dashboard-filter" />
            @if (loading)
            {
                <RadzenProgressBar ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" Class="livedashboard-progress" />
            }
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                Click="RefreshAsync" Disabled="@loading" aria-label="Refresh" data-test="live-dashboard-refresh" />
        </div>
    </header>

    @if (subjects.Count == 0 && !loading)
    {
        <div class="live-dashboard-empty" data-test="live-dashboard-empty">
            <p>No one seen yet. Go to the Live Room to start watching.</p>
        </div>
    }

    @if (subjects.Count > 0 && FilteredSubjects.Count == 0)
    {
        <div class="live-dashboard-empty">
            <p>No subjects match "@subjectFilter".</p>
        </div>
    }

    <div class="subject-card-grid">
        @foreach (var subject in FilteredSubjects)
        {
            var cardClass = GetCardClass(subject);
              <div class="subject-card @cardClass"
                  @onclick="() => NavigateToSubject(subject.SubjectId)"
                  @onkeydown="@(args => HandleSubjectCardKeyDown(args, subject.SubjectId))"
                  role="button"
                  tabindex="0"
                  aria-label="Open subject @subject.DisplayName">
                <div class="subject-card-header">
                    <span class="subject-card-name">@subject.DisplayName</span>
                    @if (subject.UnacknowledgedSignificantCount > 0)
                    {
                        <span class="subject-card-badge subject-card-badge--alert">@subject.UnacknowledgedSignificantCount</span>
                    }
                    @if (subject.LastActivityIsOutlier)
                    {
                        <span class="subject-card-badge subject-card-badge--outlier" title="Something unusual was flagged">⚠ UNUSUAL</span>
                    }
                    @if (!subject.IsKnownIdentity && subject.RecentEvents.Count >= FeatureFlags.Value.TempBadgeMinObservations)
                    {
                        <span class="subject-card-badge subject-card-badge--unknown" title="New person — not named yet">NEW</span>
                    }
                    @if (FeatureFlags.Value.DriftRadarEnabled)
                    {
                        var drift = GetDriftStatus(subject.SubjectId);
                        if (drift is not null && drift.DriftLabel is not "Insufficient Data")
                        {
                            <button class="subject-card-badge subject-card-drift subject-card-drift--@DriftBadgeClass(drift.DriftLabel)"
                                    @onclick="async () => await OpenDriftDetailsAsync(drift)"
                                    @onclick:stopPropagation="true"
                                    title="Drift score @drift.DriftScore.ToString("F0")/100 — click for details">
                                DRIFT · @drift.DriftScore.ToString("F0")
                            </button>
                        }
                    }
                </div>

                <div class="subject-card-activity">
                    <span class="subject-card-label">Last activity</span>
                    <strong class="subject-card-value">@(string.IsNullOrWhiteSpace(subject.LastActivity) ? "No data" : subject.LastActivity)</strong>
                </div>

                <div class="subject-card-meta">
                    <span class="subject-card-label">Last seen</span>
                    <span class="subject-card-value subject-card-mono">@subject.LastSeenUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                </div>

                @if (subject.RecentEvents.Count > 0)
                {
                    var events = subject.RecentEvents.Take(10).Reverse().ToList();
                    var svgW = 72; var svgH = 22;
                    var step = events.Count > 1 ? (double)(svgW - 4) / (events.Count - 1) : svgW - 4;
                    var lastIsOutlier = events.LastOrDefault()?.IsClinicalOutlier == true;
                    var lastIsSignificant = events.LastOrDefault()?.IsSignificant == true;
                    var lineColor = lastIsOutlier ? "#ff7070" : lastIsSignificant ? "#ffa040" : "#38ffa8";
                    var points = string.Join(" ", events.Select((ev, i) =>
                    {
                        var x = 2 + i * step;
                        var y = ev.IsClinicalOutlier ? 3.0 : ev.IsSignificant ? 11.0 : 19.0;
                        return $"{x:F1},{y:F1}";
                    }));
                    <div class="subject-card-sparkline" title="Recent activity trend (newest on right)">
                        <svg width="@svgW" height="@svgH" viewBox="0 0 @svgW @svgH" aria-hidden="true" class="sparkline-svg">
                            <polyline points="@points" fill="none" stroke="@lineColor" stroke-width="1.8"
                                      stroke-linecap="round" stroke-linejoin="round" opacity="0.85" />
                            @{
                                var lastEv = events.LastOrDefault();
                                if (lastEv is not null)
                                {
                                    var lx = 2 + (events.Count - 1) * step;
                                    var ly = lastEv.IsClinicalOutlier ? 3.0 : lastEv.IsSignificant ? 11.0 : 19.0;
                                    <circle cx="@lx.ToString("F1")" cy="@ly.ToString("F1")" r="2.5" fill="@lineColor" opacity="1" />
                                }
                            }
                        </svg>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private const int RefreshIntervalSeconds = 15;

    private List<SubjectLiveStatusDto> subjects = [];
    private List<SubjectDriftStatusDto> _driftStatus = [];
    private bool loading;
    private string subjectFilter = string.Empty;
    private CancellationTokenSource? _timerCts;

    private IReadOnlyList<SubjectLiveStatusDto> FilteredSubjects =>
        string.IsNullOrWhiteSpace(subjectFilter)
            ? subjects
            : subjects
                .Where(s =>
                    s.DisplayName.Contains(subjectFilter, StringComparison.OrdinalIgnoreCase) ||
                    (s.LastActivity ?? string.Empty).Contains(subjectFilter, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private void OnFilterInput(ChangeEventArgs e)
    {
        subjectFilter = e.Value?.ToString() ?? string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        StartAutoRefresh();
    }

    private async Task RefreshAsync()
    {
        loading = true;
        StateHasChanged();
        try
        {
            subjects = [.. await ApiClient.GetLiveDashboardStatusAsync()];

            if (FeatureFlags.Value.DriftRadarEnabled)
            {
                try
                {
                    _driftStatus = [.. await ApiClient.GetDriftStatusAsync()];
                }
                catch
                {
                    // Drift Radar data is non-critical — swallow and continue
                    _driftStatus = [];
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Dashboard", ex.Message, duration: 5000);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private void StartAutoRefresh()
    {
        _timerCts = new CancellationTokenSource();
        var token = _timerCts.Token;

        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try { await Task.Delay(TimeSpan.FromSeconds(RefreshIntervalSeconds), token); }
                catch (OperationCanceledException) { break; }

                await InvokeAsync(RefreshAsync);
            }
        }, token);
    }

    private static string GetCardClass(SubjectLiveStatusDto subject)
    {
        if (subject.LastActivityIsOutlier) return "subject-card--outlier";
        if (subject.UnacknowledgedSignificantCount > 0) return "subject-card--alert";
        return string.Empty;
    }

    // Unified subject pathing (Win #8): tapping a person anywhere in the app lands on the same place —
    // the People page focused on that person — instead of each surface going somewhere different.
    private void NavigateToSubject(string subjectId) =>
        Navigation.NavigateTo($"/identity?focus={Uri.EscapeDataString(subjectId)}");

    private void HandleSubjectCardKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args, string subjectId)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal) ||
            string.Equals(args.Key, " ", StringComparison.Ordinal) ||
            string.Equals(args.Key, "Spacebar", StringComparison.OrdinalIgnoreCase))
        {
            NavigateToSubject(subjectId);
        }
    }

    private SubjectDriftStatusDto? GetDriftStatus(string subjectId) =>
        _driftStatus.FirstOrDefault(d => string.Equals(d.SubjectId, subjectId, StringComparison.OrdinalIgnoreCase));

    private static string DriftBadgeClass(string driftLabel) => driftLabel switch
    {
        "Extreme Deviation" or "High Drift" => "high",
        "Moderate Drift" => "medium",
        "Slight Variation" => "low",
        _ => "normal"
    };

    private async Task OpenDriftDetailsAsync(SubjectDriftStatusDto drift)
    {
        await DialogService.OpenAsync<PoWatch.Client.Shared.DriftDetailPanel>(
            $"Drift Details — {drift.DisplayName}",
            new Dictionary<string, object?> { ["DriftStatus"] = drift },
            new DialogOptions { Width = "640px", Resizable = true, CloseDialogOnOverlayClick = true });
    }

    public ValueTask DisposeAsync()
    {
        _timerCts?.Cancel();
        _timerCts?.Dispose();
        return ValueTask.CompletedTask;
    }
}
