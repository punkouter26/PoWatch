@page "/regulars"
@using System.Globalization
@inject PoWatchApiClient Api
@inject SensingSession Sensing
@inject IJSRuntime JS

<PageTitle>PoWatch | Regulars</PageTitle>

@* One grid: sort by any column, filter by name, rename in place (Enter or leaving the box saves), and
   tick two or more of the same kind to merge them — recognition goes by look, so a change of clothes
   can make someone new. On a phone the secondary columns move into the row's expander. *@
<TerminalPanel Number="R1" Title="Regulars" Test="regulars-board" Flush="true">
    <Aside>@_regulars.Count KNOWN · @_regulars.Count(r => r.IsNamed) NAMED</Aside>
    <ChildContent>
        <div class="regulars-bar">
            <label class="visually-hidden" for="regulars-filter">Filter by name</label>
            <input id="regulars-filter" type="search" placeholder="Filter by name…" @bind="_filter" @bind:event="oninput" autocomplete="off" data-test="regulars-filter" />

            @if (_selected.Count > 0)
            {
                <span class="regulars-merge" data-test="regulars-merge">
                    @if (MergeBlocker is { } blocker)
                    {
                        <span class="term-stat-hint">@_selected.Count SELECTED · @blocker</span>
                    }
                    else
                    {
                        <label for="merge-into">Merge @_selected.Count into</label>
                        <select id="merge-into" @bind="_primaryId">
                            @foreach (var regular in Selected)
                            {
                                <option value="@regular.Id">@regular.DisplayName</option>
                            }
                        </select>
                        <button class="term-button term-button--primary" @onclick="MergeAsync" disabled="@_busy" data-test="merge-selected">@(_busy ? "Merging…" : "Merge")</button>
                    }
                    <button class="term-button" @onclick="() => _selected.Clear()" disabled="@_busy">Clear</button>
                </span>
            }

            @if (_message is not null)
            {
                <span class="@(_failed ? "live-error" : "term-stat-hint")" role="@(_failed ? "alert" : "status")" data-test="regulars-message">@_message</span>
            }
        </div>

        @if (!_loaded)
        {
            <Skeleton Heights="@([260])" />
        }
        else if (_regulars.Count == 0)
        {
            <p class="term-empty">Nobody yet. People, pets and things that keep turning up will appear here.</p>
        }
        else
        {
            <RadzenDataGrid Data="@Shown" TItem="RegularDto" AllowSorting="true" Density="Density.Compact" ExpandMode="DataGridExpandMode.Single"
                            class="regulars-grid" data-test="regulars-table" aria-label="Regulars">
                <Template Context="regular">
                    <div class="regular-detail">
                        <span>KIND <b>@regular.Class</b></span>
                        <span>TODAY <b>@(Today(regular) is { } today ? $"{today.Visits} visits · {DisplayText.Duration(today.DwellSeconds)}" : "not seen")</b></span>
                        <span>FIRST SEEN <b>@When(regular.FirstSeenUtc)</b></span>
                        <span>LAST SEEN <b>@When(regular.LastSeenUtc)</b></span>
                    </div>
                </Template>
                <Columns>
                    <RadzenDataGridColumn TItem="RegularDto" Width="44px" Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="regular">
                            <input type="checkbox" checked="@_selected.Contains(regular.Id)" @onchange="e => Select(regular, e.Value is true)"
                                   aria-label="@($"Select {regular.DisplayName} to merge")" data-test="regular-select" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RegularDto" Property="@nameof(RegularDto.DisplayName)" Title="Name">
                        <Template Context="regular">
                            <div class="regular-name" data-test="regular-row">
                                <label class="visually-hidden" for="rename-@regular.Id">Name for @regular.DisplayName</label>
                                <input id="rename-@regular.Id" @bind="_edits[regular.Id]" @bind:after="() => RenameAsync(regular)"
                                       placeholder="@regular.DisplayName" maxlength="40" autocomplete="off" disabled="@_busy" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RegularDto" Property="@nameof(RegularDto.Class)" Title="Kind" Width="130px" Visible="@_wide" />
                    <RadzenDataGridColumn TItem="RegularDto" Title="Today" Sortable="false" TextAlign="TextAlign.Right" Width="96px" Visible="@_wide">
                        <Template Context="regular">
                            @(Today(regular) is { } today ? $"{today.Visits} · {DisplayText.Duration(today.DwellSeconds)}" : "—")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RegularDto" Property="@nameof(RegularDto.Visits)" Title="Visits" TextAlign="TextAlign.Right" Width="@(_wide ? "100px" : "78px")" />
                    <RadzenDataGridColumn TItem="RegularDto" Property="@nameof(RegularDto.DwellSeconds)" Title="In frame" TextAlign="TextAlign.Right" Width="@(_wide ? "112px" : "92px")">
                        <Template Context="regular">@DisplayText.Duration(regular.DwellSeconds)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RegularDto" Property="@nameof(RegularDto.FirstSeenUtc)" Title="First seen" Width="150px" Visible="@_wide">
                        <Template Context="regular">@When(regular.FirstSeenUtc)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RegularDto" Property="@nameof(RegularDto.LastSeenUtc)" Title="Last seen" Width="150px" Visible="@_wide">
                        <Template Context="regular">@When(regular.LastSeenUtc)</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </ChildContent>
</TerminalPanel>

@code {
    private List<RegularDto> _regulars = [];
    private readonly Dictionary<string, string?> _edits = new(StringComparer.Ordinal);
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private ObjectStatsDto? _today;
    private string _filter = string.Empty;
    private string? _primaryId;
    private string? _message;
    private bool _failed;
    private bool _busy;
    private bool _loaded;

    // ponytail: read once on load, so rotating a phone keeps the layout it opened with; listen for resize if that matters.
    private bool _wide = true;

    private IEnumerable<RegularDto> Shown => string.IsNullOrWhiteSpace(_filter)
        ? _regulars
        : _regulars.Where(r => r.DisplayName.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase));

    private List<RegularDto> Selected => _regulars.Where(r => _selected.Contains(r.Id)).ToList();

    /// <summary>Why the selection cannot be merged yet, or null when it can.</summary>
    private string? MergeBlocker => Selected switch
    {
        { Count: < 2 } => "TICK ANOTHER TO MERGE",
        var chosen when chosen.Select(r => r.Class).Distinct().Count() > 1 => "ONLY THE SAME KIND CAN MERGE",
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        _wide = await JS.TryInvokeAsync<bool?>("powatchMenus.isWide") ?? true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _regulars = [.. await Api.ListRegularsAsync()];
        }
        catch (HttpRequestException)
        {
            Say("COULD NOT LOAD THE REGULARS — THE SERVER DID NOT ANSWER", failed: true);
        }

        _edits.Clear();
        foreach (var regular in _regulars) _edits[regular.Id] = regular.IsNamed ? regular.DisplayName : null;
        _selected.IntersectWith(_regulars.Select(r => r.Id));
        _today = await Api.GetObjectsAsync(StatsQuery.For("today"));
        _loaded = true;
    }

    private RegularStatDto? Today(RegularDto regular) => _today?.Regulars.FirstOrDefault(r => r.Id == regular.Id);

    private static string When(DateTimeOffset utc) => utc.ToLocalTime().ToString("dd MMM HH:mm", CultureInfo.CurrentCulture);

    private void Select(RegularDto regular, bool on)
    {
        if (on) _selected.Add(regular.Id);
        else _selected.Remove(regular.Id);
        // Merge into the one seen most, unless the user picks another.
        if (_primaryId is null || !_selected.Contains(_primaryId))
            _primaryId = Selected.OrderByDescending(r => r.Visits).FirstOrDefault()?.Id;
    }

    private void Say(string message, bool failed = false) => (_message, _failed) = (message, failed);

    private async Task RenameAsync(RegularDto regular)
    {
        var name = string.IsNullOrWhiteSpace(_edits.GetValueOrDefault(regular.Id)) ? null : _edits[regular.Id]!.Trim();
        if (_busy || name == (regular.IsNamed ? regular.DisplayName : null)) return;

        _busy = true;
        try
        {
            if (await Api.RenameRegularAsync(regular.Id, name) is { } renamed)
            {
                Sensing.Live.Rename(renamed);
                Say($"SAVED “{renamed.DisplayName}”");
                await LoadAsync();
            }
            else
            {
                // Put the box back: showing a name that was not saved is worse than losing the typing.
                _edits[regular.Id] = regular.IsNamed ? regular.DisplayName : null;
                Say($"COULD NOT RENAME {regular.DisplayName.ToUpperInvariant()} — NOTHING WAS CHANGED", failed: true);
            }
        }
        catch (HttpRequestException)
        {
            _edits[regular.Id] = regular.IsNamed ? regular.DisplayName : null;
            Say("COULD NOT RENAME — THE SERVER DID NOT ANSWER", failed: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MergeAsync()
    {
        if (_busy || MergeBlocker is not null || _primaryId is not { } primaryId) return;

        _busy = true;
        try
        {
            RegularDto? merged = null;
            foreach (var duplicate in Selected.Where(r => r.Id != primaryId))
            {
                merged = await Api.MergeRegularsAsync(primaryId, duplicate.Id);
                if (merged is null) break;
            }

            if (merged is null) Say("COULD NOT MERGE ALL OF THOSE — CHECK THE LIST", failed: true);
            else Say($"MERGED INTO {merged.DisplayName.ToUpperInvariant()}");
        }
        catch (HttpRequestException)
        {
            Say("COULD NOT MERGE — THE SERVER DID NOT ANSWER", failed: true);
        }
        finally
        {
            _selected.Clear();
            _primaryId = null;
            await LoadAsync();
            _busy = false;
        }
    }
}
