@page "/"
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using PoWatch.Shared.Models
@using Microsoft.Extensions.Options
@inject PoWatch.Client.Services.PoWatchApiClient ApiClient
@inject IJSRuntime JS
@inject NotificationService NotificationService

<PageTitle>PoWatch | Observer Hub</PageTitle>

@if (HasActiveThresholdAlerts && FeatureFlags.Value.AlertThresholdsEnabled)
{
    <div class="threshold-alert-banner">
        <span class="threshold-alert-icon" aria-hidden="true">⚠</span>
        <div class="threshold-alert-list">
            @foreach (var alert in _activeThresholdAlerts)
            {
                <div class="threshold-alert-item">
                    <strong>@alert.RuleName</strong> — @alert.Description
                    <small class="threshold-alert-time">@alert.TriggeredAtUtc.ToLocalTime().ToString("HH:mm:ss")</small>
                    <button class="threshold-alert-dismiss" @onclick="() => DismissThresholdAlert(alert)" aria-label="Dismiss">×</button>
                </div>
            }
        </div>
        <button class="threshold-alert-dismiss-all" @onclick="DismissAllThresholdAlerts">Dismiss all</button>
    </div>
}

<div class="observer-page">
    <section class="observer-hero">
        <div class="observer-hero-copy">
            <div class="observer-title-row">
                <p class="observer-eyebrow">Observer workspace</p>
                <h1>Observer Hub</h1>
            </div>
            <p class="observer-summary">A streamlined view for live monitoring, local inference, and room activity review.</p>
        </div>

        <div class="observer-metrics" role="list" aria-label="Session highlights">
            <div class="metric-card metric-card--status" role="listitem">
                <span class="metric-label">Status</span>
                <strong class="metric-value">@MonitoringStateLabel</strong>
                <small>@SessionDurationText</small>
            </div>
            <div class="metric-card metric-card--model" role="listitem">
                <span class="metric-label">Model</span>
                <strong class="metric-value">@SelectedModelLabel</strong>
                <small>DTYPE @DtypeDisplay</small>
            </div>
            <div class="metric-card metric-card--activity" role="listitem">
                <span class="metric-label">Latest activity</span>
                <strong class="metric-value">@LatestActivityLabel</strong>
                <small>@LatestTimestampLabel</small>
            </div>
        </div>
    </section>

    @if (FeatureFlags.Value.EnableHud)
    {
        <div class="hud-bar">
            <div class="hud-group">
                <span class="hud-group-label">Runtime</span>
                <span class="hud-item">SESSION <span class="hud-val">@SessionDurationText</span></span>
                <span class="hud-item">FRAMES <span class="hud-val">@_frameCount</span></span>
                <span class="hud-item">CYCLE <span class="hud-val">@_hudCycleMs ms</span></span>
                <span class="hud-item">EMA <span class="hud-val">@_emaInferenceMs.ToString("F0") ms</span></span>
                <span class="hud-item">DRIFT <span class="hud-val">@DriftDisplay</span></span>
            </div>
            <div class="hud-group">
                <span class="hud-group-label">Inference</span>
                <span class="hud-item">LAST <span class="hud-val">@LastMsDisplay</span></span>
                <span class="hud-item">COUNT <span class="hud-val">@InferCountDisplay</span></span>
                <span class="hud-item">SKIP <span class="hud-val">@SkipRateDisplay</span></span>
                <span class="hud-item">STRUCT <span class="hud-val">@StructRateDisplay</span></span>
                <span class="hud-item">FP16 <span class="hud-val">@(inferenceDiagnostics?.Fp16FallbackUsed == true ? "FALLBACK" : "OK")</span></span>
                <span class="hud-item">LOAD <span class="hud-val">@LoadTimeDisplay</span></span>
            </div>
            <div class="hud-group">
                <span class="hud-group-label">Engine</span>
                <span class="hud-item">MODEL <span class="hud-val">@_hudModel</span></span>
                <span class="hud-item">BACKEND <span class="hud-val">@_hudBackend</span></span>
                <span class="hud-item">DTYPE <span class="hud-val">@DtypeDisplay</span></span>
                <span class="hud-item">TOKENS <span class="hud-val">@_hudTokenCount</span></span>
                <span class="hud-item">TPS <span class="hud-val">@_hudTokensPerSecond</span></span>
                <span class="hud-item">GPU <span class="hud-val">@(!string.IsNullOrWhiteSpace(_gpuAdapterVendor) ? $"{_gpuAdapterVendor} {_gpuAdapterName}" : _gpuAdapterName)</span></span>
                <span class="hud-item">MEM <span class="hud-val">@_hudMemory</span></span>
            </div>
        </div>
    }

    <div class="sector-grid observer-grid @(monitoring ? "observer-grid--active" : string.Empty)">
        <RadzenCard class="@("panel panel-main" + (monitoring ? " panel--active" : string.Empty))">
            <header class="panel-header observer-panel-header">
                <div>
                    <p class="observer-eyebrow">Live console</p>
                    <h2>Room Feed</h2>
                    <p class="panel-summary">Use the preview and controls below to manage observation capture in real time.</p>
                </div>
                <span class="panel-badge @(monitoring ? "panel-badge--live" : string.Empty)">@MonitoringStateLabel</span>
            </header>

            <div class="nexus-frame @(thinking ? "thinking" : string.Empty)">
                <video @ref="liveCameraFeed" class="live-camera-feed" autoplay muted playsinline poster="media/webcam-fallback.svg" aria-label="Live webcam preview"></video>
                <div class="scanlines @(hasCameraFeed ? string.Empty : "hidden")"></div>
                <div class="video-label @(hasCameraFeed ? string.Empty : "hidden")">LIVE 16:9</div>
                <div class="video-sub">@(monitoring ? "Observation loop active" : "Idle")</div>
            </div>

            <div class="status-strip">
                <span class="status-dot-live @(monitoring ? "status-dot-live--on" : string.Empty)" aria-hidden="true"></span>
                <span class="status-strip-label">@(monitoring ? "RUNNING" : "IDLE")</span>
                @if (thinking)
                {
                    <span class="status-strip-thinking">analysing…</span>
                }
                <div class="mute-toggle">
                    <span>Mute</span>
                    <RadzenSwitch @bind-Value="muted" TValue="bool" />
                </div>
            </div>

            <div class="controls-row">
                <RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Start" Click="StartMonitoringAsync" Disabled="@(monitoring || thinking)" />
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Stop" Click="StopMonitoringAsync" Disabled="@(!monitoring && !thinking)" />
            </div>

            @if (!monitoring && !thinking)
            {
                <div class="setup-row">
                    <label>Inference Model</label>
                    <RadzenDropDown @bind-Value="selectedModelKey" Data="ModelOptions" TextProperty="Label" ValueProperty="Value"
                                    Change="@OnModelSwitched" Style="width:100%;" />
                </div>
                <div class="setup-row">
                    <label>GPU Power Preference</label>
                    <select class="rz-dropdown" style="width:100%;" @onchange="OnGpuPreferenceChangedAsync">
                        <option value="default"          selected="@(_selectedGpuPreference == "default")">Auto (browser default)</option>
                        <option value="high-performance" selected="@(_selectedGpuPreference == "high-performance")">High-performance (discrete / NVIDIA)</option>
                        <option value="low-power"        selected="@(_selectedGpuPreference == "low-power")">Low-power (integrated / Intel)</option>
                    </select>
                </div>
                <div class="setup-row">
                    <label>Poll Interval — <strong>@_livePollingSeconds s</strong></label>
                    <input type="range" style="width:100%;" min="5" max="120" step="5"
                           value="@_livePollingSeconds"
                           @onchange="OnPollingIntervalChangedAsync" />
                </div>
            }

            @if (observerState?.DeveloperModeEnabled == true)
            {
                <div class="dev-tools-row">
                    <button class="dev-tools-toggle" @onclick="@(() => devToolsExpanded = !devToolsExpanded)">
                        @(devToolsExpanded ? "▾" : "▸") Developer Tools
                    </button>
                    @if (devToolsExpanded)
                    {
                        <div class="dev-tools-actions">
                            <RadzenButton ButtonStyle="ButtonStyle.Success" Text="Inject Significant Event" Click="InjectEventAsync" />
                            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Inject Clinical Outlier" Click="InjectOutlierAsync" />
                        </div>
                    }
                </div>
            }
        </RadzenCard>

        <RadzenCard class="panel panel-stats">
            <header class="panel-header observer-panel-header">
                <div>
                    <p class="observer-eyebrow">Telemetry</p>
                    <h2>Live Monitor</h2>
                    <p class="panel-summary">Session health, subject tracking, and LLM processing diagnostics.</p>
                </div>
            </header>

            <section class="stats-section">
                <p class="stats-section-label">Session status</p>
                <div class="monitor-metrics-grid" aria-label="Live monitor telemetry">
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Recording duration</span>
                        <strong class="monitor-metric-value">@RecordingDurationLabel</strong>
                        <small>State: @MonitoringStateLabel</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Person detected</span>
                        <strong class="monitor-metric-value">@PersonDetectedLabel</strong>
                        <small>Model: @SelectedModelLabel</small>
                    </div>
                    <div class="@($"monitor-metric-card {AlertLevelClass}")">
                        <span class="monitor-metric-label">Current alert level</span>
                        <strong class="monitor-metric-value">@AlertLevelLabel</strong>
                        <small>@lastAlertReason</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Last detected event</span>
                        <strong class="monitor-metric-value">@LatestActivityLabel</strong>
                        <small>@LatestTimestampLabel</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">AI confidence</span>
                        <strong class="monitor-metric-value">@ConfidenceDisplayLabel</strong>
                        <small>Inference: @(inferenceDiagnostics?.LastInferenceMs is int ms ? $"{ms} ms" : "Pending")</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Camera health</span>
                        <strong class="monitor-metric-value">@CameraHealthLabel</strong>
                        <small>Device: @(inferenceDiagnostics?.Device?.ToUpperInvariant() ?? "pending")</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Connection and sync</span>
                        <strong class="monitor-metric-value">@ConnectionStatusLabel</strong>
                        <small>@(observerState?.StatusDetail ?? "Observer loop ready for the next local inference poll.")</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Motion level</span>
                        <strong class="monitor-metric-value">@MotionDisplayLabel</strong>
                        <small>@lastInferenceStatus</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Session event count</span>
                        <strong class="monitor-metric-value">@SessionEventCount</strong>
                        <small>@streamItems.Count events listed today</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Privacy and recording</span>
                        <strong class="monitor-metric-value">@PrivacyStatusLabel</strong>
                        <small>Images: @(observerState?.SaveSignificantImages == true ? "saved for important alerts" : "not persisted")</small>
                    </div>
                </div>
            </section>

            <section class="stats-section">
                <p class="stats-section-label">Inference analytics</p>
                <div class="monitor-metrics-grid infer-metrics-grid" aria-label="LLM inference diagnostics">
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Quantization (DTYPE)</span>
                        <strong class="monitor-metric-value">@DtypeDisplay</strong>
                        <small>Device: @(inferenceDiagnostics?.Device?.ToUpperInvariant() ?? "pending")</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Model load time</span>
                        <strong class="monitor-metric-value">@LoadTimeDisplay</strong>
                        <small>State: @(inferenceDiagnostics?.LoadState ?? "idle")</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Inferences (session)</span>
                        <strong class="monitor-metric-value">@InferCountDisplay</strong>
                        <small>Total structured outputs</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Last inference</span>
                        <strong class="monitor-metric-value">@LastMsDisplay</strong>
                        <small>Raw model processing time</small>
                    </div>
                    <div class="monitor-metric-card @(inferenceDiagnostics?.Fp16FallbackUsed == true ? "monitor-metric-card--watch" : string.Empty)">
                        <span class="monitor-metric-label">FP16 fallback</span>
                        <strong class="monitor-metric-value">@Fp16FallbackDisplay</strong>
                        <small>GPU precision mode</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Skip rate</span>
                        <strong class="monitor-metric-value">@SkipRateDisplay</strong>
                        <small>Unchanged / low-quality frames</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Min / max latency</span>
                        <strong class="monitor-metric-value">@MinMaxInferDisplay</strong>
                        <small>Session extremes</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">P95 latency</span>
                        <strong class="monitor-metric-value">@P95LatencyDisplay</strong>
                        <small>95th-percentile inference time</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Struct output rate</span>
                        <strong class="monitor-metric-value">@StructRateDisplay</strong>
                        <small>LABEL: compliant responses</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">EMA drift</span>
                        <strong class="monitor-metric-value">@DriftDisplay</strong>
                        <small>|cycle &minus; EMA| deviation</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Duty cycle</span>
                        <strong class="monitor-metric-value">@DutyCycleDisplay</strong>
                        <small>Active inference / session time</small>
                    </div>
                </div>
            </section>
        </RadzenCard>

        <RadzenCard class="panel panel-activity">
            <header class="panel-header compact observer-panel-header">
                <div>
                    <p class="observer-eyebrow">Timeline</p>
                    <h2>Room Activity</h2>
                    <p class="panel-summary">Recent observations and clinical notes recorded today.</p>
                </div>
                <span class="activity-count">@streamItems.Count events today</span>
            </header>

@if (streamItems.Count == 0)
            {
                <div class="activity-empty">No records to display.</div>
            }
            else
            {
                <ul class="activity-list">
                    @foreach (var item in streamItems)
                    {
                        <li class="activity-item @(item.IsClinicalOutlier ? "activity-item--outlier" : item.IsSignificant ? "activity-item--significant" : string.Empty)">
                            <div class="activity-item-header">
                                <span class="activity-time">@item.ObservedAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                                <span class="activity-subject">@item.SubjectDisplayName</span>
                                @if (item.IsClinicalOutlier)
                                {
                                    <span class="activity-badge activity-badge--outlier">Outlier</span>
                                }
                                else if (item.IsSignificant)
                                {
                                    <span class="activity-badge activity-badge--significant">Significant</span>
                                }
                                <span class="activity-activity">@item.Activity</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.ClinicalDescription))
                            {
                                <div class="activity-note">@item.ClinicalDescription</div>
                            }
                        </li>
                    }
                </ul>
            }
        </RadzenCard>
    </div>
</div>

