@page "/"
@attribute [Authorize]
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using PoWatch.Shared.Models
@using Microsoft.Extensions.Options
@inject PoWatch.Client.Services.PoWatchApiClient ApiClient
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject NavigationManager Navigation

<PageTitle>PoWatch | Observer Hub</PageTitle>

@if (_pipelineHealthLatched)
{
    <div class="pipeline-health-banner pipeline-health-banner--@_pipelineHealthLevel" role="alert" aria-live="assertive">
        <span class="pipeline-health-icon" aria-hidden="true">@(_pipelineHealthLevel == "error" ? "⛔" : "⚠")</span>
        <span class="pipeline-health-text">@_pipelineHealthMessage</span>
        <button class="pipeline-health-dismiss" @onclick="@(() => _pipelineHealthLatched = false)" aria-label="Dismiss pipeline health alert">×</button>
    </div>
}

@if (HasActiveThresholdAlerts && FeatureFlags.Value.AlertThresholdsEnabled)
{
    <ThresholdAlertBanner Alerts="_activeThresholdAlerts"
                          OnDismiss="@(alert => { DismissThresholdAlert(alert); StateHasChanged(); })"
                          OnDismissAll="@(() => { DismissAllThresholdAlerts(); StateHasChanged(); })" />
}

<div class="observer-page">
    @if (FeatureFlags.Value.EnableHud)
    {
        <div class="hud-float-container">
            <button class="hud-float-pill" @onclick="@(() => _hudExpanded = !_hudExpanded)"
                    aria-expanded="@_hudExpanded"
                    aria-label="@(_hudExpanded ? "Collapse diagnostics HUD" : "Expand diagnostics HUD")">
                <span class="hud-float-pill-dot @(monitoring ? string.Empty : "hud-float-pill-dot--idle")"></span>
                <span>@MonitoringStateLabel</span>
                <span class="hud-sep">·</span>
                <span><span class="hud-float-val">@LastMsDisplay</span> ms</span>
                <span class="hud-sep">·</span>
                <span><span class="hud-float-val">@_hudTokensPerSecond</span> TPS</span>
                <span>@(_hudExpanded ? "▾" : "▸")</span>
            </button>
            @if (_hudExpanded)
            {
                <div class="hud-float-expanded">
                    @* HUD owns the live hardware + throughput glance only. Detailed inference
                       analytics (COUNT/SKIP/STRUCT/FP16/LOAD/DTYPE/EMA/DRIFT/P95/DUTY) are owned
                       solely by the "Live Monitor" panel below — no duplication. *@
                    <div class="hud-bar hud-bar--detail">
                        <div class="hud-group hud-group--key">
                            <span class="hud-group-label">Live</span>
                            <span class="hud-item">BACKEND <span class="hud-val">@_hudBackend</span></span>
                            <span class="hud-item">GPU <span class="hud-val">@(!string.IsNullOrWhiteSpace(_gpuAdapterVendor) ? $"{_gpuAdapterVendor} {_gpuAdapterName}" : _gpuAdapterName)</span></span>
                        </div>
                        <div class="hud-group">
                            <span class="hud-group-label">Runtime</span>
                            <span class="hud-item">SESSION <span class="hud-val"><LiveDurationTimer StartedAtUtc="monitoringStartedAtUtc" IdleText="--:--:--" /></span></span>
                            <span class="hud-item">FRAMES <span class="hud-val">@_frameCount</span></span>
                            <span class="hud-item">CYCLE <span class="hud-val">@_hudCycleMs ms</span></span>
                        </div>
                        <div class="hud-group">
                            <span class="hud-group-label">Engine</span>
                            <span class="hud-item">MODEL <span class="hud-val">@_hudModel</span></span>
                            <span class="hud-item">TOKENS <span class="hud-val">@_hudTokenCount</span></span>
                            <span class="hud-item">MEM <span class="hud-val">@_hudMemory</span></span>
                        </div>
                        <span class="hud-note">Full inference analytics → Live Monitor panel</span>
                    </div>
                </div>
            }
        </div>
    }

    <div class="sector-grid observer-grid @(monitoring ? "observer-grid--active" : string.Empty)">
        <RadzenCard class="@("panel panel-main" + (monitoring ? " panel--active" : string.Empty))">
            <header class="panel-header observer-panel-header">
                <div class="panel-header-left">
                    <h2 title="Webcam feed and AI inference controls. Click Start to begin capturing frames and logging activity.">Room Feed</h2>
                    <span class="panel-badge @(monitoring ? "panel-badge--live" : string.Empty)">@MonitoringStateLabel</span>
                    @if (monitoring) { <span class="page-header-time"><LiveDurationTimer StartedAtUtc="monitoringStartedAtUtc" IdleText="--:--:--" /></span> }
                </div>
                <div class="page-header-meta">
                    <span title="Model loaded for local AI inference">@SelectedModelLabel &middot; @DtypeDisplay</span>
                    @if (!monitoring && !thinking)
                    {
                        <span class="help-tip" title="1. Select your AI model and GPU preference below. 2. Click Start to begin webcam capture and inference. 3. Each cycle captures a frame, runs local AI, and logs the detected activity. Significant events are flagged automatically.">? How to use</span>
                    }
                </div>
            </header>

            <div class="controls-row controls-row--primary">
                <RadzenButton ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" Text="▶ Start Monitoring" Click="StartMonitoringAsync" Disabled="@(monitoring || thinking || !ObservationLoopEnabled)" data-test="observer-start" />
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Large" Text="■ Stop" Click="StopMonitoringAsync" Disabled="@(!monitoring && !thinking)" data-test="observer-stop" />
                <div class="status-strip">
                    <span class="status-dot-live @(monitoring ? "status-dot-live--on" : string.Empty)" aria-hidden="true"></span>
                    <span class="status-strip-label">@(monitoring ? "RUNNING" : "IDLE")</span>
                    @if (thinking) { <span class="status-strip-thinking">analysing…</span> }
                    <div class="mute-toggle">
                        <span>Mute</span>
                        <RadzenSwitch @bind-Value="muted" TValue="bool" />
                    </div>
                </div>
            </div>

            @if (!ObservationLoopEnabled)
            {
                <div class="observer-disabled-note">Monitoring is disabled by the current feature flags.</div>
            }

            <div class="nexus-frame @(thinking ? "thinking" : string.Empty)">
                <video @ref="liveCameraFeed" class="live-camera-feed" autoplay muted playsinline poster="media/webcam-fallback.svg" aria-label="Live webcam preview"></video>
                <div class="scanlines @(hasCameraFeed ? string.Empty : "hidden")"></div>
                <div class="video-label @(hasCameraFeed ? string.Empty : "hidden")">LIVE 16:9</div>
                <div class="video-sub">@(monitoring ? "Observation loop active" : "Idle")</div>
            </div>

            @if (!monitoring && !thinking)
            {
                <ObserverSetupPanel IsMonitoring="monitoring"
                                    IsThinking="thinking"
                                    SelectedModelKey="selectedModelKey"
                                    SelectedModelKeyChanged="@(v => selectedModelKey = v)"
                                    ModelOptions="@ModelOptions.Select(o => new ObserverSetupPanel.ModelOption(o.Value, o.Label)).ToList()"
                                    GpuPreference="_selectedGpuPreference"
                                    PollingSeconds="_livePollingSeconds"
                                    ShowDevTools="@(observerState?.DeveloperModeEnabled == true)"
                                    OnModelChanged="OnModelSwitched"
                                    OnGpuPreferenceChanged="OnGpuPreferenceChangedAsync"
                                    OnPollingChanged="OnPollingIntervalChangedAsync"
                                    OnInjectEvent="InjectEventAsync"
                                    OnInjectOutlier="InjectOutlierAsync" />
            }

            @* Live session metrics are owned solely by the "Live Monitor" panel to avoid duplication. *@

        </RadzenCard>

        <RadzenCard class="panel panel-activity">
            <header class="panel-header compact observer-panel-header">
                <h2 title="Chronological log of all AI-detected activities today. Green = normal, orange = significant, red = outlier.">Room Activity</h2>
                <span class="activity-count">@streamItems.Count today</span>
            </header>

            <div class="activity-scroll-region">
                <ActivityTimeline Items="@streamItems" ShowSubjectBadge="true" EmptyMessage="No activity recorded yet. Start monitoring to capture events." />
            </div>

            <div class="subjects-in-panel" aria-label="All detected subjects">
                <div class="subjects-strip-header">
                    <span class="stats-section-label" title="All subjects detected across all monitoring sessions. TEMP = unidentified subject awaiting a name. Click a card to manage identities.">Subjects</span>
                    @if (_subjectsLoading) { <RadzenProgressBar ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" Style="height:3px; width:50px; align-self:center;" /> }
                    <RadzenTextBox Placeholder="Filter…" @bind-Value="_subjectFilter" @oninput="OnSubjectFilterInput" Style="width:120px;" aria-label="Filter subjects" />
                    <a href="/identity" class="subjects-manage-link" title="Add known subjects, rename TEMP subjects, or merge duplicate identities">Manage identities →</a>
                </div>
                <div class="subjects-mini-row">
                    @if (_liveSubjects.Count == 0 && !_subjectsLoading)
                    {
                        <div class="subjects-empty">No subjects detected yet — start monitoring to begin tracking.</div>
                    }
                    @foreach (var subject in FilteredLiveSubjects)
                    {
                        var subCardClass = GetSubjectCardClass(subject);
                        <div @key="subject.SubjectId" class="subject-card subject-card--mini @subCardClass"
                             @onclick="() => NavigateToManageSubject(subject.SubjectId)"
                             role="button" tabindex="0"
                             @onkeydown="@((e) => { if (e.Key == "Enter" || e.Key == " ") NavigateToManageSubject(subject.SubjectId); })"
                             title="@subject.DisplayName — @(subject.LastActivity ?? "No activity") — last seen @subject.LastSeenUtc.ToLocalTime().ToString("HH:mm:ss")">
                            <div class="subject-card-header">
                                <span class="subject-card-name">@subject.DisplayName</span>
                                @if (subject.UnacknowledgedSignificantCount > 0)
                                {
                                    <span class="subject-card-badge subject-card-badge--alert">@subject.UnacknowledgedSignificantCount</span>
                                }
                                @if (subject.LastActivityIsOutlier)
                                {
                                    <span class="subject-card-badge subject-card-badge--outlier">!</span>
                                }
                                @if (!subject.IsKnownIdentity && subject.RecentEvents.Count >= FeatureFlags.Value.TempBadgeMinObservations)
                                {
                                    <span class="subject-card-badge subject-card-badge--unknown">TEMP</span>
                                }
                            </div>
                            <div class="subject-card-activity">
                                <strong>@(string.IsNullOrWhiteSpace(subject.LastActivity) ? "No data" : subject.LastActivity)</strong>
                            </div>
                            <div class="subject-card-meta">
                                <span>@subject.LastSeenUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </RadzenCard>

        <RadzenCard class="panel panel-stats">
            <header class="panel-header observer-panel-header">
                <h2 title="Real-time session health and LLM processing diagnostics. All metrics reset each time you click Start.">Live Monitor</h2>
            </header>

            <section class="stats-section">
                <p class="stats-section-label">Session status</p>
                <div class="monitor-metrics-grid" aria-label="Live monitor telemetry">
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Recording duration</span>
                        <strong class="monitor-metric-value"><LiveDurationTimer StartedAtUtc="monitoringStartedAtUtc" /></strong>
                        <small>State: @MonitoringStateLabel</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Person detected</span>
                        <strong class="monitor-metric-value">@PersonDetectedLabel</strong>
                        <small>Model: @SelectedModelLabel</small>
                    </div>
                    <div class="@($"monitor-metric-card {AlertLevelClass}")">
                        <span class="monitor-metric-label">Current alert level</span>
                        <strong class="monitor-metric-value">@AlertLevelLabel</strong>
                        <small>@lastAlertReason</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Last detected event</span>
                        <strong class="monitor-metric-value">@LatestActivityLabel</strong>
                        <small>@LatestTimestampLabel</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">AI confidence</span>
                        <strong class="monitor-metric-value">@ConfidenceDisplayLabel</strong>
                        <small>Inference: @(inferenceDiagnostics?.LastInferenceMs is int ms ? $"{ms} ms" : "Pending")</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Camera health</span>
                        <strong class="monitor-metric-value">@CameraHealthLabel</strong>
                        <small>Device: @(inferenceDiagnostics?.Device?.ToUpperInvariant() ?? "pending")</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Connection and sync</span>
                        <strong class="monitor-metric-value">@ConnectionStatusLabel</strong>
                        <small>@(observerState?.StatusDetail ?? "Observer loop ready for the next local inference poll.")</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Motion level</span>
                        <strong class="monitor-metric-value">@MotionDisplayLabel</strong>
                        <small>@lastInferenceStatus</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Session event count</span>
                        <strong class="monitor-metric-value">@SessionEventCount</strong>
                        <small>@streamItems.Count events listed today</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Privacy and recording</span>
                        <strong class="monitor-metric-value">@PrivacyStatusLabel</strong>
                        <small>Images: @(observerState?.SaveSignificantImages == true ? "saved for important alerts" : "not persisted")</small>
                    </div>
                </div>
            </section>

            @* Tiering (idea 1): the 11 deep-diagnostic cards are collapsed by default so the glance
               view stays dense with operational state, not telemetry. One click reveals the debug tier. *@
            <CollapsibleSection Title="Inference analytics" InitiallyExpanded="false">
                <div class="monitor-metrics-grid infer-metrics-grid" aria-label="LLM inference diagnostics">
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Quantization (DTYPE)</span>
                        <strong class="monitor-metric-value">@DtypeDisplay</strong>
                        <small>Device: @(inferenceDiagnostics?.Device?.ToUpperInvariant() ?? "pending")</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Model load time</span>
                        <strong class="monitor-metric-value">@LoadTimeDisplay</strong>
                        <small>State: @(inferenceDiagnostics?.LoadState ?? "idle")</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Inferences (session)</span>
                        <strong class="monitor-metric-value">@InferCountDisplay</strong>
                        <small>Total structured outputs</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Last inference</span>
                        <strong class="monitor-metric-value">@LastMsDisplay</strong>
                        <small>Raw model processing time</small>
                    </div>
                    <div class="monitor-metric-card @(inferenceDiagnostics?.Fp16FallbackUsed == true ? "monitor-metric-card--watch" : string.Empty)">
                        <span class="monitor-metric-label">FP16 fallback</span>
                        <strong class="monitor-metric-value">@Fp16FallbackDisplay</strong>
                        <small>GPU precision mode</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Skip rate</span>
                        <strong class="monitor-metric-value">@SkipRateDisplay</strong>
                        <small>Unchanged / low-quality frames</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Min / max latency</span>
                        <strong class="monitor-metric-value">@MinMaxInferDisplay</strong>
                        <small>Session extremes</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">P95 latency</span>
                        <strong class="monitor-metric-value">@P95LatencyDisplay</strong>
                        <small>95th-percentile inference time</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Struct output rate</span>
                        <strong class="monitor-metric-value">@StructRateDisplay</strong>
                        <small>LABEL: compliant responses</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">EMA drift</span>
                        <strong class="monitor-metric-value">@DriftDisplay</strong>
                        <small>|cycle &minus; EMA| deviation</small>
                    </div>
                    <div class="monitor-metric-card">
                        <span class="monitor-metric-label">Duty cycle</span>
                        <strong class="monitor-metric-value">@DutyCycleDisplay</strong>
                        <small>Active inference / session time</small>
                    </div>
                </div>
            </CollapsibleSection>
        </RadzenCard>
    </div>
</div>

