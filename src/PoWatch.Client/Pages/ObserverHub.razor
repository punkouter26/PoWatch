@page "/"
@attribute [Authorize]
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using PoWatch.Shared.Models
@using Microsoft.Extensions.Options
@inject PoWatch.Client.Services.PoWatchApiClient ApiClient
@inject PoWatch.Client.Services.UserPreferencesService UserPrefs
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager Navigation

<PageTitle>PoWatch | Live Room</PageTitle>

<RoomAlertOverlay Visible="@_alertOverlayVisible"
                  SubjectName="@_alertOverlaySubject"
                  Reason="@_alertOverlayReason"
                  ActivityLabel="@_alertOverlayActivity"
                  TimeLabel="@_alertOverlayTime"
                  ImageDataUrl="@_alertOverlayImage"
                  OnAcknowledge="AcknowledgeAlertOverlay"
                  OnViewSubject="ViewAlertSubject" />

@* Consolidation #7: ONE inline alert strip for every non-critical warning (pipeline health +
   threshold alerts share the same visual language); the full-screen overlay above is reserved
   for critical events. *@
@if (_pipelineHealthLatched || (HasActiveThresholdAlerts && FeatureFlags.Value.AlertThresholdsEnabled))
{
    <div class="alert-strip">
        @if (_pipelineHealthLatched)
        {
            <div class="threshold-alert-banner threshold-alert-banner--@_pipelineHealthLevel" role="alert" aria-live="assertive">
                <span class="threshold-alert-icon" aria-hidden="true">@(_pipelineHealthLevel == "error" ? "⛔" : "⚠")</span>
                <div class="threshold-alert-list">
                    <div class="threshold-alert-item">@_pipelineHealthMessage</div>
                </div>
                <button class="threshold-alert-dismiss" @onclick="@(() => _pipelineHealthLatched = false)" aria-label="Dismiss pipeline health alert">×</button>
            </div>
        }
        @if (HasActiveThresholdAlerts && FeatureFlags.Value.AlertThresholdsEnabled)
        {
            <ThresholdAlertBanner Alerts="_activeThresholdAlerts"
                                  OnDismiss="@(alert => { DismissThresholdAlert(alert); StateHasChanged(); })"
                                  OnDismissAll="@(() => { DismissAllThresholdAlerts(); StateHasChanged(); })" />
        }
    </div>
}

<div class="observer-page">
    @* Fix #2: a pinned start-failure card. Toast-only feedback for a failed Start was invisible
       on a kiosk — the page silently returned to Standby and the operator thought monitoring was
       live. This card stays until dismissed, shows the timestamp + reason, and points to the
       most common fix (camera permission). *@
    @if (HasLastAttemptFailure)
    {
        <div class="startup-error-card" role="alert" aria-live="assertive" data-test="startup-error-card">
            <div class="startup-error-icon" aria-hidden="true">📷</div>
            <div class="startup-error-body">
                <strong class="startup-error-title">Couldn't start watching</strong>
                <p class="startup-error-message">@_lastAttemptFailure</p>
                @if (_lastAttemptAtUtc is { } ts)
                {
                    <p class="startup-error-meta">Attempted at @ts.ToLocalTime().ToString("HH:mm:ss") · Check that no other app is using the camera, then try Start again.</p>
                }
            </div>
            <button class="startup-error-dismiss" @onclick="@(() => { _lastAttemptFailure = null; _lastAttemptAtUtc = null; StateHasChanged(); })"
                    aria-label="Dismiss start-failure notice">×</button>
        </div>
    }

    @* Calm-state hero: THE single owner of monitoring state and start/stop (consolidation #2/#3).
       The subline also carries person-detection so no separate summary panel is needed. *@
    <section class="room-status-hero room-status-hero--@RoomStatusKey" aria-live="polite" data-test="room-status-hero">
        <div class="room-status-orb" aria-hidden="true">
            <span class="room-status-orb-core"></span>
        </div>
        <div class="room-status-copy">
            <p class="room-status-eyebrow">@(thinking ? "Checking…" : monitoring ? "Live · watching" : "Standby")</p>
            <h1 class="room-status-headline">@RoomStatusHeadline</h1>
            <p class="room-status-subline">@RoomStatusSubline</p>
        </div>
        <div class="room-status-actions">
            @if (!monitoring && !thinking)
            {
                <RadzenButton ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium" Text="▶ Start watching"
                              Click="StartMonitoringAsync" Disabled="@(!ObservationLoopEnabled)" data-test="hero-start" />
            }
            else
            {
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Medium" Text="■ Stop"
                              Click="StopMonitoringAsync" data-test="hero-stop" />
            }
            <RadzenButton ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium" Icon="assignment" Text="End shift"
                          Click="StartHandoff" data-test="hero-handoff" title="Generate a one-tap handoff brief for the next caregiver" />
        </div>
    </section>

    <div class="sector-grid observer-grid @(monitoring ? "observer-grid--active" : string.Empty)">
        <RadzenCard class="@("panel panel-main" + (monitoring ? " panel--active" : string.Empty))">
            <header class="panel-header observer-panel-header">
                <div class="panel-header-left">
                    <h2 title="Live webcam feed. Use ▶ Start watching above to begin.">Room Feed</h2>
                    @if (monitoring) { <span class="page-header-time"><LiveDurationTimer StartedAtUtc="monitoringStartedAtUtc" IdleText="--:--:--" /></span> }
                </div>
                <div class="page-header-meta">
                    <label for="observer-mute" class="mute-label">Mute audio</label>
                    <RadzenSwitch id="observer-mute" @bind-Value="muted" TValue="bool"
                                  aria-label="Mute or unmute audio notifications for new observations" />
                    <button class="settings-gear" @onclick="@(() => _settingsOpen = true)"
                            title="Observer settings — model, GPU & check interval"
                            aria-label="Open observer settings" data-test="observer-settings-gear">⚙</button>
                </div>
            </header>

            @if (!ObservationLoopEnabled)
            {
                <div class="observer-disabled-note">Monitoring is disabled by the current feature flags.</div>
            }

            @* Plain, unfiltered camera view (special effects removed 2026-07-22). *@
            <div class="nexus-frame">
                <video @ref="liveCameraFeed" class="live-camera-feed" autoplay muted playsinline poster="media/webcam-fallback.svg" aria-label="Live webcam preview"></video>
                <div class="video-sub">@(monitoring ? "Observation loop active" : "Idle")</div>
            </div>

            @* Live model telemetry: what the on-device model is doing and how well it's keeping up.
               Values refresh every observation cycle (RefreshDiagnosticsAsync + StateHasChanged). *@
            <div class="model-stats-strip" data-test="model-stats-strip" aria-label="Live model processing stats">
                <div class="model-stat" title="Vision model running locally in this browser tab">
                    <span class="model-stat-label">Model</span>
                    <span class="model-stat-value">@SelectedModelLabel</span>
                    <span class="model-stat-sub">@ModelLoadStateDisplay</span>
                </div>
                <div class="model-stat @(EngineDegraded ? "model-stat--warn" : string.Empty)" title="Where inference runs: WebGPU (fast) or WASM/CPU fallback (slower). Warns when fp16 fell back to fp32 or no GPU is in use.">
                    <span class="model-stat-label">Engine</span>
                    <span class="model-stat-value">@EngineDisplay</span>
                    <span class="model-stat-sub">@EngineSubDisplay</span>
                </div>
                <div class="model-stat" title="Time the model took to analyse the most recent frame; below it, the smoothed average of the whole check cycle including sync">
                    <span class="model-stat-label">Last analysis</span>
                    <span class="model-stat-value">@LastMsDisplay</span>
                    <span class="model-stat-sub">@AvgCycleDisplay</span>
                </div>
                <div class="model-stat" title="95% of frame analyses finish within this time (rolling window of the last 100 checks)">
                    <span class="model-stat-label">p95 latency</span>
                    <span class="model-stat-value">@P95LatencyDisplay</span>
                    <span class="model-stat-sub">min/max @MinMaxInferDisplay</span>
                </div>
                <div class="model-stat" title="Checks this session; skipped = frame unchanged or too low-quality to be worth analysing">
                    <span class="model-stat-label">Checks</span>
                    <span class="model-stat-value">@_totalCycles</span>
                    <span class="model-stat-sub">skipped @SkipRateDisplay</span>
                </div>
                <div class="model-stat" title="How often the model returned a well-formed structured answer, and its confidence in the latest one">
                    <span class="model-stat-label">Reply quality</span>
                    <span class="model-stat-value">@StructRateDisplay</span>
                    <span class="model-stat-sub">@ConfidenceTrustLabel</span>
                </div>
            </div>

            @* A 100%-skip run used to be indistinguishable from a healthy idle loop: the counters
               ticked up, nothing reached storage, and the status line blamed the camera. Say plainly
               that the model is the problem, and show its actual reply so the gate is identifiable. *@
            @if (AllCyclesRejected)
            {
                <div class="inference-stall" role="alert" data-test="inference-stall">
                    <strong>Nothing is being recorded — the model's replies are all being rejected.</strong>
                    <p>
                        @_totalCycles checks ran and none produced a usable answer, so no observations
                        were saved. This is a model-output problem, not a camera problem.
                    </p>
                    <p class="inference-stall-reason" data-test="inference-stall-reason">
                        Reason: <code>@lastSyncStatus</code>
                    </p>
                    @if (!string.IsNullOrWhiteSpace(lastRejectedOutput))
                    {
                        <p class="inference-stall-label">The model actually replied:</p>
                        <pre class="inference-stall-raw" data-test="inference-stall-raw">@lastRejectedOutput</pre>
                    }
                </div>
            }
        </RadzenCard>

        <PoPanel Glass="true" Title="Room Activity"
                  Badge="@($"{streamItems.Count} today")"
                  BadgeClass="@(streamItems.Count > 0 ? "po-panel-badge--live" : null)">

            @* Clear data — deletes ALL observations, people, and saved images (there is no
               targeted delete). Gated on the SERVER's developer mode (DeveloperBypassAuth), the
               same signal the inject-event dev tools use — the client-only ExposeDebugDetailsInUi
               flag is unreliable because the WASM app never loads the Development appsettings.
               The server AllowDataReset flag is the real guard on the endpoint, off in production. *@
            @if (observerState?.DeveloperModeEnabled == true)
            {
                <div class="activity-clear-row">
                    <RadzenButton Text="@(_clearingData ? "Clearing…" : "Clear data")" Icon="delete_sweep"
                                  ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                  Click="ClearDataAsync" Disabled="@_clearingData"
                                  title="Delete all recorded activity, people, and images (cannot be undone)"
                                  data-test="live-clear-data" />
                </div>
            }

            <div class="activity-scroll-region">
                <ActivityTimeline Items="@streamItems" ShowSubjectBadge="true" EmptyMessage="No activity recorded yet. Start monitoring to capture events." />
            </div>

            @* Consolidation #9: a single row of TODAY's people. The full library (with filter,
               rename, merge) lives on the People page — one home per capability. *@
            <div class="subjects-in-panel" aria-label="People seen today">
                <div class="subjects-strip-header">
                    <span class="stats-section-label" title="People seen in the last 24 hours. Tap a card to name or manage them.">People today</span>
                    @if (_subjectsLoading) { <RadzenProgressBar ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" Class="subjects-loading-progress" /> }
                    <a href="/identity" class="subjects-manage-link" title="See everyone, name a new person, or merge duplicates">All people →</a>
                </div>
                <div class="subjects-mini-row">
                    @if (RecentLiveSubjects.Count == 0 && !_subjectsLoading)
                    {
                        <div class="subjects-empty">No one seen today yet — start watching to begin tracking.</div>
                    }
                    @foreach (var subject in RecentLiveSubjects)
                    {
                        var subCardClass = GetSubjectCardClass(subject);
                        <div @key="subject.SubjectId" class="subject-card subject-card--mini @subCardClass"
                             @onclick="() => NavigateToManageSubject(subject.SubjectId)"
                             role="button" tabindex="0"
                             @onkeydown="@((e) => { if (e.Key == "Enter" || e.Key == " ") NavigateToManageSubject(subject.SubjectId); })"
                             title="@PoWatch.Client.Services.DisplayText.SubjectName(subject.DisplayName, subject.IsKnownIdentity) — @PoWatch.Client.Services.DisplayText.Activity(subject.LastActivity) — last seen @subject.LastSeenUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">
                            <div class="subject-card-header">
                                <span class="subject-card-name">@PoWatch.Client.Services.DisplayText.SubjectName(subject.DisplayName, subject.IsKnownIdentity)</span>
                                @if (subject.UnacknowledgedSignificantCount > 0)
                                {
                                    <span class="subject-card-badge subject-card-badge--alert">@subject.UnacknowledgedSignificantCount</span>
                                }
                                @if (subject.LastActivityIsOutlier)
                                {
                                    <span class="subject-card-badge subject-card-badge--outlier" title="Something unusual was flagged">!</span>
                                }
                                @if (!subject.IsKnownIdentity
                                     && subject.RecentEvents.Count >= FeatureFlags.Value.TempBadgeMinObservations
                                     && PoWatch.Client.Services.DisplayText.IsRecent(subject.LastSeenUtc))
                                {
                                    <span class="subject-card-badge subject-card-badge--unknown" title="New person — not named yet">NEW</span>
                                }
                            </div>
                            <div class="subject-card-activity">
                                <strong>@PoWatch.Client.Services.DisplayText.Activity(subject.LastActivity)</strong>
                            </div>
                            <div class="subject-card-meta">
                                <span>@PoWatch.Client.Services.DisplayText.RelativeTime(subject.LastSeenUtc)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </PoPanel>
    </div>
</div>

@* Consolidation #5: model/GPU/polling setup and developer tools live in a slide-over settings
   drawer, off the daily-use screen. Opened via the ⚙ in the Room Feed header. *@
@if (_settingsOpen)
{
    <div class="settings-drawer-backdrop" @onclick="@(() => _settingsOpen = false)"></div>
    <aside class="settings-drawer" role="dialog" aria-label="Observer settings" data-test="observer-settings-drawer">
        <header class="settings-drawer-header">
            <h2>Observer settings</h2>
            <button class="settings-drawer-close" @onclick="@(() => _settingsOpen = false)" aria-label="Close settings">×</button>
        </header>
        @if (monitoring || thinking)
        {
            <p class="settings-drawer-note">Stop watching to change the model, GPU preference, or check interval.</p>
        }
        else
        {
            <ObserverSetupPanel IsMonitoring="monitoring"
                                IsThinking="thinking"
                                SelectedModelKey="selectedModelKey"
                                SelectedModelKeyChanged="@(v => selectedModelKey = v)"
                                ModelOptions="@ModelOptions.Select(o => new ObserverSetupPanel.ModelOption(o.Value, o.Label)).ToList()"
                                GpuPreference="_selectedGpuPreference"
                                PollingSeconds="_livePollingSeconds"
                                ShowDevTools="@(observerState?.DeveloperModeEnabled == true)"
                                OnModelChanged="OnModelSwitched"
                                OnGpuPreferenceChanged="OnGpuPreferenceChangedAsync"
                                OnPollingChanged="OnPollingIntervalChangedAsync"
                                OnInjectEvent="InjectEventAsync"
                                OnInjectOutlier="InjectOutlierAsync" />
        }
    </aside>
}
