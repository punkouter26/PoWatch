@page "/"
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using PoWatch.Shared.Models
@inject PoWatch.Client.Services.PoWatchApiClient ApiClient
@inject IJSRuntime JS
@inject NotificationService NotificationService

<PageTitle>PoWatch | Observer Hub</PageTitle>

<div class="observer-page">
    <section class="observer-hero">
        <div class="observer-hero-copy">
            <p class="observer-eyebrow">Observer workspace</p>
            <h1>Observer Hub</h1>
            <p class="observer-summary">A streamlined view for live monitoring, local inference, and room activity review.</p>
        </div>

        <div class="observer-metrics">
            <div class="metric-card">
                <span class="metric-label">Status</span>
                <strong class="metric-value">@MonitoringStateLabel</strong>
            </div>
            <div class="metric-card">
                <span class="metric-label">Model</span>
                <strong class="metric-value">@SelectedModelLabel</strong>
            </div>
            <div class="metric-card">
                <span class="metric-label">Latest activity</span>
                <strong class="metric-value">@LatestActivityLabel</strong>
                <small>@LatestTimestampLabel</small>
            </div>
        </div>
    </section>

    <div class="sector-grid observer-grid @(monitoring ? "observer-grid--active" : string.Empty)">
        <RadzenCard class="@("panel panel-main" + (monitoring ? " panel--active" : string.Empty))">
            <header class="panel-header observer-panel-header">
                <div>
                    <p class="observer-eyebrow">Live console</p>
                    <h2>Room Feed</h2>
                    <p class="panel-summary">Use the preview and controls below to manage observation capture in real time.</p>
                </div>
                <span class="panel-badge @(monitoring ? "panel-badge--live" : string.Empty)">@MonitoringStateLabel</span>
            </header>

            <div class="nexus-frame @(thinking ? "thinking" : string.Empty)">
                <video @ref="liveCameraFeed" class="live-camera-feed" autoplay muted playsinline poster="media/webcam-fallback.svg" aria-label="Live webcam preview"></video>
                <div class="scanlines @(hasCameraFeed ? string.Empty : "hidden")"></div>
                <div class="video-label @(hasCameraFeed ? string.Empty : "hidden")">LIVE 16:9</div>
                <div class="video-sub">@(monitoring ? "Observation loop active" : "Idle")</div>
            </div>

            <div class="status-strip">
                <span class="status-dot-live @(monitoring ? "status-dot-live--on" : string.Empty)" aria-hidden="true"></span>
                <span class="status-strip-label">@(monitoring ? "RUNNING" : "IDLE")</span>
                @if (thinking)
                {
                    <span class="status-strip-thinking">analysing…</span>
                }
                <div class="mute-toggle">
                    <span>Mute</span>
                    <RadzenSwitch @bind-Value="muted" TValue="bool" />
                </div>
            </div>

            <div class="controls-row">
                <RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Start" Click="StartMonitoringAsync" Disabled="@(monitoring || thinking)" />
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Stop" Click="StopMonitoringAsync" Disabled="@(!monitoring && !thinking)" />
            </div>

            <div class="monitor-metrics-grid" aria-label="Live monitor telemetry">
                <div class="monitor-metric-card">
                    <span class="monitor-metric-label">Recording duration</span>
                    <strong class="monitor-metric-value">@RecordingDurationLabel</strong>
                    <small>State: @MonitoringStateLabel</small>
                </div>
                <div class="monitor-metric-card">
                    <span class="monitor-metric-label">Person detected</span>
                    <strong class="monitor-metric-value">@PersonDetectedLabel</strong>
                    <small>Model: @SelectedModelLabel</small>
                </div>
                <div class="@($"monitor-metric-card {AlertLevelClass}")">
                    <span class="monitor-metric-label">Current alert level</span>
                    <strong class="monitor-metric-value">@AlertLevelLabel</strong>
                    <small>@lastAlertReason</small>
                </div>
                <div class="monitor-metric-card">
                    <span class="monitor-metric-label">Last detected event</span>
                    <strong class="monitor-metric-value">@LatestActivityLabel</strong>
                    <small>@LatestTimestampLabel</small>
                </div>
                <div class="monitor-metric-card">
                    <span class="monitor-metric-label">AI confidence</span>
                    <strong class="monitor-metric-value">@ConfidenceDisplayLabel</strong>
                    <small>Inference: @(inferenceDiagnostics?.LastInferenceMs is int ms ? $"{ms} ms" : "Pending")</small>
                </div>
                <div class="monitor-metric-card">
                    <span class="monitor-metric-label">Camera health</span>
                    <strong class="monitor-metric-value">@CameraHealthLabel</strong>
                    <small>Device: @(inferenceDiagnostics?.Device?.ToUpperInvariant() ?? "pending")</small>
                </div>
                <div class="monitor-metric-card">
                    <span class="monitor-metric-label">Connection and sync</span>
                    <strong class="monitor-metric-value">@ConnectionStatusLabel</strong>
                    <small>@(observerState?.StatusDetail ?? "Local monitor ready")</small>
                </div>
                <div class="monitor-metric-card">
                    <span class="monitor-metric-label">Motion level</span>
                    <strong class="monitor-metric-value">@MotionDisplayLabel</strong>
                    <small>@lastInferenceStatus</small>
                </div>
                <div class="monitor-metric-card">
                    <span class="monitor-metric-label">Session event count</span>
                    <strong class="monitor-metric-value">@SessionEventCount</strong>
                    <small>@streamItems.Count events listed today</small>
                </div>
                <div class="monitor-metric-card">
                    <span class="monitor-metric-label">Privacy and recording</span>
                    <strong class="monitor-metric-value">@PrivacyStatusLabel</strong>
                    <small>Images: @(observerState?.SaveSignificantImages == true ? "saved for important alerts" : "not persisted")</small>
                </div>
            </div>

            @if (!monitoring && !thinking)
            {
                <div class="setup-row">
                    <label>Inference Model</label>
                    <RadzenDropDown @bind-Value="selectedModelKey" Data="ModelOptions" TextProperty="Label" ValueProperty="Value"
                                    Change="@OnModelSwitched" Style="width:100%;" />
                </div>
            }

            @if (observerState?.DeveloperModeEnabled == true)
            {
                <div class="dev-tools-row">
                    <button class="dev-tools-toggle" @onclick="@(() => devToolsExpanded = !devToolsExpanded)">
                        @(devToolsExpanded ? "▾" : "▸") Developer Tools
                    </button>
                    @if (devToolsExpanded)
                    {
                        <div class="dev-tools-actions">
                            <RadzenButton ButtonStyle="ButtonStyle.Success" Text="Inject Significant Event" Click="InjectEventAsync" />
                            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Inject Clinical Outlier" Click="InjectOutlierAsync" />
                        </div>
                    }
                </div>
            }
        </RadzenCard>

        <RadzenCard class="panel panel-activity">
            <header class="panel-header compact observer-panel-header">
                <div>
                    <p class="observer-eyebrow">Timeline</p>
                    <h2>Room Activity</h2>
                    <p class="panel-summary">Recent observations and clinical notes recorded today.</p>
                </div>
                <span class="activity-count">@streamItems.Count events today</span>
            </header>

            <RadzenDataGrid Data="streamItems" TItem="ObservationEventDto" AllowPaging="false" AllowSorting="false" class="activity-grid"
                            RowRender="@StreamRowRender">
                <Template Context="item">
                    <div class="stream-row-detail">@item.ClinicalDescription</div>
                </Template>
                <Columns>
                    <RadzenDataGridColumn TItem="ObservationEventDto" Property="ObservedAtUtc" Title="Time" Width="88px">
                        <Template Context="item">
                            <span class="activity-time">@item.ObservedAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ObservationEventDto" Property="SubjectDisplayName" Title="Subject" Width="120px" />
                    <RadzenDataGridColumn TItem="ObservationEventDto" Property="ClinicalDescription" Title="Note">
                        <Template Context="item">
                            <span class="activity-note">@item.ClinicalDescription</span>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </div>
</div>

