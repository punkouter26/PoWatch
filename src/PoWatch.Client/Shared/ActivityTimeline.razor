@using PoWatch.Shared.Models

@using Microsoft.AspNetCore.Components.Web.Virtualization

@if (Items.Count == 0)
{
    <div class="activity-empty">@EmptyMessage</div>
}
else
{
    @* Virtualized (audit #3): only the rows in view are in the DOM, so the feed stays cheap as
       history grows and re-renders no longer allocate every node each inference cycle. *@
    <div class="activity-list">
        <Virtualize Items="_virtualItems" Context="item" ItemSize="54" OverscanCount="6">
            <div class="activity-item @(item.IsClinicalOutlier ? "activity-item--outlier" : item.IsSignificant ? "activity-item--significant" : string.Empty)">
                <div class="activity-item-header">
                    <span class="activity-time">@item.ObservedAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                    @if (ShowSubjectBadge)
                    {
                        <span class="activity-subject">@item.SubjectDisplayName</span>
                    }
                    @if (item.IsClinicalOutlier)
                    {
                        <span class="activity-badge activity-badge--outlier" title="Flagged as unusual by the AI">⚠ Unusual</span>
                    }
                    else if (item.IsSignificant)
                    {
                        <span class="activity-badge activity-badge--significant" title="Flagged as worth noting by the AI">Notable</span>
                    }
                    <span class="activity-activity">@item.Activity</span>
                </div>
                @* Trust layer (Win #3): every flagged event says, in plain language, WHY it was flagged.
                   A caregiver should never have to guess whether an orange/red mark can be believed. *@
                @if ((item.IsClinicalOutlier || item.IsSignificant) && !string.IsNullOrWhiteSpace(item.SignificantReason))
                {
                    <div class="activity-why">
                        <span class="activity-why-label">Why flagged</span>
                        <span class="activity-why-text">@item.SignificantReason</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(item.ClinicalDescription))
                {
                    <div class="activity-note">@item.ClinicalDescription</div>
                }
            </div>
        </Virtualize>
    </div>
}

@code {
    /// <summary>
    /// The observation events to display in the timeline.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ObservationEventDto> Items { get; set; } = [];

    // Virtualize needs an ICollection. The list is a List at runtime, so this cast avoids allocation;
    // only an exotic IReadOnlyList would fall back to a copy.
    private ICollection<ObservationEventDto> _virtualItems = [];

    protected override void OnParametersSet() =>
        _virtualItems = Items as ICollection<ObservationEventDto> ?? Items.ToList();

    /// <summary>
    /// When true, shows the subject name badge next to each event.
    /// </summary>
    [Parameter]
    public bool ShowSubjectBadge { get; set; } = true;

    /// <summary>
    /// Message shown when the timeline is empty.
    /// </summary>
    [Parameter]
    public string EmptyMessage { get; set; } = "No records to display.";
}
