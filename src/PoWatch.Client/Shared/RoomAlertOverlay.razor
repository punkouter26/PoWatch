@* Full-screen alert takeover (UX Win #4). The one moment that matters — an unusual event —
   takes over the whole screen with the frame, a plain-language reason, and ONE primary action.
   Rendered as an alertdialog so assistive tech announces and traps it like the interruption it is. *@
@if (Visible)
{
    <div class="alert-takeover" role="alertdialog" aria-modal="true" tabindex="-1"
         @onkeydown="HandleKeyDownAsync"
         aria-labelledby="alert-takeover-title" aria-describedby="alert-takeover-reason">
        <div class="alert-takeover-card">
            <div class="alert-takeover-pulse" aria-hidden="true"></div>

            <p class="alert-takeover-eyebrow">Needs attention</p>
            <h2 id="alert-takeover-title" class="alert-takeover-title">
                @(string.IsNullOrWhiteSpace(SubjectName) ? "Someone in the room" : SubjectName)
            </h2>

            @if (!string.IsNullOrWhiteSpace(ImageDataUrl))
            {
                <div class="alert-takeover-frame">
                    <img src="@ImageDataUrl" alt="Captured frame of the unusual moment" />
                </div>
            }

            <p id="alert-takeover-reason" class="alert-takeover-reason">@Reason</p>

            <div class="alert-takeover-meta">
                @if (!string.IsNullOrWhiteSpace(ActivityLabel))
                {
                    <span class="alert-takeover-chip">@ActivityLabel</span>
                }
                @if (!string.IsNullOrWhiteSpace(TimeLabel))
                {
                    <span class="alert-takeover-chip alert-takeover-chip--time">@TimeLabel</span>
                }
            </div>

            <div class="alert-takeover-actions">
                <button class="alert-takeover-btn alert-takeover-btn--primary" @ref="_acknowledgeButton"
                        @onclick="OnAcknowledge" data-test="alert-acknowledge">
                    I’ve got it
                </button>
                <button class="alert-takeover-btn alert-takeover-btn--ghost"
                        @onclick="OnViewSubject" data-test="alert-view-subject">
                    See this person
                </button>
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _acknowledgeButton;
    private bool _focused;

    // The overlay declares role="alertdialog" + aria-modal, so it must actually take focus and
    // accept Escape. The plain `autofocus` attribute it used to carry only applies when the
    // browser parses the markup, which never happens for an element Blazor adds on re-render —
    // the most important dialog in the app was reachable by mouse only.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_focused)
        {
            _focused = true;
            try { await _acknowledgeButton.FocusAsync(); }
            catch { /* element already torn down */ }
        }
        else if (!Visible)
        {
            _focused = false;
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await OnAcknowledge.InvokeAsync();
        }
    }

    [Parameter, EditorRequired] public bool Visible { get; set; }
    [Parameter] public string SubjectName { get; set; } = string.Empty;
    [Parameter] public string Reason { get; set; } = string.Empty;
    [Parameter] public string ActivityLabel { get; set; } = string.Empty;
    [Parameter] public string TimeLabel { get; set; } = string.Empty;
    [Parameter] public string? ImageDataUrl { get; set; }
    [Parameter] public EventCallback OnAcknowledge { get; set; }
    [Parameter] public EventCallback OnViewSubject { get; set; }
}
