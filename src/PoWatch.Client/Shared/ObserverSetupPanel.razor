@using PoWatch.Shared.Models

@if (!IsMonitoring && !IsThinking)
{
    @* Invisible complexity (Win #2): a caregiver never picks an ML model. Start uses the recommended
       default; the model, GPU, and poll interval all live behind one "Advanced" disclosure so the
       cold-start screen offers exactly one obvious action — Start watching. *@
    <div class="setup-advanced">
        <button type="button" class="setup-advanced-toggle" @onclick="ToggleAdvanced"
                aria-expanded="@_advExpanded">
            @(_advExpanded ? "▾" : "▸") Advanced settings (model, GPU &amp; check interval)
        </button>
        @if (_advExpanded)
        {
            <div class="setup-row">
                <label>Inference Model</label>
                <select class="rz-dropdown" @onchange="OnNativeModelChanged">
                    @foreach (var opt in ModelOptions)
                    {
                        <option value="@opt.Value" selected="@(opt.Value == SelectedModelKey)">@opt.Label</option>
                    }
                </select>
            </div>
            <div class="setup-row">
                <label>GPU Power Preference</label>
                <select class="rz-dropdown" @onchange="OnGpuPreferenceChanged">
                    <option value="default"          selected="@(GpuPreference == "default")">Auto (browser default)</option>
                    <option value="high-performance" selected="@(GpuPreference == "high-performance")">High-performance (discrete / NVIDIA)</option>
                    <option value="low-power"        selected="@(GpuPreference == "low-power")">Low-power (integrated / Intel)</option>
                </select>
            </div>
            <div class="setup-row">
                <label>Check the room every — <strong>@PollingSeconds s</strong></label>
                <input type="range" min="5" max="120" step="5"
                       value="@PollingSeconds"
                       @onchange="OnPollingChanged" />
            </div>
        }
    </div>

    @if (ShowDevTools)
    {
        <div class="dev-tools-row">
            <button class="dev-tools-toggle" @onclick="ToggleDevTools">
                @(_devExpanded ? "▾" : "▸") Developer Tools
            </button>
            @if (_devExpanded)
            {
                <div class="dev-tools-actions">
                    <RadzenButton ButtonStyle="ButtonStyle.Success" Text="Inject Significant Event" Click="OnInjectEvent" />
                    <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Inject Clinical Outlier" Click="OnInjectOutlier" />
                </div>
            }
        </div>
    }
}

@code {
    public sealed record ModelOption(string Value, string Label);

    [Parameter, EditorRequired] public bool IsMonitoring { get; set; }
    [Parameter, EditorRequired] public bool IsThinking { get; set; }
    [Parameter, EditorRequired] public string SelectedModelKey { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SelectedModelKeyChanged { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<ModelOption> ModelOptions { get; set; } = [];
    [Parameter, EditorRequired] public string GpuPreference { get; set; } = "default";
    [Parameter, EditorRequired] public int PollingSeconds { get; set; }
    [Parameter] public bool ShowDevTools { get; set; }
    [Parameter] public EventCallback<object> OnModelChanged { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnGpuPreferenceChanged { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnPollingChanged { get; set; }
    [Parameter] public EventCallback OnInjectEvent { get; set; }
    [Parameter] public EventCallback OnInjectOutlier { get; set; }

    private bool _devExpanded;
    private bool _advExpanded;

    private void ToggleAdvanced() => _advExpanded = !_advExpanded;

    private async Task OnNativeModelChanged(ChangeEventArgs e)
    {
        var newKey = e.Value?.ToString() ?? string.Empty;
        await SelectedModelKeyChanged.InvokeAsync(newKey);
        await OnModelChanged.InvokeAsync(newKey);
    }

    private void ToggleDevTools() => _devExpanded = !_devExpanded;
}
