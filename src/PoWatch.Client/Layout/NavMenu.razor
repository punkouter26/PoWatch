@using PoWatch.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Net.Http
@inject IInferenceService InferenceService
@inject HttpClient Http
@inject NavigationManager Navigation

@* Spatial contract (audit #9): LEFT = branding, CENTER = navigation actions, RIGHT = mock-data guard
   + signed-in user chip + sign-out. The "USING MOCK DATA" warning is now a topbar chip rather than a
   stacked full-width bar, so toggling it no longer shifts the whole page layout down. *@
<nav class="navbar app-navbar" role="navigation" aria-label="Main navigation">
    <a class="navbar-brand" href="" aria-label="PoWatch home">
        <span class="brand-mark">PW</span>
        <span class="brand-copy">PoWatch</span>
    </a>

    <button class="navbar-toggler" @onclick="ToggleNavMenu"
            aria-expanded="@(!collapseNavMenu)" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="navbar-collapse @(collapseNavMenu ? "" : "show")">
        <div class="navbar-nav">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Observer Hub</NavLink>
            <NavLink class="nav-link" href="live-dashboard">Live Dashboard</NavLink>
            <NavLink class="nav-link" href="archives">Archives</NavLink>
            <NavLink class="nav-link" href="identity">Identity</NavLink>
            <NavLink class="nav-link" href="diagnostics">Diagnostics</NavLink>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="navbar-account">
                    @if (MockLabel is not null)
                    {
                        <span class="mock-chip" role="status" aria-live="polite" title="Mock data active — @MockLabel">
                            ⚠ MOCK DATA
                        </span>
                    }
                    @* After Microsoft OAuth login, show the signed-in user's email / UPN to the left
                       of the Sign-out button so the operator knows which identity is in use
                       (kiosk-friendly audit trail). Falls back to the display name if no email claim. *@
                    @if (!string.IsNullOrWhiteSpace(_signedInEmail))
                    {
                        <span class="user-email" title="Signed in as @_signedInEmail" aria-label="Signed in as @_signedInEmail">
                            @_signedInEmail
                        </span>
                    }
                    <button class="nav-logout" @onclick="LogoutAsync" disabled="@_loggingOut" aria-label="Sign out">
                        @(_loggingOut ? "Signing out…" : "Sign out")
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                @* Anonymous viewers (e.g. /login) see no session controls — signing in happens on the
                   /login page itself, so there's nothing useful to render in the right rail. *@
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    private bool collapseNavMenu = true;
    private bool _loggingOut;
    private string? _signedInEmail;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        // Re-read the email each time the auth state changes so post-OAuth login lights up the chip
        // without requiring a manual refresh.
        if (AuthStateTask is null) { _signedInEmail = null; return; }
        var state = await AuthStateTask;
        var user = state.User;
        _signedInEmail =
            user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("preferred_username")?.Value
            ?? user.FindFirst(ClaimTypes.Name)?.Value;
    }

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private string? MockLabel => InferenceService is IMockable mockable ? mockable.MockLabel : null;

    private async Task LogoutAsync()
    {
        _loggingOut = true;
        try
        {
            // POST clears the BFF cookie server-side; force a full reload so AuthorizeRouteView
            // re-evaluates against the now-anonymous /auth/me and lands on /login.
            using var response = await Http.PostAsync("auth/logout", content: null);
        }
        catch
        {
            // Even if the call fails, fall through to a reload — the cookie may already be gone.
        }
        finally
        {
            Navigation.NavigateTo("login", forceLoad: true);
        }
    }
}