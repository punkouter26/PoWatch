@using PoWatch.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Net.Http
@implements IDisposable
@inject IInferenceService InferenceService
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Spatial contract (audit #9): LEFT = branding, CENTER = navigation actions, RIGHT = mock-data guard
   + signed-in user chip + sign-out. The "USING MOCK DATA" warning is now a topbar chip rather than a
   stacked full-width bar, so toggling it no longer shifts the whole page layout down.
   At the compact breakpoint the right rail folds into a slide-down drawer (idea #7). *@

<nav class="navbar app-navbar" role="navigation" aria-label="Main navigation" data-test="app-navbar">
    <a class="navbar-brand" href="" aria-label="PoWatch home" data-test="navbar-brand">
        <span class="brand-mark">PW</span>
        <span class="brand-copy">PoWatch</span>
    </a>

    @* Desktop nav links — hidden on narrow viewports where the hamburger takes over. *@
    <div class="navbar-nav navbar-nav--desktop">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All" data-test="nav-link-observer-hub" aria-label="Go to the Live Room">Live Room</NavLink>
        <NavLink class="nav-link" href="archives" data-test="nav-link-archives" aria-label="Go to History">History</NavLink>
        <NavLink class="nav-link" href="identity" data-test="nav-link-identity" aria-label="Go to People">People</NavLink>
    </div>

    @* The hamburger only renders for authenticated users and only takes effect at the compact
       breakpoint (the CSS hides it above). *@
    <AuthorizeView>
        <Authorized>
            <button class="navbar-toggler" @onclick="ToggleNavMenu"
                    aria-expanded="@(!collapseNavMenu)"
                    aria-controls="mobile-nav-drawer"
                    aria-label="Toggle navigation menu" data-test="navbar-toggler">
                <span class="navbar-toggler-icon" aria-hidden="true"></span>
            </button>
        </Authorized>
    </AuthorizeView>

    @* RIGHT region (desktop): mock guard + session/logout, pinned to the far edge. Hidden at the
       compact breakpoint — its content is folded into the mobile drawer. *@
    <div class="navbar-account navbar-account--desktop">
        <AuthorizeView>
            <Authorized>
                <NavLink class="nav-gear" href="health" title="Connection health"
                         aria-label="Connection health" data-test="nav-link-health">♥</NavLink>
                <NavLink class="nav-gear" href="diagnostics" title="System health & diagnostics"
                         aria-label="System health and diagnostics" data-test="nav-link-diagnostics">⚙</NavLink>
                <button class="theme-toggle" @onclick="ToggleThemeAsync"
                        aria-label="@(_theme == "light" ? "Switch to dark theme" : "Switch to light theme")"
                        aria-pressed="@(_theme == "light")"
                        title="Toggle theme" data-test="theme-toggle">
                    <span aria-hidden="true">@(_theme == "light" ? "☀" : "☾")</span>
                    <span class="visually-hidden">Theme</span>
                </button>
                @if (MockLabel is not null)
                {
                    <span class="mock-chip" role="status" aria-live="polite" title="Mock data active — @MockLabel" data-test="mock-chip">
                        ⚠ MOCK DATA
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(_signedInEmail))
                {
                    <span class="user-email" title="Signed in as @_signedInEmail" aria-label="Signed in as @_signedInEmail" data-test="navbar-user-email">
                        @_signedInEmail
                    </span>
                }
                <button class="nav-logout" @onclick="LogoutAsync" disabled="@_loggingOut" aria-disabled="@_loggingOut" aria-label="Sign out" data-test="navbar-sign-out">
                    @(_loggingOut ? "Signing out…" : "Sign out")
                </button>
            </Authorized>
            <NotAuthorized>
                @* Anonymous viewers (e.g. /login) see no session controls — the chrome offers
                   nothing useful until auth state resolves. *@
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

@* Mobile drawer (idea #7): when the topbar collapses, the nav links + account rail move into a
   slide-down drawer with backdrop, Escape-to-close, and focus management. Same accessibility
   treatment as the observer settings drawer. *@
<AuthorizeView>
    <Authorized>
        @if (!collapseNavMenu)
        {
            <div class="navbar-drawer-backdrop" @onclick="CloseDrawer" data-test="navbar-drawer-backdrop"></div>
            <aside class="navbar-drawer" id="mobile-nav-drawer" role="dialog"
                   aria-modal="true" aria-label="Navigation menu" tabindex="-1" @ref="_drawerRef"
                   @onkeydown="HandleDrawerKeyDown" data-test="navbar-drawer">
                <div class="navbar-drawer-section">
                    <span class="navbar-drawer-label">Pages</span>
                    <NavLink class="nav-link" href="" @onclick="CloseDrawer" Match="NavLinkMatch.All">Live Room</NavLink>
                    <NavLink class="nav-link" href="archives" @onclick="CloseDrawer">History</NavLink>
                    <NavLink class="nav-link" href="identity" @onclick="CloseDrawer">People</NavLink>
                </div>
                <div class="navbar-drawer-section">
                    <span class="navbar-drawer-label">Tools</span>
                    <NavLink class="nav-link" href="health" @onclick="CloseDrawer">Connection health</NavLink>
                    <NavLink class="nav-link" href="diagnostics" @onclick="CloseDrawer">System</NavLink>
                    <button class="nav-link navbar-drawer-action" @onclick="ToggleThemeAsync">
                        Theme: @(_theme == "light" ? "light" : "dark")
                    </button>
                    @if (MockLabel is not null)
                    {
                        <span class="mock-chip" role="status">⚠ MOCK DATA</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_signedInEmail))
                {
                    <div class="navbar-drawer-section">
                        <span class="navbar-drawer-label">Signed in</span>
                        <span class="user-email">@_signedInEmail</span>
                    </div>
                }
                <div class="navbar-drawer-section navbar-drawer-section--end">
                    <button class="nav-logout" @onclick="LogoutAsync" disabled="@_loggingOut" aria-disabled="@_loggingOut" aria-label="Sign out">
                        @(_loggingOut ? "Signing out…" : "Sign out")
                    </button>
                </div>
            </aside>
        }
    </Authorized>
</AuthorizeView>

@code {
    private bool collapseNavMenu = true;
    private bool _loggingOut;
    private string? _signedInEmail;
    private string _theme = "dark";
    private ElementReference _drawerRef;
    private bool _drawerFocusedOnce;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var current = await JS.InvokeAsync<string>("powatchTheme.get");
                if (!string.IsNullOrEmpty(current)) _theme = current;
                StateHasChanged();
            }
            catch
            {
                // Ignore — JS interop unavailable (shouldn't happen in WASM).
            }
        }

        if (!collapseNavMenu && !_drawerFocusedOnce)
        {
            try { await _drawerRef.FocusAsync(); _drawerFocusedOnce = true; }
            catch { /* element unmounted */ }
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!collapseNavMenu) collapseNavMenu = true;
        _drawerFocusedOnce = false;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
        _drawerFocusedOnce = false;
    }

    private void CloseDrawer()
    {
        if (!collapseNavMenu)
        {
            collapseNavMenu = true;
            _drawerFocusedOnce = false;
        }
    }

    private void HandleDrawerKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Escape", StringComparison.Ordinal))
        {
            CloseDrawer();
        }
    }

    private async Task ToggleThemeAsync()
    {
        try
        {
            var next = await JS.InvokeAsync<string>("powatchTheme.toggle");
            _theme = string.IsNullOrEmpty(next) ? _theme : next;
        }
        catch
        {
            _theme = _theme == "dark" ? "light" : "dark";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Re-read the email each time the auth state changes so post-OAuth login lights up the chip
        // without requiring a manual refresh.
        if (AuthStateTask is null) { _signedInEmail = null; return; }
        var state = await AuthStateTask;
        var user = state.User;
        _signedInEmail =
            user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("preferred_username")?.Value
            ?? user.FindFirst(ClaimTypes.Name)?.Value;
    }

    private string? MockLabel => InferenceService is IMockable mockable ? mockable.MockLabel : null;

    private async Task LogoutAsync()
    {
        _loggingOut = true;
        try
        {
            // POST clears the BFF cookie server-side; force a full reload so AuthorizeRouteView
            // re-evaluates against the now-anonymous /auth/me and lands on /login.
            using var response = await Http.PostAsync("auth/logout", content: null);
        }
        catch
        {
            // Even if the call fails, fall through to a reload — the cookie may already be gone.
        }
        finally
        {
            Navigation.NavigateTo("login", forceLoad: true);
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}