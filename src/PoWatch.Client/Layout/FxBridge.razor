@* Feeds the scene effects (wwwroot/js/fx.js) a compact frame of live numbers, four times a second
   while a session runs, plus one frame whenever it starts or stops. Renders nothing. *@
@implements IDisposable
@using System.Text.Json
@using PoWatch.Shared.Services.Tracking
@inject SensingSession Sensing
@inject IJSRuntime JS

@code {
    private static readonly TimeSpan Every = TimeSpan.FromMilliseconds(250);
    private DateTimeOffset _last;
    private bool _wasRunning;

    protected override void OnInitialized() => Sensing.Changed += OnChanged;

    private void OnChanged()
    {
        var now = DateTimeOffset.UtcNow;
        if (now - _last < Every && Sensing.IsRunning == _wasRunning) return;
        _last = now;
        _wasRunning = Sensing.IsRunning;

        var live = Sensing.Live;
        var frame = new FxFramePayload
        {
            Running = Sensing.IsRunning,
            Motion = live.Motion,
            Luminance = live.Luminance,
            Present = live.PeopleNow + live.AnimalsNow,
            Heat = [.. live.Heat],
            Palette = [.. live.Palette],
            Tracks = live.Tracks
                .Where(t => CentroidTracker.IsPresence(t.Label))
                .Select(t => new FxTrackPayload { Id = t.TrackId, Label = t.Label, X = (t.Box.X0 + t.Box.X1) / 2, Y = (t.Box.Y0 + t.Box.Y1) / 2 })
                .ToList(),
            Caption = live.LastCaption,
            CaptionAt = live.LastCaptionUtc?.ToUnixTimeMilliseconds() ?? 0,
        };
        _ = JS.TryInvokeVoidAsync("powatchFx.update", JsonSerializer.Serialize(frame, PoWatchJsonContext.Default.FxFramePayload));
    }

    public void Dispose() => Sensing.Changed -= OnChanged;
}
