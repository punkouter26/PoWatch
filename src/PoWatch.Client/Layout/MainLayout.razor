@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject IJSRuntime JS

<a href="#main-content" class="skip-link">Skip to main content</a>

<div class="page">
    <header class="app-header">
        <NavMenu />
    </header>

    <main>
        <div class="page-hud" data-test="page-hud">
            <div class="page-hud-title">
                <strong data-test="page-hud-title">@_pageTitle</strong>
                <span class="page-hud-subtitle">@_pageSubtitle</span>
            </div>
            @* Chrome kept minimal (consolidation #10): no clock (the OS shows one) and no status
               chip (the Live Room hero owns monitoring state; System owns engine state). *@
        </div>

        @if (_navigating)
        {
            <div class="nav-loading-bar" role="progressbar" aria-label="Page loading"></div>
        }

        <article class="content app-shell" id="main-content">
            @Body
        </article>
    </main>
</div>

<RadzenNotification />
@* RadzenDialog host — required for DialogService.Confirm/OpenAsync to render anything. Without
   it, the clear-data confirm, the System-page reset confirm, and the handoff dialog were all
   silent no-ops (added 2026-07-22). *@
<RadzenDialog />
@* Advanced Radzen hosts (audit #10): enable app-wide tooltips and contextual menus.
   TooltipService gives touch-usable tooltips that native title="" cannot. *@
<RadzenTooltip />
<RadzenContextMenu />

@code {
    private bool _navigating = false;
    private string _pageTitle = "Live Room";
    private string _pageSubtitle = "Local-only ambient monitoring";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdatePageTitle(Nav.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Global keyboard shortcuts (Ctrl+1..4 to navigate, Ctrl+K for the command
            // palette, "/" to focus the page filter). Handled entirely in JS — no
            // DotNetObjectReference, because the C# callback it used to hold was empty.
            try { await JS.InvokeVoidAsync("powatchKeybindings.setup"); }
            catch { /* private mode or polyfill missing */ }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // The heading must change WITH the route, not 350 ms after it. It used to be updated
        // inside a fire-and-forget Task.Delay continuation, so the HUD kept announcing the
        // previous page during the transition and two quick navigations could race and leave
        // the wrong title on screen.
        UpdatePageTitle(e.Location);
        _navigating = true;
        InvokeAsync(StateHasChanged);

        // The progress bar is purely cosmetic; only its teardown is deferred.
        _ = HideNavigationBarAsync();
    }

    private async Task HideNavigationBarAsync()
    {
        await Task.Delay(350);
        _navigating = false;
        await InvokeAsync(StateHasChanged);
    }

    private void UpdatePageTitle(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        (_pageTitle, _pageSubtitle) = path switch
        {
            "" or "/" => ("Live Room", "Watching the room, quietly"),
            "/archives" => ("History", "Each day's story and the moments that mattered"),
            "/identity" => ("People", "Everyone seen — name, rename, and merge"),
            "/diagnostics" => ("System", "Runtime, storage & inference health"),
            "/health" => ("Health", "Every connection PoWatch depends on"),
            "/login" => ("Sign in", "Sign in to PoWatch"),
            _ => ("PoWatch", "Calm, local-only room monitoring")
        };
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}

