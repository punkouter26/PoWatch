@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SensingSession Sensing

<a href="#main-content" class="skip-link">Skip to main content</a>

<div class="term-shell">
    <TerminalHeader Title="@_title" />
    <FunctionKeyBar />

    <main class="term-body" id="main-content">
        <ErrorBoundary @key="Nav.Uri">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                @* Without a boundary a single component exception tears down the whole render tree
                   and leaves a blank page with no way back. *@
                <div class="po-error-panel term-panel" role="alert" style="padding: 16px;">
                    <h2>Something went wrong</h2>
                    <p>This page hit an unexpected error. Reload the page to try again.</p>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    <TickerTape />
</div>

@* The camera feed lives here, not on the Live page, so it keeps playing (and the session keeps
   sampling) on every page; Live docks it over its camera panel. *@
<video @ref="_feed" class="term-feed" autoplay muted playsinline aria-label="Live camera feed"></video>

<RadzenNotification />
<RadzenDialog />
<RadzenTooltip />
<RadzenContextMenu />

@code {
    private string _title = "LIVE";
    private ElementReference _feed;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        _title = TitleFor(Nav.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Number keys / Ctrl+number jump between sections; "/" focuses the command line.
        if (!firstRender) return;
        Sensing.Feed = _feed;
        await JS.TryInvokeVoidAsync("powatchKeybindings.setup");
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _title = TitleFor(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private static string TitleFor(string uri) => new Uri(uri).AbsolutePath.TrimEnd('/').ToLowerInvariant() switch
    {
        "" or "/" => "LIVE",
        "/stats" => "STATS",
        "/history" or "/archives" => "HISTORY",
        "/regulars" or "/identity" => "REGULARS",
        "/trophies" => "TROPHIES",
        "/system" or "/diagnostics" => "SYSTEM",
        "/health" => "HEALTH",
        "/display" => "WALL",
        _ => "POWATCH"
    };

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
