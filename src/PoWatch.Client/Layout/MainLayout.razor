@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SensingSession Sensing

<a href="#main-content" class="skip-link">Skip to main content</a>

<div class="term-shell @(_wall ? "term-shell--wall" : string.Empty)">
    @* The stats wall keeps this layout (and the camera below) but drops the chrome. *@
    @if (!_wall)
    {
        <TerminalHeader ShowStart="@(_section != "LIVE")" />
    }

    <main class="term-body" id="main-content">
        @if (!_wall)
        {
            <AwayCard />
        }
        <ErrorBoundary @key="Nav.Uri">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                @* Without a boundary a single component exception tears down the whole render tree
                   and leaves a blank page with no way back. *@
                <div class="po-error-panel term-panel" role="alert">
                    <h2>Something went wrong</h2>
                    <p>This page hit an unexpected error. Reload the page to try again.</p>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    <TickerTape />
</div>

@if (_wall)
{
    <a class="term-wall-exit" href="">Exit wall</a>
}
else
{
    <NamePrompts />
}

@* The camera feed lives here, not on the Live page, so it keeps playing (and the session keeps
   sampling) on every page; Live docks it over its camera panel. *@
<video @ref="_feed" class="term-feed" autoplay muted playsinline aria-label="Live camera feed"></video>
<FxBridge />

<RadzenNotification />
<RadzenDialog />
<RadzenTooltip />
<RadzenContextMenu />

@code {
    private string _section = "LIVE";
    private bool _wall;
    private ElementReference _feed;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        SetSection(Nav.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Number keys / Ctrl+number jump between sections; "/" focuses the command line.
        if (!firstRender) return;
        Sensing.Feed = _feed;
        await JS.TryInvokeVoidAsync("powatchKeybindings.setup");
        await Sensing.ResendLeftoversAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SetSection(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void SetSection(string uri)
    {
        _section = new Uri(uri).AbsolutePath.TrimEnd('/').ToLowerInvariant() switch
        {
            "" or "/" => "LIVE",
            "/display" => "WALL",
            _ => "OTHER"
        };
        _wall = _section == "WALL";
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
