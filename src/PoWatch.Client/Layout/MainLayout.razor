@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject IJSRuntime JS

<a href="#main-content" class="skip-link">Skip to main content</a>

<div class="page">
    <header class="app-header">
        <NavMenu />
    </header>

    <main>
        <div class="page-hud" data-test="page-hud">
            <div class="page-hud-title">
                <strong data-test="page-hud-title">@_pageTitle</strong>
                <span class="page-hud-subtitle">@_pageSubtitle</span>
            </div>
            @* Chrome kept minimal (consolidation #10): no clock (the OS shows one) and no status
               chip (the Live Room hero owns monitoring state; System owns engine state). *@
        </div>

        @if (_navigating)
        {
            <div class="nav-loading-bar" role="progressbar" aria-label="Page loading"></div>
        }

        <article class="content app-shell" id="main-content">
            @Body
        </article>
    </main>
</div>

<RadzenNotification />
@* RadzenDialog host — required for DialogService.Confirm/OpenAsync to render anything. Without
   it, the clear-data confirm, the System-page reset confirm, and the handoff dialog were all
   silent no-ops (added 2026-07-22). *@
<RadzenDialog />
@* Advanced Radzen hosts (audit #10): enable app-wide tooltips and contextual menus.
   TooltipService gives touch-usable tooltips that native title="" cannot. *@
<RadzenTooltip />
<RadzenContextMenu />

@code {
    private bool _navigating = false;
    private string _pageTitle = "Live Room";
    private string _pageSubtitle = "Local-only ambient monitoring";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdatePageTitle(Nav.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Wire the global keyboard shortcuts (Ctrl+1..5 for nav, "/" to
            // focus the page filter, "?" for help). The JS file auto-loads
            // in index.html; we just need to register the dotNetRef so it can
            // bubble commands back to C# (e.g. keyboard "r" might later mean
            // "refresh", depending on the page).
            try { await JS.InvokeVoidAsync("powatchKeybindings.setup", DotNetObjectReference.Create(this)); }
            catch { /* private mode or polyfill missing */ }
        }
    }

    [JSInvokable]
    public void OnShortcut(string key)
    {
        // Future: surface recognized combos as a toast. Today the `/` shortcut
        // is handled inside keyboard-bindings.js (focus-filter). Centralising
        // the wiring here keeps the JS one source of truth.
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _navigating = true;
        InvokeAsync(StateHasChanged);
        Task.Delay(350).ContinueWith(_ =>
        {
            _navigating = false;
            UpdatePageTitle(e.Location);
            InvokeAsync(StateHasChanged);
        });
    }

    private void UpdatePageTitle(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        (_pageTitle, _pageSubtitle) = path switch
        {
            "" or "/" => ("Live Room", "Watching the room, quietly"),
            "/archives" => ("History", "Each day's story and the moments that mattered"),
            "/identity" => ("People", "Everyone seen — name, rename, and merge"),
            "/diagnostics" => ("System", "Runtime, storage & inference health"),
            "/login" => ("Sign in", "Sign in to PoWatch"),
            _ => ("PoWatch", "Calm, local-only room monitoring")
        };
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}

