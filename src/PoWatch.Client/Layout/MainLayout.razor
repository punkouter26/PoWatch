@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

<a href="#main-content" class="skip-link">Skip to main content</a>

<div class="page">
    <header class="app-header">
        <NavMenu />
    </header>

    <main>
        <div class="page-hud" data-test="page-hud">
            <div class="page-hud-title">
                <strong data-test="page-hud-title">@_pageTitle</strong>
                <span class="page-hud-subtitle">@_pageSubtitle</span>
            </div>
            <div class="page-hud-meta">
                <span class="hud-badge hud-badge--@_inferenceLevel" title="Local inference engine state" data-test="inference-badge">
                    <span class="hud-badge-dot" aria-hidden="true"></span>@_inferenceLabel
                </span>
                <span class="hud-clock" aria-live="off" data-test="page-clock"><ClockDisplay /></span>
            </div>
        </div>

        @if (_navigating)
        {
            <div class="nav-loading-bar" role="progressbar" aria-label="Page loading"></div>
        }

        <article class="content app-shell" id="main-content">
            @Body
        </article>
    </main>
</div>

<RadzenNotification />
@* Advanced Radzen hosts (audit #10): enable app-wide tooltips and contextual menus.
   TooltipService gives touch-usable tooltips that native title="" cannot. *@
<RadzenTooltip />
<RadzenContextMenu />

@code {
    private System.Threading.Timer? _timer;
    private int _tick;
    private bool _navigating = false;
    private string _pageTitle = "Live Room";
    private string _pageSubtitle = "Local-only ambient monitoring";

    // Live inference-engine badge (NET_RUN_10 #10) — replaces the static "Inference ready" chip.
    private string _inferenceLabel = "Standby";
    private string _inferenceLevel = "idle";

    protected override void OnInitialized()
    {
        // Inference-badge poll only — clock moved to its own <ClockDisplay />.
        _timer = new System.Threading.Timer(_ =>
        {
            if (++_tick % 5 == 0) _ = InvokeAsync(RefreshInferenceBadgeAsync);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

        Nav.LocationChanged += OnLocationChanged;
        UpdatePageTitle(Nav.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Wire the global keyboard shortcuts (Ctrl+1..5 for nav, "/" to
            // focus the page filter, "?" for help). The JS file auto-loads
            // in index.html; we just need to register the dotNetRef so it can
            // bubble commands back to C# (e.g. keyboard "r" might later mean
            // "refresh", depending on the page).
            try { await JS.InvokeVoidAsync("powatchKeybindings.setup", DotNetObjectReference.Create(this)); }
            catch { /* private mode or polyfill missing */ }
        }
    }

    [JSInvokable]
    public void OnShortcut(string key)
    {
        // Future: surface recognized combos as a toast. Today the `/` shortcut
        // is handled inside keyboard-bindings.js (focus-filter). Centralising
        // the wiring here keeps the JS one source of truth.
    }

    private async Task RefreshInferenceBadgeAsync()
    {
        try
        {
            var diag = await JS.InvokeAsync<InferenceBadgeDto>("powatchInference.getInferenceDiagnostics");
            (_inferenceLabel, _inferenceLevel) = diag?.LoadState switch
            {
                "ready" => ("Model ready", "ready"),
                "loading" => ("Loading model…", "loading"),
                "error" => ("Inference error", "error"),
                _ => ("Standby", "idle"),
            };
        }
        catch
        {
            // Inference JS not present (e.g. anonymous /login) — keep the neutral Standby state.
            (_inferenceLabel, _inferenceLevel) = ("Standby", "idle");
        }
        await InvokeAsync(StateHasChanged);
    }

    private sealed class InferenceBadgeDto
    {
        public string? LoadState { get; set; }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _navigating = true;
        InvokeAsync(StateHasChanged);
        Task.Delay(350).ContinueWith(_ =>
        {
            _navigating = false;
            UpdatePageTitle(e.Location);
            InvokeAsync(StateHasChanged);
        });
    }

    private void UpdatePageTitle(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        (_pageTitle, _pageSubtitle) = path switch
        {
            "" or "/" => ("Live Room", "Watching the room, quietly"),
            "/archives" => ("History", "Each day's story and the moments that mattered"),
            "/live-dashboard" => ("Overview", "How everyone is doing, right now"),
            "/identity" => ("People", "Name, rename, and merge the people seen"),
            "/diagnostics" => ("System", "Runtime, storage & inference health"),
            "/login" => ("Sign in", "Sign in to PoWatch"),
            _ => ("PoWatch", "Calm, local-only room monitoring")
        };
    }

    public void Dispose()
    {
        _timer?.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
    }
}

