@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav

<a href="#main-content" class="skip-link">Skip to main content</a>

<div class="page">
    <header class="app-header">
        <NavMenu />
    </header>

    <main>
        <div class="page-hud">
            <div class="page-hud-title">
                <strong>@_pageTitle</strong>
                <span class="page-hud-subtitle">Local-only ambient monitoring</span>
            </div>
            <div class="page-hud-meta">
                <span class="hud-badge">Inference ready</span>
                <span class="hud-clock" aria-live="polite">@_clock</span>
            </div>
        </div>

        @if (_navigating)
        {
            <div class="nav-loading-bar" role="progressbar" aria-label="Page loading"></div>
        }

        <article class="content app-shell" id="main-content">
            @Body
        </article>
    </main>
</div>

<RadzenNotification />

@code {
    private string _clock = DateTime.Now.ToString("HH:mm:ss");
    private System.Threading.Timer? _timer;
    private bool _navigating = false;
    private string _pageTitle = "Observer Hub";

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            _clock = DateTime.Now.ToString("HH:mm:ss");
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

        Nav.LocationChanged += OnLocationChanged;
        UpdatePageTitle(Nav.Uri);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _navigating = true;
        InvokeAsync(StateHasChanged);
        Task.Delay(350).ContinueWith(_ =>
        {
            _navigating = false;
            UpdatePageTitle(e.Location);
            InvokeAsync(StateHasChanged);
        });
    }

    private void UpdatePageTitle(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        _pageTitle = path switch
        {
            "" or "/" => "Observer Hub",
            "/archives" => "Archives",
            "/live-dashboard" => "Live Dashboard",
            "/identity" => "Subjects",
            "/diagnostics" => "Diagnostics",
            _ => "PoWatch"
        };
    }

    public void Dispose()
    {
        _timer?.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
    }
}
