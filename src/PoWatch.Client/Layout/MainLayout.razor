@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SensingSession Sensing

<a href="#main-content" class="skip-link">Skip to main content</a>

<div class="term-shell">
    <TerminalHeader ShowStart="@(!_live)" />

    @* App.razor moves focus here after every navigation, so keyboard and screen-reader users land in the page. *@
    <main class="term-body" id="main-content" tabindex="-1">
        <AwayCard />
        @* Keyed on the path, not the full URI: a query change (?range=, ?start=) must not rebuild the page. *@
        <ErrorBoundary @key="new Uri(Nav.Uri).AbsolutePath">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                @* Without a boundary a single component exception tears down the whole render tree
                   and leaves a blank page with no way back. *@
                <div class="po-error-panel term-panel" role="alert">
                    <h2>Something went wrong</h2>
                    <p>This page hit an unexpected error. Reload the page to try again.</p>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

<NamePrompts />

@* The camera feed lives here, not on the Live page, so it keeps playing (and the session keeps
   sampling) on every page; Live docks it over its camera panel. *@
<video @ref="_feed" class="term-feed" autoplay muted playsinline aria-label="Live camera feed"></video>
<FxBridge />
@* Host for chart hover tooltips; without it RadzenChart never shows one. *@
<RadzenChartTooltip />

@code {
    private bool _live = true;
    private ElementReference _feed;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        _live = IsLive(Nav.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Sensing.Feed = _feed;
        await JS.TryInvokeVoidAsync("powatchMenus.setup");
        await Sensing.ResendLeftoversAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _live = IsLive(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private static bool IsLive(string uri) => new Uri(uri).AbsolutePath.TrimEnd('/').Length == 0;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
