@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

<a href="#main-content" class="skip-link">Skip to main content</a>

<div class="page">
    <header class="app-header">
        <NavMenu />
    </header>

    <main>
        <div class="page-hud">
            <div class="page-hud-title">
                <strong>@_pageTitle</strong>
                <span class="page-hud-subtitle">@_pageSubtitle</span>
            </div>
            <div class="page-hud-meta">
                <span class="hud-badge hud-badge--@_inferenceLevel" title="Local inference engine state">
                    <span class="hud-badge-dot" aria-hidden="true"></span>@_inferenceLabel
                </span>
                <span class="hud-clock" aria-live="polite">@_clock</span>
            </div>
        </div>

        @if (_navigating)
        {
            <div class="nav-loading-bar" role="progressbar" aria-label="Page loading"></div>
        }

        <article class="content app-shell" id="main-content">
            @Body
        </article>
    </main>
</div>

<RadzenNotification />
@* Advanced Radzen hosts (audit #10): enable app-wide tooltips and contextual menus.
   TooltipService gives touch-usable tooltips that native title="" cannot. *@
<RadzenTooltip />
<RadzenContextMenu />

@code {
    private string _clock = DateTime.Now.ToString("HH:mm:ss");
    private System.Threading.Timer? _timer;
    private int _tick;
    private bool _navigating = false;
    private string _pageTitle = "Observer Hub";
    private string _pageSubtitle = "Local-only ambient monitoring";

    // Live inference-engine badge (NET_RUN_10 #10) — replaces the static "Inference ready" chip.
    private string _inferenceLabel = "Standby";
    private string _inferenceLevel = "idle";

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            _clock = DateTime.Now.ToString("HH:mm:ss");
            // Poll the local inference engine every 5s so the badge reflects real state.
            if (++_tick % 5 == 0) _ = InvokeAsync(RefreshInferenceBadgeAsync);
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

        Nav.LocationChanged += OnLocationChanged;
        UpdatePageTitle(Nav.Uri);
    }

    private async Task RefreshInferenceBadgeAsync()
    {
        try
        {
            var diag = await JS.InvokeAsync<InferenceBadgeDto>("powatchInference.getInferenceDiagnostics");
            (_inferenceLabel, _inferenceLevel) = diag?.LoadState switch
            {
                "ready" => ("Model ready", "ready"),
                "loading" => ("Loading model…", "loading"),
                "error" => ("Inference error", "error"),
                _ => ("Standby", "idle"),
            };
        }
        catch
        {
            // Inference JS not present (e.g. anonymous /login) — keep the neutral Standby state.
            (_inferenceLabel, _inferenceLevel) = ("Standby", "idle");
        }
        await InvokeAsync(StateHasChanged);
    }

    private sealed class InferenceBadgeDto
    {
        public string? LoadState { get; set; }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _navigating = true;
        InvokeAsync(StateHasChanged);
        Task.Delay(350).ContinueWith(_ =>
        {
            _navigating = false;
            UpdatePageTitle(e.Location);
            InvokeAsync(StateHasChanged);
        });
    }

    private void UpdatePageTitle(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        (_pageTitle, _pageSubtitle) = path switch
        {
            "" or "/" => ("Observer Hub", "Live webcam capture, local AI inference & activity log"),
            "/archives" => ("Archives", "Daily chapters, clinical narratives & evidence"),
            "/live-dashboard" => ("Live Dashboard", "Real-time status across all known subjects"),
            "/identity" => ("Subjects", "Name subjects, rename & merge identities"),
            "/diagnostics" => ("Diagnostics", "Runtime resource, storage & inference health"),
            "/login" => ("Sign in", "Authenticate to access PoWatch"),
            _ => ("PoWatch", "Local-only ambient monitoring")
        };
    }

    public void Dispose()
    {
        _timer?.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
    }
}
