@inherits LayoutComponentBase
@implements IDisposable
<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main>
        <div class="top-row hud-top">
            <div class="shell-title">
                <span class="shell-kicker">PoWatch</span>
                <div>
                    <strong>Observer Operations Console</strong>
                    <div class="shell-subtitle">Local-only ambient monitoring</div>
                </div>
            </div>

            <div class="shell-meta">
                <span class="shell-badge">Inference ready</span>
                <span class="clock">@_clock</span>
            </div>
        </div>

        <article class="content app-shell">
            @Body
        </article>
    </main>
</div>

<RadzenNotification />

@code {
    private string _clock = DateTime.Now.ToString("HH:mm");
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            _clock = DateTime.Now.ToString("HH:mm");
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    public void Dispose() => _timer?.Dispose();
}
