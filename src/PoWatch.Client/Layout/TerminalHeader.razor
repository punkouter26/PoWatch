@implements IDisposable
@using System.Globalization
@using System.Security.Claims
@inject SensingSession Sensing
@inject IInferenceService InferenceService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http

<header class="term-header" data-test="term-header">
    <a class="term-brand" href="" aria-label="PoWatch home">
        PoWatch <span class="term-brand-mark">TERM</span>
    </a>

    @* Not an h1: FocusOnNavigate focuses the first h1, which would put keyboard focus past the skip link. *@
    <span class="term-status" data-test="page-hud-title" style="font-weight: 600;">@Title</span>

    <div class="term-meta" aria-label="Session">
        <span>SESSION <b>@(Sensing.Live.Session is { } s ? $"#{s.Id.ToString("N")[..4].ToUpperInvariant()}" : "—")</b></span>
        <span>SRC <b>@(Sensing.IsRunning ? (Sensing.Live.Demo ? "demo-scene" : "camera") : "—")</b></span>
        <span>UP <b>@Uptime</b></span>
    </div>

    <span class="term-status @(Sensing.IsRunning ? (Sensing.Live.Demo ? "term-status--demo" : "term-status--live") : string.Empty)"
          role="status" data-test="session-status">
        ● @(Sensing.IsRunning ? "OBSERVING" : "STANDBY")
    </span>

    @if (Sensing.Live.Demo || InferenceService is IMockable)
    {
        <span class="term-chip" title="Numbers come from a scripted demo scene, not a camera">SAMPLE DATA</span>
    }

    <span class="term-spacer"></span>

    <span class="term-clock" aria-label="Local time">@_now.ToString("ddd dd MMM yyyy · HH:mm:ss", CultureInfo.CurrentCulture).ToUpperInvariant()</span>

    @if (Sensing.IsRunning)
    {
        <button class="term-button term-button--danger" @onclick="StopAsync" data-test="header-stop">Stop</button>
    }
    else
    {
        <a class="term-button term-button--primary" href="?start=camera" style="display: inline-flex; align-items: center; text-decoration: none;"
           data-test="header-start">Start session</a>
    }

    <button class="term-icon-button" @onclick="ToggleThemeAsync" aria-label="Switch to @(_theme == "light" ? "dark" : "light") theme" data-test="theme-toggle">
        @if (_theme == "light")
        {
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        }
        else
        {
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        }
    </button>

    <button class="term-icon-button" @onclick="SignOutAsync" disabled="@_signingOut" aria-label="Sign out @(_email)" title="Sign out @(_email)" data-test="sign-out">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
    </button>
</header>

<TrophyToasts />

@code {
    private DateTimeOffset _now = DateTimeOffset.Now;
    private Timer? _clock;
    private string _theme = "dark";
    private string? _email;
    private bool _signingOut;

    [Parameter] public string Title { get; set; } = "PoWatch";
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string Uptime => Sensing.Live.StartedUtc is { } started && Sensing.IsRunning
        ? (DateTimeOffset.UtcNow - started).ToString(@"hh\:mm\:ss", CultureInfo.InvariantCulture)
        : "--:--:--";

    protected override void OnInitialized()
    {
        Sensing.Changed += OnSensingChanged;
        _clock = new Timer(_ => InvokeAsync(() => { _now = DateTimeOffset.Now; StateHasChanged(); }), null, 1000, 1000);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        _email = user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("preferred_username")?.Value ?? user.Identity?.Name;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var current = await JS.TryInvokeAsync<string>("powatchTheme.get");
        if (!string.IsNullOrEmpty(current) && current != _theme)
        {
            _theme = current;
            StateHasChanged();
        }
    }

    private void OnSensingChanged() => InvokeAsync(StateHasChanged);

    private Task StopAsync() => Sensing.StopAsync();

    private async Task ToggleThemeAsync()
    {
        var next = await JS.TryInvokeAsync<string>("powatchTheme.toggle");
        _theme = string.IsNullOrEmpty(next) ? (_theme == "dark" ? "light" : "dark") : next;
    }

    private async Task SignOutAsync()
    {
        _signingOut = true;
        try
        {
            if (Sensing.IsRunning) await Sensing.StopAsync();
            using var response = await Http.PostAsync("auth/logout", content: null);
        }
        catch (HttpRequestException)
        {
            // The cookie may already be gone; the reload below settles it either way.
        }
        finally
        {
            Navigation.NavigateTo("login", forceLoad: true);
        }
    }

    public void Dispose()
    {
        Sensing.Changed -= OnSensingChanged;
        _clock?.Dispose();
    }
}
