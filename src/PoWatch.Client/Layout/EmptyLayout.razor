@inherits LayoutComponentBase
@inject NavigationManager Nav
@* A chrome-free shell for routes that must not show the header (e.g. /login before auth). *@

<CascadingAuthenticationState>
    @* App.razor focuses "main" after navigation; without one, keyboard users land nowhere on sign-in. *@
    <main tabindex="-1">
    <ErrorBoundary @key="new Uri(Nav.Uri).AbsolutePath">
        <ChildContent>
            @Body
        </ChildContent>
        <ErrorContent>
            <div class="po-error-panel" role="alert">
                <h2>Something went wrong</h2>
                <p>This page hit an unexpected error. Reload the page to try again.</p>
            </div>
        </ErrorContent>
    </ErrorBoundary>
    </main>
</CascadingAuthenticationState>
