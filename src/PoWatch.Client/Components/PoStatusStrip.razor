@* PoStatusStrip — RUNNING/IDLE pill with optional thinking indicator and inline
   toggle. Replaces the .status-strip block that was copy-pasted inside
   ObserverHub/LiveDashboard (audit #7). *@

<div class="po-status-strip" role="status" aria-live="polite">
    <span class="po-status-dot @(Active ? "po-status-dot--on" : "po-status-dot--off")" aria-hidden="true"></span>
    <span class="po-status-label">@(Active ? "RUNNING" : "IDLE")</span>
    @if (Thinking)
    {
        <span class="po-status-thinking">@ThinkingText</span>
    }
    @if (MuteSlot is not null)
    {
        <span class="po-status-mute">@MuteSlot</span>
    }
</div>

@code {
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Thinking { get; set; }
    [Parameter] public string ThinkingText { get; set; } = "analysing…";
    [Parameter] public RenderFragment? MuteSlot { get; set; }
}
