@inherits StatsTabBase<SpaceStatsDto>

@if (Data is null)
{
    @if (Loading)
    {
        <Skeleton Heights="@([260])" />
    }
    else
    {
        <p class="term-empty">No space stats for this range yet.</p>
    }
}
else
{
    <div class="term-grid" data-test="stats-space">
        <TerminalPanel Title="Space">
            <Aside>BUSIEST DOOR: @Data.BusiestEdge.ToUpperInvariant()</Aside>
            <ChildContent>
                <div class="stats-heats">
                    <figure>
                        <HeatGrid Values="@Data.MotionHeat" Label="Motion across the frame" CellTitle="@((i, v) => $"{Cell(i)} · {v:P0} of the hottest")" />
                        <figcaption>MOTION · @(Data.HottestCell >= 0 ? $"HOTTEST {Cell(Data.HottestCell)}" : "NONE YET")</figcaption>
                    </figure>
                    <figure>
                        <HeatGrid Values="@Data.PresenceHeat" Label="Where tracked people and animals were centred" CellTitle="@((i, v) => $"{Cell(i)} · {v:P0}")" />
                        <figcaption>PEOPLE &amp; ANIMALS · @(Data.FavouriteSpotCell >= 0 ? $"FAVOURITE {Cell(Data.FavouriteSpotCell)}" : "NOBODY YET")</figcaption>
                    </figure>
                </div>
            </ChildContent>
        </TerminalPanel>
    </div>
}

@code {
    protected override Task<SpaceStatsDto?> LoadAsync(StatsQuery query) => Api.GetSpaceAsync(query);

    /// <summary>Spreadsheet-style cell name: columns A–P, rows 1–9.</summary>
    private static string Cell(int index) => $"{(char)('A' + (index % 16))}{(index / 16) + 1}";
}
