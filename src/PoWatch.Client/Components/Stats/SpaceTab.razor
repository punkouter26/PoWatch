@inherits StatsTabBase<SpaceStatsDto>

@if (Data is null)
{
    <p class="term-empty">@(Loading ? "Loading…" : "No space stats for this range yet.")</p>
}
else
{
    <div class="term-grid" data-test="stats-space">
        <TerminalPanel Number="A3" Title="Where motion happens">
            <Aside>@(Data.HottestCell >= 0 ? $"HOTTEST {Cell(Data.HottestCell)}" : "NO MOTION YET")</Aside>
            <ChildContent>
                <HeatGrid Values="@Data.MotionHeat" Label="Motion across the frame" CellTitle="@((i, v) => $"{Cell(i)} · {v:P0} of the hottest")" />
            </ChildContent>
        </TerminalPanel>

        <TerminalPanel Number="A4" Title="Where people & animals hang out">
            <Aside>@(Data.FavouriteSpotCell >= 0 ? $"FAVOURITE {Cell(Data.FavouriteSpotCell)}" : "NOBODY YET")</Aside>
            <ChildContent>
                <HeatGrid Values="@Data.PresenceHeat" Label="Where tracked people and animals were centred" CellTitle="@((i, v) => $"{Cell(i)} · {v:P0}")" />
            </ChildContent>
        </TerminalPanel>

        <TerminalPanel Number="A5" Title="Doors · entry and exit edges" Class="term-span-2" Flush="true">
            <Aside>BUSIEST: @Data.BusiestEdge.ToUpperInvariant()</Aside>
            <ChildContent>
                <table class="term-table">
                    <thead><tr><th>Edge</th><th class="r">Entries</th><th class="r">Exits</th></tr></thead>
                    <tbody>
                        @foreach (var edge in new[] { "Left", "Top", "Right", "Bottom", "None" })
                        {
                            <tr><td>@(edge == "None" ? "Mid-frame" : edge)</td><td class="r">@Data.Entries.GetValueOrDefault(edge)</td><td class="r">@Data.Exits.GetValueOrDefault(edge)</td></tr>
                        }
                    </tbody>
                </table>
            </ChildContent>
        </TerminalPanel>
    </div>
}

@code {
    protected override Task<SpaceStatsDto?> LoadAsync(StatsQuery query) => Api.GetSpaceAsync(query);

    /// <summary>Spreadsheet-style cell name: columns A–P, rows 1–9.</summary>
    private static string Cell(int index) => $"{(char)('A' + (index % 16))}{(index / 16) + 1}";
}
