@inherits StatsTabBase<PatternStatsDto>

@if (Data is null)
{
    <p class="term-empty">@(Loading ? "Loading…" : "No pattern stats yet.")</p>
}
else
{
    <div class="term-grid" data-test="stats-patterns">
        <TerminalPanel Number="C1" Title="Today vs your usual" Class="term-span-2" Flush="true">
            <Aside>RHYTHM @(Data.RhythmScore is { } r ? Number(r, "0.00") : "n/a")</Aside>
            <ChildContent>
                @if (Data.Anomalies.Count == 0)
                {
                    <p class="term-empty">Nothing observed today yet.</p>
                }
                else
                {
                    <table class="term-table">
                        <thead><tr><th>Metric</th><th class="r">Today</th><th class="r">Usual</th><th class="r">σ</th><th class="r">Z</th></tr></thead>
                        <tbody>
                            @foreach (var a in Data.Anomalies)
                            {
                                <tr data-test="anomaly-row"><td>@a.Metric</td><td class="r">@Number(a.Today, "0.###")</td><td class="r">@Number(a.Mean, "0.###")</td><td class="r">@Number(a.StdDev, "0.###")</td><td class="r"><ZChip Z="@a.Z" /></td></tr>
                            }
                        </tbody>
                    </table>
                }
                <p class="term-stat-hint">
                    Occupancy trend @Number(Data.OccupancyTrendPerDay * 100, "+0.00;-0.00")pp/day ·
                    next busy hour @(Data.NextBusyHour is { } h ? $"{h:00}:00" : "—")
                </p>
            </ChildContent>
        </TerminalPanel>

        <TerminalPanel Number="C2" Title="Today's curve vs usual" Class="term-span-2">
            <RadzenChart Style="height: 200px;" aria-label="Occupancy by hour, today against the usual day">
                <RadzenLineSeries Data="@_curve" CategoryProperty="@nameof(Hour.Label)" ValueProperty="@nameof(Hour.Usual)" Title="Usual" LineType="LineType.Dashed" />
                <RadzenColumnSeries Data="@_curve" CategoryProperty="@nameof(Hour.Label)" ValueProperty="@nameof(Hour.Today)" Title="Today" />
                <RadzenValueAxis Min="0" Max="1" FormatString="{0:P0}" />
                <RadzenLegend Position="LegendPosition.Top" />
            </RadzenChart>
        </TerminalPanel>

        <TerminalPanel Number="C3" Title="Hour × weekday (28 days)" Class="term-span-2">
            <HeatGrid Values="@Data.HourByWeekday.SelectMany(d => d).ToList()" Columns="24" Rows="7"
                      Label="Occupancy by weekday and hour" CellTitle="@((i, v) => $"{Days[i / 24]} {i % 24:00}:00 · {v:P0}")" />
            <div class="stats-axis"><span>rows: Sun → Sat</span><span>columns: 00:00 → 23:00</span></div>
        </TerminalPanel>
    </div>
}

@code {
    public sealed record Hour(string Label, double Today, double Usual);

    private static readonly string[] Days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    private List<Hour> _curve = [];

    protected override async Task<PatternStatsDto?> LoadAsync(StatsQuery query)
    {
        var data = await Api.GetPatternsAsync(query);
        if (data is null) return null;

        _curve = Enumerable.Range(0, 24)
            .Select(h => new Hour($"{h:00}", data.TodayProfile.ElementAtOrDefault(h), data.UsualProfile.ElementAtOrDefault(h)))
            .ToList();
        return data;
    }
}
