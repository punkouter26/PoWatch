@* Caregiver voice memo recorder. Wraps window.powatchMemoRecorder (memo-recorder.js) in a
   Radzen UI with three states: idle, recording, captured. The captured Blob is exposed as a
   callback parameter so the parent (HandoffDialog) can attach it to the brief on submit.
   Playback is wired through a separate audio element so the caregiver can review before
   attaching. *@

@using Microsoft.JSInterop
@using PoWatch.Shared.Models
@inject PoWatch.Client.Services.PoWatchApiClient ApiClient
@inject IJSRuntime JS
@inject NotificationService NotificationService

<div class="memo-recorder" data-test="memo-recorder">
    @if (recordingState == MemoRecordingState.Recording)
    {
        <div class="memo-recorder-row">
            <span class="memo-recorder-indicator" aria-hidden="true"></span>
            <span class="memo-recorder-elapsed">@FormatElapsed(ElapsedSeconds)</span>
            <RadzenButton Text="Stop" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                Click="StopRecordingAsync" data-test="memo-stop" />
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                Click="CancelRecordingAsync" data-test="memo-cancel" />
        </div>
    }
    else if (recordingState == MemoRecordingState.Captured && capturedBlobUrl is not null)
    {
        <div class="memo-recorder-row">
            <audio src="@capturedBlobUrl" controls preload="metadata" class="memo-recorder-player"
                aria-label="Recorded memo preview"></audio>
            <RadzenButton Text="Re-record" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                Click="DiscardAndRecordAsync" data-test="memo-rerecord" />
            <RadzenButton Text="Attach" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                Click="UploadAsync" Disabled="@uploading" data-test="memo-upload" />
            @if (uploading)
            {
                <RadzenProgressBar ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" Class="memo-recorder-progress" />
            }
        </div>
        @if (LastUploaded is not null)
        {
            <p class="memo-recorder-status" data-test="memo-uploaded">
                Memo attached · @FormatDuration(LastUploaded.DurationMs) ·
                @LastUploaded.CreatedAtUtc.ToLocalTime().ToString("HH:mm")
            </p>
        }
    }
    else
    {
        <div class="memo-recorder-row">
            <RadzenButton Text="Record voice memo" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                Icon="mic" Click="StartRecordingAsync" data-test="memo-start"
                aria-label="Record a voice memo for this handoff" />
            <span class="memo-recorder-hint">30-second max · kept for 30 days · never transcribed</span>
        </div>
    }
</div>

@code {
    private enum MemoRecordingState { Idle, Recording, Captured }

    [Parameter] public string? SubjectId { get; set; }

    /// <summary>Raised after a memo has been uploaded and the API returned the persisted DTO.
    /// The parent can choose to tuck the memo into the brief payload or just display it.</summary>
    [Parameter] public EventCallback<HandoffMemoDto> OnMemoUploaded { get; set; }

    private MemoRecordingState recordingState = MemoRecordingState.Idle;
    private System.Timers.Timer? elapsedTimer;
    private int ElapsedSeconds = 0;
    private string? capturedBlobUrl;
    private byte[]? capturedBytes;
    private string? capturedMimeType;
    private int capturedDurationMs;
    private bool uploading;
    private HandoffMemoDto? LastUploaded;

    private async Task StartRecordingAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("powatchMemoRecorder.start");
            recordingState = MemoRecordingState.Recording;
            ElapsedSeconds = 0;
            StartElapsedTimer();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Recording failed", ex.Message);
        }
    }

    private async Task StopRecordingAsync()
    {
        try
        {
            StopElapsedTimer();
            var result = await JS.InvokeAsync<MemoRecorderResult>("powatchMemoRecorder.stop");
            capturedBytes = await ReadBlobBytesAsync(result.BlobUrl);
            capturedMimeType = result.MimeType;
            capturedDurationMs = result.DurationMs;
            capturedBlobUrl = result.BlobUrl;
            recordingState = MemoRecordingState.Captured;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Stop failed", ex.Message);
            recordingState = MemoRecordingState.Idle;
        }
    }

    private async Task CancelRecordingAsync()
    {
        await JS.InvokeVoidAsync("powatchMemoRecorder.cancel");
        StopElapsedTimer();
        recordingState = MemoRecordingState.Idle;
        DisposeBlob();
    }

    private async Task DiscardAndRecordAsync()
    {
        DisposeBlob();
        await StartRecordingAsync();
    }

    private async Task UploadAsync()
    {
        if (capturedBytes is null) return;
        uploading = true;
        try
        {
            // Use a synthesized FormData upload via the API client. Sending the bytes back through
            // the BFF keeps blob SAS URLs out of the WASM client's hands (AGENT.md §3).
            var dto = await ApiClient.UploadHandoffMemoAsync(capturedBytes, capturedMimeType ?? "audio/webm", capturedDurationMs, SubjectId);
            if (dto is not null)
            {
                LastUploaded = dto;
                await OnMemoUploaded.InvokeAsync(dto);
            }
            DisposeBlob();
            recordingState = MemoRecordingState.Idle;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Upload failed", ex.Message);
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task<byte[]> ReadBlobBytesAsync(string blobUrl)
    {
        // The JS bridge returns an object URL for the captured Blob; round-trip it through a
        // fetch + arrayBuffer to get the bytes back into managed memory. The JS interop returns
        // a base64 string because Blazor's Json deserialization for byte[] is fine but a fetch()
        // response body is not.
        var base64 = await JS.InvokeAsync<string>("powatchMemoRecorder.readAsBase64", blobUrl);
        return Convert.FromBase64String(base64);
    }

    private void DisposeBlob()
    {
        if (capturedBlobUrl is not null)
        {
            try { JS.InvokeVoidAsync("powatchMemoRecorder.revoke", capturedBlobUrl); } catch { /* blob already gone */ }
            capturedBlobUrl = null;
        }
        capturedBytes = null;
        capturedMimeType = null;
        capturedDurationMs = 0;
        LastUploaded = null;
    }

    private void StartElapsedTimer()
    {
        StopElapsedTimer();
        elapsedTimer = new System.Timers.Timer(1000) { AutoReset = true };
        elapsedTimer.Elapsed += (_, _) =>
        {
            ElapsedSeconds++;
            InvokeAsync(StateHasChanged);
        };
        elapsedTimer.Start();
    }

    private void StopElapsedTimer()
    {
        if (elapsedTimer is not null)
        {
            elapsedTimer.Stop();
            elapsedTimer.Dispose();
            elapsedTimer = null;
        }
    }

    private static string FormatElapsed(int seconds) =>
        TimeSpan.FromSeconds(seconds).ToString(@"mm\:ss");

    private static string FormatDuration(int ms) =>
        TimeSpan.FromMilliseconds(ms).ToString(@"mm\:ss");

    /// <summary>Interop shape returned by <c>powatchMemoRecorder.stop</c> (Blob + metadata).
    /// Blazor's JS interop cannot marshal a Blob directly; the JS bridge returns an object URL
    /// instead, and the managed code pulls the bytes back through <c>readAsBase64</c>.</summary>
    private sealed class MemoRecorderResult
    {
        public string BlobUrl { get; set; } = string.Empty;
        public string MimeType { get; set; } = string.Empty;
        public int DurationMs { get; set; }
    }
}
