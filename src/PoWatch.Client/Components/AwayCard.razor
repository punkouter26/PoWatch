@* "While you were away": the headline numbers for a session so far, its best moments with their
   snapshots, and what was seen. Shown when a session stops, or when you come back to the tab. *@
@using System.Globalization
@inject PoWatchApiClient Api

<section class="term-panel away-card" data-test="away-card" aria-labelledby="away-title">
    <header class="term-panel-head">
        <span class="term-panel-no">★</span>
        <h2 id="away-title" style="font: inherit; margin: 0;">@Title</h2>
        <span class="term-panel-meta">SESSION #@Session.Id.ToString("N")[..4].ToUpperInvariant() · @Duration(Session.DurationSeconds)</span>
        <a class="term-button" href="@PoWatchApiClient.SessionRecapPdfUrl(Session.Id)" download="PoWatch-session-@(Session.Id.ToString("N")[..4]).pdf" data-test="away-pdf">PDF ↓</a>
        <button class="term-icon-button" @onclick="OnClose" aria-label="Dismiss" data-test="away-close">✕</button>
    </header>
    <div class="term-panel-body">
        @if (_presence is null)
        {
            <p class="term-empty">Adding it up…</p>
        }
        else
        {
            <div class="term-stats">
                <StatCell Label="Visits" Value="@_presence.Visits.ToString(CultureInfo.InvariantCulture)" Test="away-visits" />
                <StatCell Label="Occupancy" Value="@_presence.Occupancy.ToString("0%", CultureInfo.InvariantCulture)" />
                <StatCell Label="Peak at once" Value="@_presence.PeakConcurrency.ToString(CultureInfo.InvariantCulture)" />
                <StatCell Label="Busiest" Value="@(_presence.BusiestStartUtc?.ToLocalTime().ToString("HH:mm", CultureInfo.CurrentCulture) ?? "—")" />
                <StatCell Label="Seen" Value="@(_objects?.Classes.Count.ToString(CultureInfo.InvariantCulture) ?? "0")" Hint="@string.Join(", ", _objects?.Classes.Take(4).Select(c => c.Name) ?? [])" />
                <StatCell Label="Moments" Value="@_moments.Count.ToString(CultureInfo.InvariantCulture)" />
            </div>

            @if (_moments.Count > 0)
            {
                <ol class="away-moments">
                    @foreach (var moment in _moments.Take(3))
                    {
                        <li>
                            @if (moment.ImageUrl is { } url)
                            {
                                <img src="@url" alt="Snapshot: @moment.Text" loading="lazy" />
                            }
                            else
                            {
                                <div class="away-noimage" aria-hidden="true">no picture</div>
                            }
                            <span class="num">@moment.AtUtc.ToLocalTime().ToString("HH:mm:ss", CultureInfo.CurrentCulture)</span>
                            <span>@moment.Text</span>
                        </li>
                    }
                </ol>
            }
        }
    </div>
</section>

@code {
    private PresenceStatsDto? _presence;
    private ObjectStatsDto? _objects;
    private IReadOnlyList<MomentDto> _moments = [];

    [Parameter, EditorRequired] public SessionDto Session { get; set; } = default!;

    /// <summary>How long the tab was away; null when the card follows a stopped session.</summary>
    [Parameter] public TimeSpan? AwayFor { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private string Title => AwayFor is { } away ? $"While you were away · {Duration(away.TotalSeconds)}" : "Session recap";

    protected override async Task OnParametersSetAsync()
    {
        var query = StatsQuery.For("session", Session.Id);
        var presence = Api.GetPresenceAsync(query);
        var objects = Api.GetObjectsAsync(query);
        var moments = Api.GetMomentsAsync(Session.Id);
        await Task.WhenAll(presence, objects, moments);
        (_presence, _objects, _moments) = (presence.Result, objects.Result, moments.Result);
    }

    private static string Duration(double seconds)
    {
        var span = TimeSpan.FromSeconds(seconds);
        return span.TotalHours >= 1 ? $"{(int)span.TotalHours}h {span.Minutes:00}m" : $"{span.Minutes}m {span.Seconds:00}s";
    }
}
