@*
    A single primitive for "N parallel vertical bars over a fixed range" — used by
    DailyActivityHeatmap (24 stacked hour bars) and PatternComparisonPanel (24 paired
    today/baseline bars). Sharing the primitive means the hover behaviour, screen-reader
    labelling, hour tick layout, and colour ramp live in one place (idea #5).
*@

<div class="data-strip @($"data-strip--{Mode.ToString().ToLowerInvariant()}")"
     role="list"
     data-test="@TestId"
     aria-label="@AriaLabel">
    @for (var h = 0; h < 24; h++)
    {
        var cells = BuildCells?.Invoke(h) ?? [];
        var isCurrent = CurrentHour is { } current && h == current;
        <div class="data-strip-cell @(isCurrent ? "data-strip-cell--current" : null)"
             role="listitem" data-test="data-strip-cell" data-hour="@h"
             title="@(CellTitle?.Invoke(h) ?? $"{h:00}:00")">
            <div class="data-strip-stack" aria-hidden="true">
                @foreach (var cell in cells)
                {
                    if (cell.Intensity <= 0) continue;
                    <span class="data-strip-bar @($"data-strip-bar--{cell.Tone}")"
                          style="--bar-height:@(FormatPercent(cell.Intensity))"></span>
                }
            </div>
            @if (h % HourTickEvery == 0)
            {
                <span class="data-strip-tick @(h == 0 ? "data-strip-tick--start" : null)"
                      aria-hidden="@(h == 0 || h % (HourTickEvery * 3) == 0 ? "false" : "true")">
                    @(h == 0 ? "00" : h.ToString())
                </span>
            }
        </div>
    }
</div>

@code {
    /// <summary>Per-bar descriptor returned by the BuildCells delegate. Tone maps to a CSS modifier;
    /// intensity is normalised 0..1.</summary>
    public sealed record StripCell(string Tone, double Intensity);

    public enum StripMode
    {
        /// <summary>Stacked routine/notable/urgent — used by DailyActivityHeatmap.</summary>
        Stacked,
        /// <summary>Side-by-side today vs baseline — used by PatternComparisonPanel.</summary>
        Paired
    }

    /// <summary>How bars stack inside a single cell. Defaults to stacked.</summary>
    [Parameter] public StripMode Mode { get; set; } = StripMode.Stacked;

    /// <summary>Builds the bars for the given hour. Return an empty array for an empty cell.</summary>
    [Parameter, EditorRequired]
    public Func<int, StripCell[]>? BuildCells { get; set; }

    /// <summary>Optional accessible label for the whole strip.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Optional per-cell tooltip.</summary>
    [Parameter] public Func<int, string>? CellTitle { get; set; }

    /// <summary>Optional current-hour highlight.</summary>
    [Parameter] public int? CurrentHour { get; set; }

    /// <summary>How often to render a tick label. Defaults to every 3 hours.</summary>
    [Parameter] public int HourTickEvery { get; set; } = 3;

    /// <summary>Test attribute forwarded to the root for Playwright selectors.</summary>
    [Parameter] public string? TestId { get; set; }

    private static string FormatPercent(double v) =>
        v <= 0 ? "0%" : v >= 1 ? "100%" : $"{v * 100:0}%";
}