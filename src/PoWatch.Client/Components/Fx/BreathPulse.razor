@inject PoWatch.Client.Services.PowatchFxService Fx
@inject Microsoft.Extensions.Options.IOptions<PoWatch.Client.ClientFeatureFlagsOptions> Flags

@code {
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public int Bpm { get; set; } = 12;
    private bool _last;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var flags = Flags.Value;
        var effectivelyOn = Enabled && flags.FxEnabled && flags.FxBreathPulse;
        if (!firstRender && effectivelyOn == _last) return;
        _last = effectivelyOn;
        if (effectivelyOn) await Fx.SetBreathRateAsync(Bpm);
        await Fx.EnableBreathAsync(effectivelyOn);
    }

}
