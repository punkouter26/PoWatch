@inject PoWatch.Client.Services.PowatchFxService Fx
@inject Microsoft.Extensions.Options.IOptions<PoWatch.Client.ClientFeatureFlagsOptions> Flags

<div class="@Class" id="@_id" style="position:relative;@Style" @ref="_root">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    private ElementReference _root;
    private string? _id;
    private bool _started;

    protected override void OnInitialized() => _id = "powatch-pebbles-" + Guid.NewGuid().ToString("N");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_started || !firstRender) return;
        var flags = Flags.Value;
        if (!flags.FxEnabled || !flags.FxPebbles) { _started = true; return; }
        await Fx.InitPebblesAsync(_id!);
        _started = true;
    }

    public Task SetPebbleAsync(int index, double x, double y, double r, double hue) =>
        Fx.SetPebbleAsync(index, x, y, r, hue);
}
