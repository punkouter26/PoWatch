@* The one place the app tells you things: sensing problems, watch-rule alerts, "name this
   newcomer" prompts and, once a week, the week in review, behind a bell with a count. They open in a
   side drawer, by themselves only for a problem or an alert; the rest just raise the count. Watch rules
   are edited in Settings. *@
@using System.Globalization
@implements IDisposable
@inject SensingSession Sensing
@inject StatsFeed Feed
@inject TimeProvider Time
@inject PoWatchApiClient Api
@inject IJSRuntime JS
@inject DrawerState Drawers

<div class="term-tray" data-test="tray" data-hub="@(Feed.IsConnected ? "up" : "down")">
    <button class="term-icon-button @(Open ? "term-icon-button--on" : null)" @onclick="Toggle" aria-expanded="@(Open ? "true" : "false")"
            aria-label="@($"Notifications, {Count} waiting")" title="Notifications" data-test="tray-toggle">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0" /></svg>
        @if (Count > 0)
        {
            <span class="term-tray-count" aria-hidden="true">@Count</span>
        }
    </button>

    @* Announced politely even while the panel is closed. *@
    <span class="visually-hidden" role="status">@_announce</span>

    <Drawer Title="Notifications" Open="@Open" OnClose="Drawers.Close" TakeFocus="@_takeFocus" Test="tray-panel">
        <Aside>@Count WAITING</Aside>
        <ChildContent>
            @if (Sensing.IsRunning && Sensing.Live.LastError is { } error)
            {
                <p class="tray-item tray-item--bad" role="alert" data-test="tray-error">@error</p>
            }

            @foreach (var alert in _alerts)
            {
                <p class="tray-item tray-item--alert" data-test="tray-alert">
                    <span class="tray-kicker">● WATCH RULE · @alert.AtUtc.ToLocalTime().ToString("HH:mm", System.Globalization.CultureInfo.CurrentCulture)</span>
                    <b>@alert.Text</b>
                </p>
            }

            @foreach (var prompt in Sensing.Live.Prompts.TakeLast(3))
            {
                <section class="tray-item name-prompt" data-test="name-prompt" @key="prompt.Regular.Id">
                    @if (prompt.SnapshotDataUrl is { } image)
                    {
                        <img src="@image" alt="The new @prompt.Regular.Class" />
                    }
                    <form @onsubmit="() => Sensing.NameAsync(prompt.Regular.Id, _names.GetValueOrDefault(prompt.Regular.Id))">
                        <label for="name-@prompt.Regular.Id">New @prompt.Regular.Class spotted — name them?</label>
                        <input id="name-@prompt.Regular.Id" data-test="name-input" autocomplete="off" maxlength="40"
                               placeholder="@prompt.Regular.DisplayName" @bind="_names[prompt.Regular.Id]" />
                        <div class="name-prompt-actions">
                            <button type="submit" class="term-button term-button--primary" data-test="name-save">Save</button>
                            <button type="button" class="term-button" @onclick="() => Sensing.NameAsync(prompt.Regular.Id, null)" data-test="name-skip">Not now</button>
                            <span class="term-stat-hint">stays “@prompt.Regular.DisplayName” if you skip</span>
                        </div>
                    </form>
                </section>
            }

            @if (_week is { } week)
            {
                <a class="tray-item tray-item--week" href="@($"history/{_weekEnd:yyyy-MM-dd}")" @onclick="DismissWeekAsync" data-test="tray-week">
                    <span class="tray-kicker">● THE WEEK IN REVIEW · OPEN HISTORY →</span>
                    <b>@week.Summary</b>
                </a>
            }

            @if (Count == 0)
            {
                <p class="term-empty">Nothing new.</p>
            }
            else if (_alerts.Count > 0 || _week is not null)
            {
                <button class="term-menu-item" @onclick="Clear" data-test="tray-clear"><span>Clear</span><b>@(_alerts.Count + (_week is null ? 0 : 1))</b></button>
            }

            <button type="button" class="term-menu-item" @onclick="() => Drawers.Show(DrawerState.Settings)" data-test="tray-rules-link"><span>Watch rules</span><b>SETTINGS →</b></button>
        </ChildContent>
    </Drawer>
</div>

@code {
    private const int Kept = 5;
    private readonly List<AlertDto> _alerts = [];
    private readonly Dictionary<string, string?> _names = new(StringComparer.Ordinal);
    private Timer? _expiry;
    private bool _takeFocus = true;
    private int _prompts;
    private string? _lastError;
    private string? _announce;

    private const string WeekSeenKey = "powatch:week-seen";
    private WeekDigestDto? _week;
    private DateOnly _weekEnd;

    private bool Open => Drawers.IsOpen(DrawerState.Tray);

    private int Count => _alerts.Count + Sensing.Live.Prompts.Count + (_week is null ? 0 : 1) + (Sensing.IsRunning && Sensing.Live.LastError is not null ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        Sensing.Changed += OnSensingChanged;
        Feed.Alerted += OnAlerted;
        Drawers.Changed += OnDrawersChanged;
        // Ignored naming prompts fade after a minute even when no detections arrive to expire them.
        _expiry = new Timer(_ => InvokeAsync(() =>
        {
            if (Sensing.Live.ExpirePrompts(Time.GetUtcNow())) StateHasChanged();
        }), null, 5000, 5000);

        await Feed.EnsureConnectedAsync();
        StateHasChanged();
        await OfferLastWeekAsync();
    }

    /// <summary>Once per browser per week: last week's review, if anything was observed in it.</summary>
    private async Task OfferLastWeekAsync()
    {
        var today = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
        var lastWeek = today.AddDays(-(((int)today.DayOfWeek + 6) % 7) - 7);
        if (await JS.TryInvokeAsync<string>("localStorage.getItem", WeekSeenKey) == Key(lastWeek)) return;
        if (await Api.GetWeekDigestAsync(lastWeek) is not { ThisWeek.SecondsObserved: > 0 } digest) return;
        (_week, _weekEnd) = (digest, lastWeek.AddDays(6));
        StateHasChanged();
    }

    private async Task DismissWeekAsync()
    {
        if (_week is null) return;
        await JS.TryInvokeVoidAsync("localStorage.setItem", WeekSeenKey, Key(_weekEnd.AddDays(-6)));
        _week = null;
        Drawers.Close();
    }

    private static string Key(DateOnly weekStart) => weekStart.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private void Toggle()
    {
        _takeFocus = true;
        Drawers.Toggle(DrawerState.Tray);
    }

    /// <summary>A problem or an alert opens the drawer by itself, without taking focus from what you were doing.</summary>
    private void OpenByItself()
    {
        _takeFocus = false;
        Drawers.Show(DrawerState.Tray);
    }

    private void OnDrawersChanged() => InvokeAsync(StateHasChanged);

    private async Task Clear()
    {
        _alerts.Clear();
        await DismissWeekAsync();
        Drawers.Close();
    }

    private void OnAlerted(AlertDto alert) => InvokeAsync(() =>
    {
        _alerts.Add(alert);
        if (_alerts.Count > Kept) _alerts.RemoveAt(0);
        _announce = $"Watch rule: {alert.Text}";
        OpenByItself();
        StateHasChanged();
    });

    // Sensing fires several times a second; only a new prompt or a new problem is worth a render.
    private void OnSensingChanged()
    {
        var prompts = Sensing.Live.Prompts.Count;
        var error = Sensing.IsRunning ? Sensing.Live.LastError : null;
        if (prompts == _prompts && error == _lastError) return;

        var newError = error is not null && error != _lastError;
        var announce = newError ? error : prompts > _prompts ? "Someone new can be named" : null;
        (_prompts, _lastError) = (prompts, error);
        InvokeAsync(() =>
        {
            foreach (var prompt in Sensing.Live.Prompts) _names.TryAdd(prompt.Regular.Id, null);
            if (announce is not null) _announce = announce;
            // A problem opens the tray; a newcomer only raises the count.
            if (newError) OpenByItself();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Sensing.Changed -= OnSensingChanged;
        Feed.Alerted -= OnAlerted;
        Drawers.Changed -= OnDrawersChanged;
        _expiry?.Dispose();
    }
}
