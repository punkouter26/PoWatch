@using PoWatch.Shared.Models

@* Pattern comparison panel — side-by-side 24-hour bars for "today" vs the rolling baseline.
   The bars share one y-scale (max of both) so a quiet day next to a noisy baseline is
   visually obvious without needing a number. The plain-language summary underneath is
   what the caregiver reads; the chart is for the curious. *@

@if (Comparison is null)
{
    <div class="pattern-empty">No baseline yet — check back after a few days of activity.</div>
}
else
{
    <div class="pattern-panel" data-test="pattern-comparison" aria-label="Pattern comparison for @Comparison.DisplayName">
        <div class="pattern-header">
            <div>
                <span class="pattern-name">@Comparison.DisplayName</span>
                <span class="pattern-summary">@Comparison.Summary</span>
            </div>
            <span class="pattern-drift pattern-drift--@DriftClass(Comparison.DriftLabel, Comparison.DriftScore)">
                @Comparison.DriftLabel · @Comparison.DriftScore.ToString("0")
            </span>
        </div>

<PoWatch.Client.Components.DataStrip Mode="PoWatch.Client.Components.DataStrip.StripMode.Paired"
        BuildCells="BuildPatternCell"
        CellTitle="@(h => HourTitle(h, Comparison.Baseline[h], Comparison.Today[h]))"
        CurrentHour="CurrentHour"
        HourTickEvery="6"
        AriaLabel="@($"Pattern comparison for {Comparison.DisplayName}")"
        TestId="pattern-comparison-strip" />

        <div class="pattern-legend" aria-hidden="true">
            <span class="pattern-legend-item"><span class="pattern-legend-swatch pattern-legend-swatch--today"></span>Today</span>
            <span class="pattern-legend-item"><span class="pattern-legend-swatch pattern-legend-swatch--baseline"></span>7-day baseline</span>
            <span class="pattern-legend-item pattern-direction--@Comparison.Direction">Direction: @Comparison.Direction</span>
        </div>
    </div>
}

@code {
    /// <summary>The comparison payload produced by <see cref="PatternComparator"/>.</summary>
    [Parameter]
    public PatternComparisonDto? Comparison { get; set; }

    /// <summary>Current local hour — used to highlight the "now" column.</summary>
    [Parameter]
    public int CurrentHour { get; set; } = DateTime.Now.Hour;

    private static string DriftClass(string label, double score)
    {
        if (score >= 60) return "high";
        if (score >= 30) return "medium";
        return "low";
    }

    private static string HourTitle(int hour, double baseline, double today)
    {
        var b = (int)Math.Round(baseline * 100);
        var t = (int)Math.Round(today * 100);
        return $"{hour:00}:00 — today {t}%, baseline {b}%";
    }

    /// <summary>Per-cell builder for the DataStrip: today and baseline sit side-by-side
    /// inside each hour column.</summary>
    private PoWatch.Client.Components.DataStrip.StripCell[] BuildPatternCell(int hour)
    {
        var comp = Comparison ?? throw new InvalidOperationException("Comparison must be set before rendering the strip");
        var baseline = comp.Baseline[hour];
        var today = comp.Today[hour];
        return new[]
        {
            new PoWatch.Client.Components.DataStrip.StripCell("today", today),
            new PoWatch.Client.Components.DataStrip.StripCell("baseline", baseline),
        };
    }
}
