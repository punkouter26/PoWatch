@* The year as a 3D skyline (skyline.js): the same 53 × 7 cells as the 2D calendar, as towers. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="skyline">
    <canvas @ref="_canvas" class="skyline-canvas" tabindex="0" role="img" data-test="year-skyline"
            aria-label="The year as a 3D skyline: one tower per day, taller when busier, blue when it rained. Drag or use the arrow keys to turn it; click a day to open it."></canvas>
    <div @ref="_tip" class="skyline-tip" hidden></div>
    @if (_failed)
    {
        <p class="term-empty">The 3D view needs WebGL2, which this browser does not offer. The 2D calendar shows the same days.</p>
    }
    <div class="skyline-bar">
        <button class="term-button" @onclick="FlyAsync" disabled="@_failed" data-test="skyline-fly">@(_flying ? "■ Stop" : "▶ Fly over")</button>
        <span class="term-stat-hint">HEIGHT = OCCUPANCY · BLUE = RAINY · DRAG OR ←→↑↓ TO TURN · SCROLL OR + − TO ZOOM · CLICK A DAY · THE FLY-OVER PLAYS EACH WEEK AS A NOTE</span>
    </div>
</div>

@code {
    private const int Weeks = 53;

    private ElementReference _canvas;
    private ElementReference _tip;
    private DotNetObjectReference<YearSkyline>? _self;
    private IReadOnlyList<double>? _shownValues;
    private int _shownSelected = int.MinValue;
    private bool _flying;
    private bool _failed;

    /// <summary>One value per calendar cell (weekday × 53 + week): occupancy, 0 for no data, −1 for a day still to come.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<double> Values { get; set; } = [];

    [Parameter, EditorRequired] public IReadOnlyList<bool> Wet { get; set; } = [];

    /// <summary>What hovering a tower says: the day, its occupancy, its weather.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Labels { get; set; } = [];

    [Parameter] public int Selected { get; set; } = -1;

    [Parameter] public EventCallback<int> OnPick { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // New data (a new list) rebuilds the towers; a new day only moves the highlight.
        if (!ReferenceEquals(Values, _shownValues))
        {
            (_shownValues, _shownSelected) = (Values, Selected);
            _self ??= DotNetObjectReference.Create(this);
            if (!await JS.TryInvokeAsync<bool>("powatchSkyline.mount", _canvas, Values, Wet, Labels, Selected, _self, _tip) && !_failed)
            {
                _failed = true;
                StateHasChanged();
            }
        }
        else if (Selected != _shownSelected)
        {
            _shownSelected = Selected;
            await JS.TryInvokeVoidAsync("powatchSkyline.select", _canvas, Selected);
        }
    }

    [JSInvokable]
    public Task Pick(int index) => OnPick.InvokeAsync(index);

    /// <summary>Plays the fly-over; pressed again while it plays, it stops (skyline.js resolves the first call then).</summary>
    private async Task FlyAsync()
    {
        if (_flying)
        {
            await JS.TryInvokeVoidAsync("powatchSkyline.flyover", _canvas, WeekMeans());
            return;
        }
        _flying = true;
        await JS.TryInvokeVoidAsync("powatchSkyline.flyover", _canvas, WeekMeans());
        _flying = false;
    }

    /// <summary>Mean occupancy of each week's observed days, 0 for a week with none.</summary>
    private double[] WeekMeans() => Enumerable.Range(0, Weeks)
        .Select(week => Enumerable.Range(0, 7).Select(day => day * Weeks + week).Where(i => i < Values.Count && Values[i] > 0).Select(i => Values[i]).DefaultIfEmpty(0).Average())
        .ToArray();

    public async ValueTask DisposeAsync()
    {
        await JS.TryInvokeVoidAsync("powatchSkyline.unmount", _canvas);
        _self?.Dispose();
    }
}
