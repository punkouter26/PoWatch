@* PoMetric — KPI card. Replaces duplicated .metric-card markup across
   ObserverHub/LiveDashboard/IdentityNexus (audit #7). *@

<div class="po-metric po-metric--@Variant" role="group" aria-label="@Label">
    <span class="po-metric-label">@Label</span>
    <strong class="po-metric-value">@Value</strong>
    @if (!string.IsNullOrEmpty(SubLabel))
    {
        <small class="po-metric-sub">@SubLabel</small>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public string? SubLabel { get; set; }
    [Parameter] public string Variant { get; set; } = "default"; // default | status | model | activity
}
