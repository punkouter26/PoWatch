@* How far today sits from your usual, in standard deviations. Flagged at |z| ≥ 2: the panel glitches
   (terminal.css) and, with sound on, a blip plays when the flag first appears. *@
@inject IJSRuntime JS
<span class="@CssClass" title="@Tooltip">@Text</span>

@code {
    private bool _flagged;

    [Parameter] public double? Z { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var flagged = Z is { } z && Math.Abs(z) >= 2;
        if (flagged && !_flagged) await JS.TryInvokeVoidAsync("powatchFx.blip");
        _flagged = flagged;
    }

    // Round first: a value like -0.04 would otherwise format as "-+0.0" (the sign survives rounding).
    private string Text => Z is { } z
        ? Math.Round(z, 1) switch
        {
            0 => "±0.0σ",
            var r => r.ToString("+0.0;-0.0", System.Globalization.CultureInfo.InvariantCulture) + "σ"
        }
        : "n/a";

    private string Tooltip => Z is { } z
        ? $"{(Math.Abs(z) >= 2 ? "Unusual: " : string.Empty)}{Text} from your usual"
        : "Not enough history yet";

    private string CssClass => Z switch
    {
        null => "term-z",
        { } z => $"term-z {(z >= 0.5 ? "term-z--up" : z <= -0.5 ? "term-z--down" : string.Empty)} {(Math.Abs(z) >= 2 ? "term-z--flag" : string.Empty)}"
    };
}
