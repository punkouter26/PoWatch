@* A grid heatmap (16×9 frame grid, 7×24 weekday-by-hour, …). Shade runs from the smallest non-zero
   value to the largest, so a busy but even frame still shows where it is busiest; zero stays blank.
   With OnCellClick the cells are clickable (History picks a day this way); Selected outlines one. *@
<div class="term-heat @(OnCellClick.HasDelegate ? "term-heat--pick" : null)" role="img" aria-label="@Label"
     style="grid-template-columns: repeat(@Columns, minmax(0, 1fr));">
    @for (var i = 0; i < Columns * Rows; i++)
    {
        var index = i;
        var value = i < Values.Count ? Values[i] : 0;
        var css = i == Selected ? "term-heat-cell term-heat-cell--selected" : "term-heat-cell";
        @* Handlers only when asked for: the live grids re-render four times a second. *@
        @if (OnCellClick.HasDelegate)
        {
            <div class="@css" title="@Title(i, value)" @onclick="() => OnCellClick.InvokeAsync(index)">@Fill(value)</div>
        }
        else
        {
            <div class="@css" title="@Title(i, value)">@Fill(value)</div>
        }
    }
</div>

@code {
    private double _min;
    private double _range = 1;

    [Parameter, EditorRequired] public IReadOnlyList<double> Values { get; set; } = [];
    [Parameter] public int Columns { get; set; } = 16;
    [Parameter] public int Rows { get; set; } = 9;
    [Parameter] public string Label { get; set; } = "Heatmap";

    /// <summary>Tooltip per cell index and value; defaults to the value alone.</summary>
    [Parameter] public Func<int, double, string>? CellTitle { get; set; }

    /// <summary>Raised with the cell index when a cell is clicked; the grid is inert without it.</summary>
    [Parameter] public EventCallback<int> OnCellClick { get; set; }

    /// <summary>Index of the cell to outline, or -1 for none.</summary>
    [Parameter] public int Selected { get; set; } = -1;

    protected override void OnParametersSet()
    {
        var lit = Values.Where(v => v > 0).ToList();
        _min = lit.Count == 0 ? 0 : lit.Min();
        _range = lit.Count == 0 ? 1 : lit.Max() - _min;
    }

    // One lit value (or all equal) has no spread: show it at full strength.
    private string Opacity(double value) =>
        (0.15 + (0.85 * (_range <= 1e-9 ? 1 : Math.Clamp((value - _min) / _range, 0, 1))))
            .ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private RenderFragment Fill(double value) => __builder =>
    {
        if (value > 0)
        {
            <span style="opacity: @Opacity(value)"></span>
        }
    };

    private string Title(int index, double value) =>
        CellTitle?.Invoke(index, value) ?? value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
