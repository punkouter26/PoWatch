@* A radial dial for a share (0–1). The fill and the number count up together in CSS (@property --p). *@
<div class="term-dial" style="--p: @Percent" role="img" aria-label="@Label @Percent%" data-test="@Test">
    <span class="term-dial-value" aria-hidden="true"></span>
    <span class="term-dial-label" aria-hidden="true">@Label</span>
</div>

@code {
    [Parameter, EditorRequired] public double Value { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Test { get; set; }

    private int Percent => (int)Math.Round(Math.Clamp(Value, 0, 1) * 100);
}
