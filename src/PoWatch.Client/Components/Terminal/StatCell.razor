@* One headline number: label, mono value with unit, optional hint line. *@
<div class="term-stat" data-test="@Test">
    <div class="term-stat-label">@Label</div>
    <div class="term-stat-value">@Value<span class="term-stat-unit">@Unit</span></div>
    @if (!string.IsNullOrEmpty(Hint) || ChildContent is not null)
    {
        <div class="term-stat-hint">@Hint @ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = "—";
    [Parameter] public string? Unit { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Test { get; set; }
}
