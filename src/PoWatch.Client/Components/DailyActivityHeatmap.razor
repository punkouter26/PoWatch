@using PoWatch.Shared.Models

@* 24-hour density strip rendered across the top of the Live Room.
   Each hour is a vertical bar composed of three stacked intensities:
   routine (cool), notable (warm), urgent (hot). The strip is the single
   quickest answer to "when was today busy?" — readable in a glance. *@

<div class="heatmap @(Compact ? "heatmap--compact" : null)" data-test="daily-activity-heatmap" aria-label="Activity density across today">
    <div class="heatmap-header">
        <span class="heatmap-title">@Title</span>
        <span class="heatmap-meta">@Meta</span>
    </div>

    @if (Compact)
    {
        // Compact mode is for narrow viewports: a single "Today's activity" line that surfaces
        // totals + the busiest bucket, so a phone user sees the answer in one row instead of a
        // 140-px tall strip they have to scroll past to reach the camera.
        var totalEvents = Buckets.Routine.Sum() + Buckets.Notable.Sum() + Buckets.Urgent.Sum();
        var peakHour = PeakHour();
        <div class="heatmap-compact-summary" role="list">
            <span class="heatmap-compact-total"><strong>@totalEvents</strong> events</span>
            @if (peakHour is { } peak)
            {
                <span class="heatmap-compact-peak">peak @($"{peak.hour:00}:00")</span>
            }
            <span class="heatmap-compact-bars" aria-hidden="true">
                @for (var h = 0; h < 24; h++)
                {
                    var total = Buckets.Routine[h] + Buckets.Notable[h] + Buckets.Urgent[h];
                    var intensity = Normalise(total, DisplayCap);
                    <span class="heatmap-compact-cell @(intensity > 0 ? "heatmap-compact-cell--active" : null)" style="--bar-height:@(FormatPercent(intensity))"></span>
                }
            </span>
        </div>
    }
    else
    {
    <PoWatch.Client.Components.DataStrip Mode="PoWatch.Client.Components.DataStrip.StripMode.Stacked"
        BuildCells="BuildHeatmapCell"
        CellTitle="@(h => HourTitle(h, Buckets.Routine[h], Buckets.Notable[h], Buckets.Urgent[h]))"
        CurrentHour="NowLocal.Hour"
        AriaLabel="Activity density across today"
        TestId="daily-activity-strip" />

    <div class="heatmap-legend" aria-hidden="true">
        <span class="heatmap-legend-item"><span class="heatmap-legend-swatch heatmap-legend-swatch--routine"></span>Routine</span>
        <span class="heatmap-legend-item"><span class="heatmap-legend-swatch heatmap-legend-swatch--notable"></span>Notable</span>
        <span class="heatmap-legend-item"><span class="heatmap-legend-swatch heatmap-legend-swatch--urgent"></span>Urgent</span>
    </div>
    }
</div>

@code {
    /// <summary>Per-hour tier counts. The renderer never recomputes this — it only displays it.</summary>
    [Parameter, EditorRequired]
    public DailyActivityBucketsDto Buckets { get; set; } = new();

    /// <summary>Header label; defaults to the bucket date formatted short.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Optional caption shown next to the title (e.g. "12 events · peak at 14:00").</summary>
    [Parameter]
    public string? Meta { get; set; }

    /// <summary>Current local time. Rendered as a vertical "now" marker and used to dim future hours.</summary>
    [Parameter]
    public DateTime NowLocal { get; set; } = DateTime.Now;

    /// <summary>Cap applied to a single bucket so one very busy hour doesn't wash out the rest of the strip.</summary>
    [Parameter]
    public int DisplayCap { get; set; } = 6;

    /// <summary>Compact rendering: a single summary row instead of the full 24-hour strip.
    /// Used on narrow viewports so the Live Room hero stays compact.</summary>
    [Parameter]
    public bool Compact { get; set; }

    private (int hour, int count)? PeakHour()
    {
        (int hour, int count) peak = (-1, 0);
        for (var h = 0; h < 24; h++)
        {
            var t = Buckets.Routine[h] + Buckets.Notable[h] + Buckets.Urgent[h];
            if (t > peak.count) peak = (h, t);
        }
        return peak.count > 0 ? peak : null;
    }

    /// <summary>Per-cell builder passed into DataStrip. Stacks routine → notable → urgent in
    /// a single column; cells with no activity return empty so DataStrip renders the
    /// "future hour" empty state.</summary>
    private PoWatch.Client.Components.DataStrip.StripCell[] BuildHeatmapCell(int hour)
    {
        var routine = Normalise(Buckets.Routine[hour], DisplayCap);
        var notable = Normalise(Buckets.Notable[hour], DisplayCap);
        var urgent = Normalise(Buckets.Urgent[hour], DisplayCap);

        // Stacked order matters: routine on bottom, urgent on top so the most-urgent tier is
        // visible from the bar tip even when other tiers are tall.
        return new[]
        {
            new PoWatch.Client.Components.DataStrip.StripCell("routine", routine),
            new PoWatch.Client.Components.DataStrip.StripCell("notable", notable),
            new PoWatch.Client.Components.DataStrip.StripCell("urgent", urgent),
        };
    }

    protected override void OnParametersSet()
    {
        Title ??= Buckets.Date.ToString("ddd d MMM");
    }

    private static double Normalise(int count, int cap) =>
        cap <= 0 ? 0d : Math.Min(1d, (double)count / cap);

    private static string FormatPercent(double v) =>
        v <= 0 ? "0%" : $"{v * 100:0}%";

    private static string HeatmapCellClass(bool isPast, bool isCurrent, bool isFuture) =>
        isCurrent ? "heatmap-cell--current" :
        isFuture ? "heatmap-cell--future" :
        "heatmap-cell--past";

    private static string HourTitle(int hour, int routine, int notable, int urgent)
    {
        var total = routine + notable + urgent;
        if (total == 0) return $"{hour:00}:00 — no activity";
        var breakdown = urgent > 0 ? $"{urgent} urgent, {notable} notable, {routine} routine"
            : notable > 0 ? $"{notable} notable, {routine} routine"
            : $"{routine} routine";
        return $"{hour:00}:00 — {breakdown}";
    }
}
