{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "PoWatch": "Debug"
    }
  },
  "PoWatch": {
    "Ports": {
      "Http": 80
    }
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "DevCorsAllowedOrigins": [
      "http://localhost",
      "http://127.0.0.1",
      "http://localhost:80",
      "http://127.0.0.1:80"
    ]
  },
  "FeatureFlags": {
    "ExposeDebugDetailsInUi": true,
    "DeveloperBypassAuth": true,
    "EnableKeyVault": true
  },
  "KeyVault": {
    "Uri": "https://kv-poshared.vault.azure.net/"
  },
  "AiProvider": {
    "Provider": "AzureOpenAi"
  }
}
