{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "PoWatch": "Debug"
    }
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "SkipStorageInit": false
  },
  "FeatureFlags": {
    "ExposeDebugDetailsInUi": true,
    "DeveloperBypassAuth": true,
    "EnableKeyVault": true,
    "EnableTelemetrySanitizer": true,
    "UseMockAi": false,
    "AllowDataReset": true,
    "DeveloperEnableMicrosoftLogin": true
  },
  "KeyVault": {
    "Uri": "https://kv-poshared.vault.azure.net/"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}

