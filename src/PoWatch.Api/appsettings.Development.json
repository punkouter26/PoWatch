{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "PoWatch": "Debug"
    }
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "SkipStorageInit": false
  },
  "FeatureFlags": {
    "ExposeDebugDetailsInUi": true,
    "DeveloperBypassAuth": true,
    "EnableKeyVault": true,
    "EnableTelemetrySanitizer": true,
    "UseMockAi": false,
    "AllowDataReset": true,
    "DeveloperEnableMicrosoftLogin": true
  },
  "KeyVault": {
    "Uri": "https://kv-poshared.vault.azure.net/"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "AiProvider": {
    "Provider": "Template",
    "OllamaEndpoint": "http://localhost:11434",
    "OllamaModel": "llama3.2-vision",
    "Temperature": 0.3,
    "MaxTokens": 600
  }
}
