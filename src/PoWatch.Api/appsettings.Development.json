{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "PoWatch": "Debug"
    }
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "SkipStorageInit": false,
    "DevCorsAllowedOrigins": [
      "http://localhost:7000",
      "https://localhost:7001",
      "http://127.0.0.1:7000",
      "https://127.0.0.1:7001"
    ]
  },
  "FeatureFlags": {
    "ExposeDebugDetailsInUi": true,
    "DeveloperBypassAuth": true,
    "EnableKeyVault": true,
    "EnableTelemetrySanitizer": true,
    "EnableHud": true,
    "UseMockAi": false,
    "AllowDataReset": true
  },
  "KeyVault": {
    "Uri": "https://kv-poshared.vault.azure.net/"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}

