{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PoWatch": "Debug"
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "AzureStorage": {
    "ConnectionString": "",
    "ObservationsTable": "PoWatchObservations",
    "SubjectsTable": "PoWatchSubjects",
    "SignificantImagesContainer": "significant-images"
  },
  "ObserverOptions": {
    "PollingIntervalSeconds": 10
  },
  "FeatureFlags": {
    "ObservationLoopEnabled": true,
    "SaveSignificantImages": true,
    "TtsAnnouncementsEnabled": false,
    "ExposeDebugDetailsInUi": false,
    "DeveloperBypassAuth": false,
    "FhirExportEnabled": true,
    "BaselineEnabled": true,
    "AlertThresholdsEnabled": true,
    "DriftRadarEnabled": true,
    "HandoffCoachEnabled": true,
    "AzureOpenAiEnabled": false
  },
  "DriftRadar": {
    "MinEventsForDrift": 3,
    "HighDriftThreshold": 60.0,
    "ModerateDriftThreshold": 30.0,
    "SlightDriftThreshold": 10.0,
    "BaselineDays": 7,
    "MaxInsights": 4
  },
  "HandoffCoach": {
    "MaxPromptSignificantEvents": 20,
    "MaxPromptOutlierEvents": 10,
    "AllowFamilySafeSummary": false
  },
  "AzureOpenAi": {
    "Endpoint": "",
    "ApiKey": "",
    "DeploymentName": "gpt-4o",
    "ApiVersion": "2024-02-01",
    "MaxCompletionTokens": 600,
    "Temperature": 0.3
  },
  "AlertThresholds": {
    "Enabled": true,
    "SubjectRetentionMinutes": 1440,
    "Rules": [
      {
        "Name": "Frequent Outliers",
        "Metric": "Outlier",
        "WindowMinutes": 10,
        "Threshold": 3,
        "Enabled": true,
        "Description": "3 or more clinical outliers detected in 10 minutes."
      },
      {
        "Name": "High Activity Burst",
        "Metric": "Any",
        "WindowMinutes": 5,
        "Threshold": 10,
        "Enabled": true,
        "Description": "10 or more observation events in 5 minutes."
      }
    ]
  },
  "AllowedHosts": "*"
}
