{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "PoWatch": "Information"
    }
  },
  "FeatureFlags": {
    "DeveloperBypassAuth": true,
    "ExposeDebugDetailsInUi": true,
    "EnableKeyVault": false,
    "EnableTelemetrySanitizer": true,
    "AllowDataReset": true
  },
  "KeyVault": {
    "Uri": ""
  },
  "AzureStorage": {
    "SkipStorageInit": false
  }
}
