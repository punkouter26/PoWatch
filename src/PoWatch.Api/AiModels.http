@baseUrl = http://localhost

### Sign in as the Development guest first
GET {{baseUrl}}/auth/login/fake?returnUrl=/

### List safe model labels and the current browser's selection
GET {{baseUrl}}/api/ai/models

### Select the configured local Ollama model for subsequent requests
PUT {{baseUrl}}/api/ai/models
Content-Type: application/json

{"modelId":"Ollama"}

### Use deterministic recaps (existing browser recap fallback remains available)
PUT {{baseUrl}}/api/ai/models
Content-Type: application/json

{"modelId":"Template"}

### Unknown models are refused with a 400 Problem Details response
PUT {{baseUrl}}/api/ai/models
Content-Type: application/json

{"modelId":"not-configured"}
