# Normalize line endings to LF in the repo; matches .editorconfig (end_of_line = lf)
# so `dotnet format --verify-no-changes` behaves identically on Windows and CI.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets — never normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.onnx binary
*.wasm binary
